---
import LegalView from '../views/LegalView.astro';
import { legalPages } from '../data/legalPages.js';

export function getStaticPaths() {
  return Object.entries(legalPages).map(([slug, page]) => ({
    params: { slug },
    props: { ...page, slug },
  }));
}

const props = Astro.props;
---
<LegalView {...props} />
