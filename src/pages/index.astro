---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FallingCards from '../components/FallingCards.astro';

const title = "ClickForNothing — The Useless Web & Random Website Directory";
const description = "Nothing to do? Click something. A curated collection of websites that serve absolutely no purpose. Explore the internet's most unnecessary corners.";
const canonicalPath = "/";

const faqs = [
  {
    question: "What is the useless web?",
    answer: "The useless web refers to a whimsical corner of the internet dedicated to funny, weird, interactive, and completely pointless websites. Rather than offering productivity tools or commercial products, these sites exist purely for digital art, humor, creative coding experiments, and time-wasting entertainment.",
  },
  {
    question: "Are these useless websites safe to visit?",
    answer: "Yes. Every website in the ClickForNothing database is manually tested and verified over secure HTTPS. None of our featured sites require logins, credit cards, software downloads, or invasive browser permissions.",
  },
  {
    question: "How does the random website generator choose destinations?",
    answer: "Our random website generator runs across an active index of verified useless destinations pre-screened for uptime, mobile responsiveness, and safe content.",
  },
  {
    question: "Can I submit my own funny or useless website project?",
    answer: "Absolutely! Independent web developers, creative coders, and internet explorers can submit original or discovered projects through our submission page. Submissions are reviewed for humor, originality, and safety.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ClickForNothing Random Website Generator',
  alternateName: 'The Useless Web Generator',
  applicationCategory: 'EntertainmentApplication',
  operatingSystem: 'All Web Browsers',
  url: 'https://clickfornothing.com/explore/',
  description: 'An interactive discovery experience that takes visitors to weird, funny, and wonderfully useless websites in one click.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<SiteLayout {title} {description} {canonicalPath}>
  <SiteHeader />

  <main class="home-main">
    <div class="home-container">
      <!-- Minimal Hero Section -->
      <section class="minimal-hero" aria-labelledby="hero-heading">
        <h1 id="hero-heading" class="hero-heading">
          Nothing to do? Click something.
        </h1>
        <p class="hero-subtitle">
          A collection of websites that serve absolutely no purpose. Explore the internet's most unnecessary corners.
        </p>

        <div class="hero-cta-group">
          <a href="/explore/" class="btn btn-primary" aria-label="Explore random useless websites">
            Explore Randomly
          </a>
          <a href="/submit/" class="btn btn-secondary" aria-label="Submit a new useless website">
            Submit a Website
          </a>
        </div>
      </section>

      <!-- Continuously Falling Website Cards -->
      <section class="falling-section" aria-label="Interactive Falling Cards Stream">
        <FallingCards limit={45} />
      </section>
    </div>
  </main>

  <!-- Retained Structured Data Schemas for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(toolSchema)} />
</SiteLayout>

<style>
  .home-main {
    width: 100%;
    min-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    padding: 32px 20px 48px;
    background: var(--bg, #faf9f6);
  }

  .home-container {
    max-width: 1040px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 5vh, 48px);
  }

  /* Minimal Centered Hero */
  .minimal-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(24px, 4vh, 48px) 16px 0;
  }

  .hero-heading {
    margin: 0 0 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(2.2rem, 5.2vw, 3.8rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text, #1a1a1a);
    max-width: 780px;
  }

  .hero-subtitle {
    margin: 0 0 28px;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-muted, #666666);
    max-width: 580px;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 22px;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border-radius: var(--radius, 8px);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: #111111;
    color: #ffffff;
    border: 1px solid #111111;
  }

  .btn-primary:hover {
    background: #2a2a2a;
    border-color: #2a2a2a;
    transform: translateY(-1px);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-secondary {
    background: #ffffff;
    color: #111111;
    border: 1px solid var(--border, #e6e5e0);
  }

  .btn-secondary:hover {
    background: #f7f6f2;
    border-color: #cccccc;
    transform: translateY(-1px);
  }

  .btn-secondary:active {
    transform: translateY(0);
  }

  /* Falling Section */
  .falling-section {
    width: 100%;
  }

  @media (max-width: 640px) {
    .home-main {
      padding: 16px 12px 32px;
    }
    .hero-heading {
      font-size: 2rem;
    }
    .hero-subtitle {
      font-size: 0.98rem;
      margin-bottom: 22px;
    }
    .btn {
      width: 100%;
      max-width: 280px;
    }
  }
</style>
