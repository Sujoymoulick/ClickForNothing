---
import CollectionDetailView from '../../views/CollectionDetailView.astro';
import { collections, type WebsiteCollection } from '../../data/collections';

export function getStaticPaths() {
  return collections.map((col) => ({
    params: { slug: col.slug },
    props: { collection: col },
  }));
}

const { collection } = Astro.props as { collection: WebsiteCollection };
---
<CollectionDetailView collection={collection} />
