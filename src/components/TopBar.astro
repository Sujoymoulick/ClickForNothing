---
import { Show, UserButton, SignInButton } from '@clerk/astro/components';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const locale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const home = getLocalizedPath('/', locale);
const explore = getLocalizedPath('/explore/', locale);
const dashboard = getLocalizedPath('/dashboard/', locale);
const path = Astro.url.pathname;
const isOn = (href: string) => path === href || path === href.replace(/\/$/, '');

const moreLinks = [
  { label: 'About us', href: getLocalizedPath('/about/', locale) },
  { label: 'Contact us', href: getLocalizedPath('/contact/', locale) },
  { label: 'Privacy policy', href: getLocalizedPath('/privacy-policy/', locale) },
  { label: 'Terms & conditions', href: getLocalizedPath('/terms-and-conditions/', locale) },
  { label: 'Cookie policy', href: getLocalizedPath('/cookie-policy/', locale) },
  { label: 'Disclaimer', href: getLocalizedPath('/disclaimer/', locale) },
];
---

<header class="topbar">
  <a href={home} class="brand pill" aria-label="clickfornothing home">
    <img src="/android-chrome-192x192.png" alt="" width="26" height="26" />
    <span>clickfornothing</span>
  </a>

  <nav class="nav pill" aria-label="Main">
    <a href={home} class:list={['item', { on: isOn(home) }]}>Submit</a>
    <a href={explore} class:list={['item', { on: isOn(explore) }]}>Explore</a>
    <Show when="signed-in">
      <span class="nav-row">
        <a href={dashboard} class:list={['item', { on: isOn(dashboard) }]}>Dashboard</a>
        <span class="nav-avatar"><UserButton /></span>
      </span>
    </Show>
    <Show when="signed-out">
      <span class="nav-row">
        <SignInButton mode="modal" class="item signin">Sign in</SignInButton>
      </span>
    </Show>

    <div class="more">
      <button type="button" class="more-btn" id="more-btn" aria-label="More" aria-haspopup="true" aria-expanded="false" aria-controls="more-menu">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="3" cy="8" r="1.6" /><circle cx="8" cy="8" r="1.6" /><circle cx="13" cy="8" r="1.6" /></svg>
      </button>
      <div class="more-menu" id="more-menu" role="menu" hidden>
        {moreLinks.map((l) => <a role="menuitem" href={l.href}>{l.label}</a>)}
      </div>
    </div>
  </nav>
</header>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    font: 500 13.5px/1 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    pointer-events: none;
  }
  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 5px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid #e6e5e0;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
  }
  .brand { gap: 8px; padding-right: 14px; color: #111; text-decoration: none; font-weight: 700; letter-spacing: -0.01em; }
  .brand img { width: 30px; height: 30px; border-radius: 50%; display: block; }

  .nav { gap: 2px; }
  .nav :global(clerk-show) { display: flex !important; align-items: center; }
  .nav-row { display: flex; flex-direction: row; align-items: center; gap: 2px; white-space: nowrap; }
  .nav :global(.item) {
    display: flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    color: #777;
    text-decoration: none;
    background: none;
    border: 0;
    font: inherit;
    cursor: pointer;
    white-space: nowrap;
  }
  .nav :global(.item:hover) { color: #111; background: #f3f2ee; }
  .nav :global(.item.on) { color: #fff; background: #111; }
  .nav :global(.item.signin) { color: #111; }

  .nav-avatar { display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; margin: 0 2px; }
  .nav-avatar :global(.cl-rootBox), .nav-avatar :global(.cl-userButtonBox), .nav-avatar :global(.cl-userButtonTrigger) { display: flex; align-items: center; }
  .nav-avatar :global(.cl-userButtonTrigger), .nav-avatar :global(.cl-avatarBox) { width: 28px; height: 28px; margin: 0; }

  .more { position: relative; display: flex; }
  .more-btn {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: none;
    color: #555;
    cursor: pointer;
  }
  .more-btn svg { fill: currentColor; }
  .more-btn:hover, .more-btn[aria-expanded='true'] { background: #f3f2ee; color: #111; }
  .more-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: -5px;
    min-width: 200px;
    padding: 6px;
    background: #fff;
    border: 1px solid #e6e5e0;
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    z-index: 30;
  }
  .more-menu[hidden] { display: none; }
  .more-menu a { padding: 10px 12px; border-radius: 9px; color: #333; text-decoration: none; font-size: 14px; line-height: 1.2; }
  .more-menu a:hover, .more-menu a:focus-visible { background: #f3f2ee; color: #111; outline: none; }

  @media (max-width: 560px) {
    .topbar { padding: 0 10px; height: 56px; font-size: 12.5px; }
    .pill { height: 38px; padding: 0 4px; }
    .brand { padding-right: 4px; }
    .brand span { display: none; }
    .nav :global(.item) { padding: 0 9px; height: 28px; }
    .more-menu { min-width: 190px; }
  }
  @media (max-width: 360px) {
    .nav :global(.item) { padding: 0 7px; }
  }
</style>

<script>
  function bindMore() {
    const btn = document.getElementById('more-btn');
    const menu = document.getElementById('more-menu');
    if (!btn || !menu || btn.dataset.ready) return;
    btn.dataset.ready = '1';
    const set = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      set(menu.hidden);
      if (!menu.hidden) (menu.querySelector('a') as HTMLElement | null)?.focus();
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !menu.contains(e.target as Node)) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); }
    });
  }
  bindMore();
  document.addEventListener('astro:page-load', bindMore);
</script>
