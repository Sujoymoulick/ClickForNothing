---
import { useTranslations } from '../i18n';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

interface Props {
  activeNav?: 'home' | 'discover' | 'articles' | 'about' | 'none';
}

const { activeNav = 'articles' } = Astro.props;

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);

const homeUrl = getLocalizedPath('/', currentLocale);
const discoverUrl = getLocalizedPath('/discover/', currentLocale);
const articlesUrl = getLocalizedPath('/articles/', currentLocale);
const aboutUrl = getLocalizedPath('/about/', currentLocale);
const searchUrl = getLocalizedPath('/search/', currentLocale);
const submitUrl = getLocalizedPath('/submit/', currentLocale);
---

<header class="editorial-header" id="editorial-header">
  <div class="header-inner">
    <!-- Brand Logo / Text -->
    <a href={homeUrl} class="brand-link" aria-label={t('nav.logo_aria') || 'ClickForNothing Home'}>
      <span class="brand-text">ClickForNothing</span>
    </a>

    <!-- Center Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <a href={homeUrl} class={`nav-item ${activeNav === 'home' ? 'is-active' : ''}`}>
        <span>{t('nav.home') || 'Home'}</span>
        {activeNav === 'home' && <span class="active-indicator" aria-hidden="true"></span>}
      </a>
      <a href={discoverUrl} class={`nav-item ${activeNav === 'discover' ? 'is-active' : ''}`}>
        <span>{t('nav.discover') || 'Discover'}</span>
        {activeNav === 'discover' && <span class="active-indicator" aria-hidden="true"></span>}
      </a>
      <a href={articlesUrl} class={`nav-item ${activeNav === 'articles' ? 'is-active' : ''}`} aria-current={activeNav === 'articles' ? 'page' : undefined}>
        <span>{t('nav.articles') || 'Articles'}</span>
        {activeNav === 'articles' && <span class="active-indicator" aria-hidden="true"></span>}
      </a>
      <a href={aboutUrl} class={`nav-item ${activeNav === 'about' ? 'is-active' : ''}`}>
        <span>{t('nav.about') || 'About'}</span>
        {activeNav === 'about' && <span class="active-indicator" aria-hidden="true"></span>}
      </a>
    </nav>

    <!-- Right Action Items -->
    <div class="header-actions">
      <a href={searchUrl} class="search-btn" aria-label={t('nav.search') || 'Search articles and websites'}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <a href={submitUrl} class="submit-site-btn">
        {t('footer.submit_site') || 'Submit a Site'}
      </a>

      <!-- Mobile Hamburger Toggle Button -->
      <button
        type="button"
        class="mobile-menu-btn"
        id="editorial-mobile-menu-toggle"
        aria-label={t('nav.toggle_menu') || 'Toggle menu'}
        aria-expanded="false"
        aria-controls="editorial-mobile-nav-panel"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-nav-panel" id="editorial-mobile-nav-panel" aria-hidden="true">
    <nav class="mobile-nav-links" aria-label="Mobile Navigation">
      <a href={homeUrl} class={`mobile-nav-item ${activeNav === 'home' ? 'is-active' : ''}`}>{t('nav.home') || 'Home'}</a>
      <a href={discoverUrl} class={`mobile-nav-item ${activeNav === 'discover' ? 'is-active' : ''}`}>{t('nav.discover') || 'Discover'}</a>
      <a href={articlesUrl} class={`mobile-nav-item ${activeNav === 'articles' ? 'is-active' : ''}`} aria-current={activeNav === 'articles' ? 'page' : undefined}>{t('nav.articles') || 'Articles'}</a>
      <a href={aboutUrl} class={`mobile-nav-item ${activeNav === 'about' ? 'is-active' : ''}`}>{t('nav.about') || 'About'}</a>
      <a href={searchUrl} class="mobile-nav-item">{t('nav.search') || 'Search'}</a>
      <a href={submitUrl} class="mobile-submit-btn">{t('footer.submit_site') || 'Submit a Site'}</a>
    </nav>
  </div>
</header>

<script>
  function setupEditorialHeader() {
    const toggleBtn = document.getElementById('editorial-mobile-menu-toggle');
    const panel = document.getElementById('editorial-mobile-nav-panel');

    if (!toggleBtn || !panel) return;

    // Remove existing event listeners by replacing with clone if needed
    toggleBtn.onclick = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      toggleBtn.classList.toggle('is-open', !isExpanded);
      panel.setAttribute('aria-hidden', String(isExpanded));
      panel.classList.toggle('is-open', !isExpanded);
    };

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.classList.remove('is-open');
        panel.setAttribute('aria-hidden', 'true');
        panel.classList.remove('is-open');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupEditorialHeader);
  } else {
    setupEditorialHeader();
  }
  document.addEventListener('astro:page-load', setupEditorialHeader);
</script>

<style>
  /* ==========================================================================
     MINIMAL EDITORIAL HEADER
     ========================================================================== */
  .editorial-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(255, 253, 250, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid #f1eeea;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  /* Brand Logo / Text */
  .brand-link {
    text-decoration: none;
    color: #09080c;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-text {
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.45rem;
    font-weight: 800;
    color: #09080c;
    letter-spacing: -0.02em;
  }

  /* Desktop Nav Links */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-item {
    position: relative;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: #334155;
    padding: 6px 0;
    transition: color 0.15s ease;
  }

  .nav-item:hover {
    color: #7c3aed;
  }

  .nav-item.is-active {
    color: #09080c;
    font-weight: 600;
  }

  .active-indicator {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2.5px;
    background-color: #7c3aed;
    border-radius: 999px;
  }

  /* Right Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: #334155;
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .search-btn:hover {
    color: #7c3aed;
    background-color: #f3f0ea;
  }

  .submit-site-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #7c3aed;
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 8px 18px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 1px 2px rgba(124, 58, 237, 0.2);
  }

  .submit-site-btn:hover {
    background-color: #6d28d9;
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(124, 58, 237, 0.3);
  }

  .submit-site-btn:active {
    transform: translateY(0);
    box-shadow: 0 1px 2px rgba(124, 58, 237, 0.2);
  }

  /* Mobile Menu Toggle Button */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: space-around;
    width: 34px;
    height: 34px;
    background: transparent;
    border: none;
    padding: 6px;
    cursor: pointer;
    border-radius: 6px;
  }

  .mobile-menu-btn:hover {
    background-color: #f3f0ea;
  }

  .mobile-menu-btn .bar {
    width: 100%;
    height: 2px;
    background-color: #09080c;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-menu-btn.is-open .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-btn.is-open .bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.is-open .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Nav Panel */
  .mobile-nav-panel {
    display: none;
    border-top: 1px solid #f1eeea;
    background-color: #fffdfa;
    padding: 16px 24px 20px;
  }

  .mobile-nav-panel.is-open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mobile-nav-item {
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    color: #334155;
    padding: 8px 0;
  }

  .mobile-nav-item.is-active {
    color: #7c3aed;
    font-weight: 700;
  }

  .mobile-submit-btn {
    margin-top: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #7c3aed;
    color: #ffffff;
    font-weight: 600;
    padding: 10px 16px;
    border-radius: 8px;
    text-decoration: none;
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }

    .submit-site-btn {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }
</style>
