---

<div class="meme-floating-canvas" aria-hidden="true" data-meme-stage>
  {floatingElements.map((item) => (
    <div
      class={`floating-item ${item.type === 'meme' ? 'floating-meme' : 'floating-deco'} item-${item.id}`}
      data-floating-id={item.id}
      data-role={item.role}
      data-zone={item.zone}
      data-base-x={item.baseX}
      data-base-y={item.baseY}
      data-speed={item.speed}
      data-rot={item.rot}
      style={`left: ${item.baseX}%; top: ${item.baseY}%; width: ${item.width}px; z-index: ${item.zIndex};`}
    >
      {item.type === 'meme' ? (
        <div class="meme-face-wrapper" data-interactive-face>
          <MemeArt meme={item.meme as any} />
        </div>
      ) : (
        <span class={`deco-glyph color-${item.color}`}>{item.glyph}</span>
      )}
    </div>
  ))}
</div>

<style is:global>
  .meme-floating-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .floating-item {
    position: absolute;
    pointer-events: none;
    user-select: none;
    will-change: transform;
    transform-origin: center center;
    contain: layout style;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .floating-meme {
    pointer-events: auto;
    cursor: grab;
  }

  .meme-face-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .floating-meme:hover .meme-face-wrapper {
    transform: scale(1.18) rotate(-4deg);
    filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.7));
  }

  .floating-meme:active .meme-face-wrapper {
    transform: scale(0.92) rotate(6deg);
  }

  .item-pepe-main:hover .meme-face-wrapper {
    transform: scale(1.12) rotate(4deg);
  }

  .meme-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .deco-glyph {
    display: inline-block;
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-weight: 900;
    line-height: 1;
    text-shadow: 3px 4px 0 #09080c;
  }

  .deco-glyph.color-purple {
    color: var(--purple, #7025ed);
    font-size: 42px;
  }

  .deco-glyph.color-pink {
    color: var(--pink, #f20caf);
    font-size: 46px;
  }

  .deco-glyph.color-cyan {
    color: var(--cyan, #19e8c5);
    font-size: 26px;
  }

  .deco-glyph.color-ink {
    color: var(--ink, #09080c);
    font-size: 34px;
    text-shadow: none;
    opacity: 0.85;
  }

  /* Responsive boundary scaling */
  @media (max-width: 1200px) {
    .item-pepe-main {
      width: 200px !important;
    }
    .floating-item[data-role="small-face"],
    .floating-item[data-role="trollface"],
    .floating-item[data-role="doge"] {
      width: 95px !important;
    }
  }

  @media (max-width: 920px) {
    .item-pepe-main {
      width: 160px !important;
    }
    .floating-item[data-role="small-face"],
    .floating-item[data-role="trollface"],
    .floating-item[data-role="doge"] {
      width: 80px !important;
    }
    .deco-glyph.color-purple,
    .deco-glyph.color-pink {
      font-size: 32px;
    }
  }

  /* On mobile screens, keep memes gently orbiting in edge margins */
  @media (max-width: 640px) {
    .item-pepe-main {
      width: 125px !important;
      opacity: 0.9;
    }
    .floating-item[data-role="small-face"],
    .floating-item[data-role="trollface"],
    .floating-item[data-role="doge"] {
      width: 65px !important;
      opacity: 0.85;
    }
    .floating-deco {
      opacity: 0.7;
    }
  }
</style>
