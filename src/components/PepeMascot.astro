<div class="mascot-shell" data-mascot role="region" aria-label="Interactive 3D Pepe mascot">
  <button
    class="mascot-sound-badge"
    type="button"
    data-sound-toggle
    aria-label="Toggle mascot sound"
    title="Hover mascot to play oo-ee-a-ea sound. Click to mute/unmute"
  >
    <span class="sound-icon" data-sound-icon aria-hidden="true">🔊</span>
    <span class="sound-text" data-sound-text>oo-ee-a-ea</span>
    <span class="sound-waves" data-sound-waves aria-hidden="true">
      <span class="bar bar-1"></span>
      <span class="bar bar-2"></span>
      <span class="bar bar-3"></span>
    </span>
  </button>
</div>

<script>
  const shell = document.querySelector('[data-mascot]');
  const stage = document.querySelector('.hero-stage');
  const cta = stage?.querySelector('.go-button');

  if (shell && stage) {
    const soundToggleBtn = shell.querySelector('[data-sound-toggle]');
    const soundIcon = shell.querySelector('[data-sound-icon]');
    const soundText = shell.querySelector('[data-sound-text]');

    const assets = {
      idle: '/Meshy_AI_T_Posing_Pepe_biped_Animation_01a1093d-f808-7748-b99e-773186993a94_withSkin.glb',
      hover: '/Meshy_AI_T_Posing_Pepe_biped_Animation_Walking_withSkin.glb',
      excited: '/Meshy_AI_T_Posing_Pepe_biped_Animation_Running_withSkin.glb',
    };

    let renderer;
    let scene;
    let camera;
    let modelRoot;
    let mixer;
    let activeAction;
    let actions = new Map();
    let observer;
    let resizeObserver;
    let frameId = 0;
    let timerId = 0;
    let loaded = false;
    let disposed = false;
    let requested = false;
    let inView = false;
    let pageVisible = !document.hidden;
    let animationState = 'idle';
    let stateTime = 0;
    let lastTime = 0;
    let listeningResize = false;
    let three;
    let GLTFLoaderClass;
    let headBone;
    let headOffsetEuler;
    let headOffsetQuaternion;
    let headLookX = 0;
    let headLookY = 0;
    let pointerX = 0;
    let pointerY = 0;
    let pointerActive = false;
    let mascotHovered = false;
    let ctaHovered = false;
    let ctaFocused = false;
    let returnAfter = 0;
    let baseScale = 1;
    let modelHeight = 1;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const clipPromises = new Map();

    // Sound effects setup
    const TARGET_VOLUME = 0.4;
    const movementAudio = new Audio('/oo-ee-a-ea.mp3');
    movementAudio.preload = 'auto';
    movementAudio.loop = true;
    movementAudio.volume = 0;

    let isMuted = false;
    let isSoundRequested = false;
    let userHasInteracted = false;
    let fadeTimer = 0;
    let resetIdleTimer = 0;

    // Web Audio Stereo Panner
    let audioCtx = null;
    let audioSourceNode = null;
    let pannerNode = null;

    function initWebAudio() {
      if (audioCtx) return;
      try {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return;
        audioCtx = new AudioContextClass();
        if (typeof audioCtx.createStereoPanner === 'function') {
          pannerNode = audioCtx.createStereoPanner();
          audioSourceNode = audioCtx.createMediaElementSource(movementAudio);
          audioSourceNode.connect(pannerNode);
          pannerNode.connect(audioCtx.destination);
        }
      } catch (e) {
        // Fallback: standard audio playback without stereo panning
      }
    }

    function updateSoundUI(isPlaying, needsGesture = false) {
      if (!soundToggleBtn) return;

      soundToggleBtn.classList.toggle('is-playing', isPlaying && !isMuted);
      soundToggleBtn.classList.toggle('is-muted', isMuted);
      soundToggleBtn.classList.toggle('needs-gesture', needsGesture && !isMuted && isSoundRequested);

      if (isMuted) {
        if (soundIcon) soundIcon.textContent = '🔇';
        if (soundText) soundText.textContent = 'Muted';
        soundToggleBtn.setAttribute('aria-label', 'Unmute mascot sound');
        soundToggleBtn.setAttribute('title', 'Sound is muted. Click to unmute');
      } else if (needsGesture && isSoundRequested) {
        if (soundIcon) soundIcon.textContent = '🎵';
        if (soundText) soundText.textContent = 'Click for sound';
        soundToggleBtn.setAttribute('aria-label', 'Click to enable mascot sound in your browser');
        soundToggleBtn.setAttribute('title', 'Click to enable sound');
      } else if (isPlaying) {
        if (soundIcon) soundIcon.textContent = '🔊';
        if (soundText) soundText.textContent = 'oo-ee-a-ea';
        soundToggleBtn.setAttribute('aria-label', 'Mascot sound playing. Click to mute');
        soundToggleBtn.setAttribute('title', 'Playing oo-ee-a-ea. Click to mute');
      } else {
        if (soundIcon) soundIcon.textContent = '🔊';
        if (soundText) soundText.textContent = 'oo-ee-a-ea';
        soundToggleBtn.setAttribute('aria-label', 'Mascot sound enabled. Hover mascot to play');
        soundToggleBtn.setAttribute('title', 'Hover mascot to play oo-ee-a-ea sound. Click to mute');
      }
    }

    function rampVolume(target, duration = 150, onComplete) {
      if (fadeTimer) {
        window.clearInterval(fadeTimer);
        fadeTimer = 0;
      }
      const start = movementAudio.volume;
      const diff = target - start;
      if (Math.abs(diff) < 0.02) {
        movementAudio.volume = target;
        if (onComplete) onComplete();
        return;
      }
      const steps = 10;
      const stepTime = Math.max(10, Math.floor(duration / steps));
      let curStep = 0;
      fadeTimer = window.setInterval(() => {
        curStep++;
        const progress = Math.min(1, curStep / steps);
        movementAudio.volume = Math.max(0, Math.min(1, start + diff * progress));
        if (curStep >= steps) {
          window.clearInterval(fadeTimer);
          fadeTimer = 0;
          movementAudio.volume = target;
          if (onComplete) onComplete();
        }
      }, stepTime);
    }

    function startMovementAudio() {
      if (isMuted || disposed || !pageVisible || reducedMotion.matches) return;
      isSoundRequested = true;

      if (resetIdleTimer) {
        window.clearTimeout(resetIdleTimer);
        resetIdleTimer = 0;
      }

      if (audioCtx && audioCtx.state === 'suspended' && userHasInteracted) {
        audioCtx.resume().catch(() => {});
      }

      if (!movementAudio.paused) {
        rampVolume(TARGET_VOLUME, 120);
        updateSoundUI(true);
        return;
      }

      movementAudio.volume = 0;
      const playPromise = movementAudio.play();
      if (playPromise !== undefined) {
        playPromise
          .then(() => {
            userHasInteracted = true;
            rampVolume(TARGET_VOLUME, 150);
            updateSoundUI(true);
          })
          .catch(() => {
            updateSoundUI(false, true);
          });
      }
    }

    function stopMovementAudio() {
      isSoundRequested = false;
      updateSoundUI(false);

      if (movementAudio.paused) return;

      rampVolume(0, 150, () => {
        if (!isSoundRequested) {
          movementAudio.pause();
          if (!resetIdleTimer) {
            resetIdleTimer = window.setTimeout(() => {
              resetIdleTimer = 0;
              if (movementAudio.paused) {
                movementAudio.currentTime = 0;
              }
            }, 3500);
          }
        }
      });
    }

    function handleUserActivation() {
      userHasInteracted = true;
      initWebAudio();
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume().catch(() => {});
      }
      if (isSoundRequested && !isMuted) {
        startMovementAudio();
      }
    }

    window.addEventListener('pointerdown', handleUserActivation, { passive: true });
    window.addEventListener('click', handleUserActivation, { passive: true });
    window.addEventListener('keydown', handleUserActivation, { passive: true });
    window.addEventListener('touchstart', handleUserActivation, { passive: true });

    if (soundToggleBtn) {
      soundToggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        handleUserActivation();
        isMuted = !isMuted;
        if (isMuted) {
          stopMovementAudio();
        } else {
          updateSoundUI(false);
          startMovementAudio();
        }
      });
    }

    function renderOnce() {
      if (loaded && renderer && scene && camera && !disposed) renderer.render(scene, camera);
    }

    function canAnimate() {
      return loaded && inView && pageVisible && !reducedMotion.matches && !disposed;
    }

    function stopLoop() {
      if (timerId) window.clearTimeout(timerId);
      if (frameId) window.cancelAnimationFrame(frameId);
      timerId = 0;
      frameId = 0;
    }

    function scheduleFrame() {
      if (timerId || frameId || !canAnimate()) return;
      timerId = window.setTimeout(() => {
        timerId = 0;
        if (canAnimate()) frameId = window.requestAnimationFrame(drawFrame);
      }, 33);
    }

    function desiredStateAfterReturn() {
      if (mascotHovered || ctaHovered || ctaFocused) return 'hover';
      return pointerActive ? 'lookAtPointer' : 'idle';
    }

    function playClipFor(state) {
      if (!mixer) return;
      const next = actions.get(state === 'excited' ? 'excited' : state === 'hover' ? 'hover' : 'idle') || actions.get('idle');
      if (!next || next === activeAction) return;
      if (activeAction) {
        next.reset().play();
        activeAction.crossFadeTo(next, 0.24, false);
      } else next.reset().fadeIn(0.24).play();
      activeAction = next;
    }

    function enterState(next) {
      if (animationState === next) return;
      animationState = next;
      stateTime = 0;
      playClipFor(next);

      if (next === 'hover' || next === 'excited') {
        startMovementAudio();
      } else {
        stopMovementAudio();
      }
    }

    function returnToIdle() {
      returnAfter = 0.3;
      enterState('returnToIdle');
    }

    function updateInteractionState() {
      if (animationState === 'excited') return;
      if (mascotHovered || ctaHovered || ctaFocused) enterState('hover');
      else if (animationState === 'hover') returnToIdle();
      else if (pointerActive && animationState === 'idle') enterState('lookAtPointer');
    }

    function drawFrame(now) {
      frameId = 0;
      if (!canAnimate()) return;
      const delta = lastTime ? Math.min((now - lastTime) / 1000, 0.05) : 1 / 30;
      lastTime = now;
      stateTime += delta;

      if (animationState === 'excited' && stateTime >= 0.67) returnToIdle();
      else if (animationState === 'returnToIdle') {
        returnAfter -= delta;
        if (returnAfter <= 0) enterState(desiredStateAfterReturn());
      }

      const follow = 1 - Math.exp(-delta * 5);
      const trackHead = animationState === 'lookAtPointer' || animationState === 'hover';
      const targetX = trackHead ? -pointerY * 0.12 : 0;
      const targetY = trackHead ? pointerX * 0.2 : 0;
      headLookX = three.MathUtils.lerp(headLookX, targetX, follow);
      headLookY = three.MathUtils.lerp(headLookY, targetY, follow);
      if (mixer) mixer.update(delta);
      if (headBone) {
        headOffsetEuler.set(headLookX, headLookY, 0);
        headOffsetQuaternion.setFromEuler(headOffsetEuler);
        headBone.quaternion.multiply(headOffsetQuaternion);
      }
      renderer.render(scene, camera);
      scheduleFrame();
    }

    function startLoop() {
      lastTime = 0;
      if (canAnimate()) scheduleFrame();
      else renderOnce();
    }

    function resizeRenderer() {
      if (!renderer || !camera || disposed) return;
      const width = Math.max(shell.clientWidth, 1);
      const height = Math.max(shell.clientHeight, 1);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      const fitHeight = modelHeight * baseScale;
      const fitWidth = fitHeight * camera.aspect;
      const fitSpan = Math.max(fitHeight, fitWidth);
      const distance = fitSpan / (2 * Math.tan(three.MathUtils.degToRad(camera.fov / 2))) * 1.45;
      camera.position.set(0, fitHeight * 0.5, distance);
      camera.lookAt(0, fitHeight * 0.5, 0);
      camera.updateProjectionMatrix();
      renderOnce();
    }

    async function preloadStateClip(state, url) {
      if (clipPromises.has(state)) return clipPromises.get(state);
      const task = new Promise((resolve) => {
        if (!GLTFLoaderClass || disposed) return resolve();
        new GLTFLoaderClass().load(
          url,
          (gltf) => {
            if (disposed || !mixer) return resolve();
            const clip = gltf.animations.find((item) => item.duration > 0.2);
            if (clip) {
              const action = mixer.clipAction(clip);
              action.setLoop(three.LoopRepeat, Infinity);
              actions.set(state, action);
              if (animationState === state) playClipFor(state);
            }
            resolve();
          },
          undefined,
          (error) => {
            console.warn(`Could not prepare Pepe's ${state} animation.`, error);
            resolve();
          }
        );
      });
      clipPromises.set(state, task);
      return task;
    }

    async function startLoading() {
      if (requested || disposed) return;
      requested = true;
      try {
        three = await import('three');
        const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
        GLTFLoaderClass = GLTFLoader;
        if (disposed) return;
        const { AmbientLight, DirectionalLight, PerspectiveCamera, Scene, SRGBColorSpace, WebGLRenderer } = three;
        renderer = new WebGLRenderer({ alpha: true, antialias: false, powerPreference: 'low-power', stencil: false, depth: true });
        renderer.outputColorSpace = SRGBColorSpace;
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.25));
        renderer.setClearColor(0x000000, 0);
        renderer.domElement.className = 'mascot-canvas';
        renderer.domElement.setAttribute('aria-hidden', 'true');
        shell.appendChild(renderer.domElement);
        scene = new Scene();
        camera = new PerspectiveCamera(34, 1, 0.1, 100);
        const ambient = new AmbientLight(0xffffff, 2.25);
        const keyLight = new DirectionalLight(0xffffff, 2.3);
        keyLight.position.set(-3, 5, 5);
        scene.add(ambient, keyLight);
        resizeRenderer();
      } catch (error) {
        console.warn('3D mascot unavailable.', error);
        disposeRenderer();
        shell.dataset.ready = 'false';
        return;
      }

      new GLTFLoaderClass().load(assets.idle, (gltf) => {
        if (disposed) {
          disposeObject(gltf.scene);
          return;
        }
        modelRoot = gltf.scene;
        const bounds = new three.Box3().setFromObject(modelRoot);
        const size = bounds.getSize(new three.Vector3());
        const center = bounds.getCenter(new three.Vector3());
        modelHeight = Math.max(size.y, 0.001);
        baseScale = 1.48 / modelHeight;
        modelRoot.position.set(-center.x, -bounds.min.y, -center.z);
        modelRoot.scale.setScalar(baseScale);
        headBone = modelRoot.getObjectByName('mixamorigHead');
        headOffsetEuler = new three.Euler(0, 0, 0, 'XYZ');
        headOffsetQuaternion = new three.Quaternion();
        scene.add(modelRoot);

        const idleClip = gltf.animations.filter((clip) => clip.duration > 0.5).sort((a, b) => b.duration - a.duration)[0];
        mixer = new three.AnimationMixer(modelRoot);
        if (idleClip) {
          const idleAction = mixer.clipAction(idleClip);
          idleAction.setLoop(three.LoopRepeat, Infinity);
          actions.set('idle', idleAction);
        }
        playClipFor('idle');
        loaded = true;
        shell.dataset.ready = 'true';
        resizeRenderer();
        startLoop();
        void preloadStateClip('hover', assets.hover);
        void preloadStateClip('excited', assets.excited);
      }, undefined, (error) => {
        console.warn('Could not load the 3D mascot.', error);
        disposeRenderer();
        shell.dataset.ready = 'false';
      });
    }

    function setCtaHover(value) {
      ctaHovered = value;
      if (value && !clipPromises.has('hover')) {
        void preloadStateClip('hover', assets.hover);
      }
      updateInteractionState();
      startLoop();
    }

    function triggerExcited() {
      if (!clipPromises.has('excited')) {
        void preloadStateClip('excited', assets.excited);
      }
      enterState('excited');
      if (canAnimate()) drawFrame(performance.now());
      else startLoop();
    }

    function onPointerMove(event) {
      if (reducedMotion.matches) return;
      const mascot = shell.getBoundingClientRect();
      const stageBounds = stage.getBoundingClientRect();
      if (!mascot.width || !mascot.height || !stageBounds.width || !stageBounds.height) return;
      const centerX = mascot.left + mascot.width / 2;
      const centerY = mascot.top + mascot.height / 2;
      pointerX = Math.max(-1, Math.min(1, ((event.clientX - centerX) / stageBounds.width) * 1.7));
      pointerY = Math.max(-1, Math.min(1, ((event.clientY - centerY) / stageBounds.height) * 1.7));
      pointerActive = true;

      // Stereo panning tracks cursor position relative to the mascot
      if (pannerNode && audioCtx && audioCtx.state === 'running') {
        const panValue = Math.max(-0.8, Math.min(0.8, (event.clientX - centerX) / (mascot.width / 2)));
        pannerNode.pan.setValueAtTime(panValue, audioCtx.currentTime);
      }

      const overMascot = event.clientX >= mascot.left && event.clientX <= mascot.right && event.clientY >= mascot.top && event.clientY <= mascot.bottom;
      if (overMascot !== mascotHovered) {
        mascotHovered = overMascot;
        if (mascotHovered && !clipPromises.has('hover')) {
          void preloadStateClip('hover', assets.hover);
        }
        updateInteractionState();
      } else if (!mascotHovered && animationState === 'idle') updateInteractionState();
      startLoop();
    }

    function onPointerLeave() {
      pointerActive = false;
      mascotHovered = false;
      pointerX = 0;
      pointerY = 0;
      updateInteractionState();
      startLoop();
    }

    function onCtaClick(event) {
      if (event.detail === 0) triggerExcited();
    }

    function onVisibilityChange() {
      pageVisible = !document.hidden;
      if (pageVisible) startLoop();
      else {
        stopLoop();
        stopMovementAudio();
      }
    }

    function onMotionChange() {
      if (reducedMotion.matches) {
        stopLoop();
        stopMovementAudio();
        renderOnce();
      } else startLoop();
    }

    function disposeObject(root) {
      const disposedTextures = new Set();
      root.traverse((object) => {
        if (!object.isMesh) return;
        object.geometry?.dispose();
        const materials = Array.isArray(object.material) ? object.material : [object.material];
        for (const material of materials) {
          if (!material) continue;
          for (const value of Object.values(material)) {
            if (value?.isTexture && !disposedTextures.has(value)) {
              disposedTextures.add(value);
              value.dispose();
            }
          }
          material.dispose();
        }
      });
    }

    function disposeRenderer() {
      stopLoop();
      if (renderer) {
        renderer.dispose();
        renderer.domElement.remove();
        renderer = undefined;
      }
      loaded = false;
    }

    function cleanup() {
      if (disposed) return;
      disposed = true;
      stopLoop();
      stopMovementAudio();
      if (fadeTimer) window.clearInterval(fadeTimer);
      if (resetIdleTimer) window.clearTimeout(resetIdleTimer);
      try {
        movementAudio.pause();
      } catch (e) {}
      if (audioCtx && audioCtx.state !== 'closed') {
        audioCtx.close().catch(() => {});
      }
      observer?.disconnect();
      resizeObserver?.disconnect();
      document.removeEventListener('visibilitychange', onVisibilityChange);
      reducedMotion.removeEventListener('change', onMotionChange);
      window.removeEventListener('pointerdown', handleUserActivation);
      window.removeEventListener('click', handleUserActivation);
      window.removeEventListener('keydown', handleUserActivation);
      window.removeEventListener('touchstart', handleUserActivation);
      stage.removeEventListener('pointermove', onPointerMove);
      stage.removeEventListener('pointerleave', onPointerLeave);
      cta?.removeEventListener('pointerenter', onCtaHoverStart);
      cta?.removeEventListener('pointerleave', onCtaHoverEnd);
      cta?.removeEventListener('focus', onCtaFocus);
      cta?.removeEventListener('blur', onCtaBlur);
      cta?.removeEventListener('pointerdown', onCtaPointerDown);
      cta?.removeEventListener('click', onCtaClick);
      if (mixer && modelRoot) {
        mixer.stopAllAction();
        for (const action of actions.values()) mixer.uncacheAction(action.getClip(), modelRoot);
        mixer.uncacheRoot(modelRoot);
      }
      if (modelRoot) disposeObject(modelRoot);
      disposeRenderer();
      window.removeEventListener('pagehide', cleanup);
      if (listeningResize) window.removeEventListener('resize', resizeRenderer);
    }

    function onCtaHoverStart() { setCtaHover(true); }
    function onCtaHoverEnd() { setCtaHover(false); }
    function onCtaFocus() { ctaFocused = true; updateInteractionState(); startLoop(); }
    function onCtaBlur() { ctaFocused = false; updateInteractionState(); startLoop(); }
    function onCtaPointerDown(event) { if (event.button === 0) triggerExcited(); }

    shell.addEventListener('pointerenter', () => {
      mascotHovered = true;
      if (!clipPromises.has('hover')) void preloadStateClip('hover', assets.hover);
      updateInteractionState();
      startLoop();
    }, { passive: true });

    shell.addEventListener('pointerleave', () => {
      mascotHovered = false;
      updateInteractionState();
      startLoop();
    }, { passive: true });

    shell.addEventListener('pointerdown', (e) => {
      if (e.target && e.target.closest('[data-sound-toggle]')) return;
      handleUserActivation();
      triggerExcited();
    }, { passive: true });

    document.addEventListener('visibilitychange', onVisibilityChange);
    reducedMotion.addEventListener('change', onMotionChange);
    stage.addEventListener('pointermove', onPointerMove, { passive: true });
    stage.addEventListener('pointerleave', onPointerLeave, { passive: true });
    cta?.addEventListener('pointerenter', onCtaHoverStart, { passive: true });
    cta?.addEventListener('pointerleave', onCtaHoverEnd, { passive: true });
    cta?.addEventListener('focus', onCtaFocus);
    cta?.addEventListener('blur', onCtaBlur);
    cta?.addEventListener('pointerdown', onCtaPointerDown, { passive: true });
    cta?.addEventListener('click', onCtaClick);
    window.addEventListener('pagehide', cleanup, { once: true });

    function triggerMascotInit() {
      startLoading();
      startLoop();
    }

    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver((entries) => {
        inView = entries.some((entry) => entry.isIntersecting);
        if (inView) {
          triggerMascotInit();
        } else {
          stopLoop();
          stopMovementAudio();
        }
      }, { rootMargin: '200px' });
      observer.observe(shell);
    } else {
      inView = true;
      triggerMascotInit();
    }

    if ('ResizeObserver' in window) {
      resizeObserver = new ResizeObserver(resizeRenderer);
      resizeObserver.observe(shell);
    } else {
      listeningResize = true;
      window.addEventListener('resize', resizeRenderer, { passive: true });
    }
  }
</script>

<style is:global>
  .mascot-shell {
    position: absolute;
    z-index: 2;
    top: 50%;
    right: 3.6%;
    width: clamp(220px, 22vw, 330px);
    height: clamp(240px, 28vw, 360px);
    pointer-events: auto;
    cursor: pointer;
    transform: translateY(-51%);
  }

  .mascot-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity .25s ease;
  }

  .mascot-shell[data-ready="true"] .mascot-canvas {
    opacity: 1;
  }

  /* Sound Badge Side by Side with Model */
  .mascot-sound-badge {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 6;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    border: 3px solid var(--ink);
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 4px 0 var(--ink);
    color: var(--ink);
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    white-space: nowrap;
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease, background-color 0.15s ease;
  }

