---
// CookieBanner.astro — Responsive cookie policy banner matching ClickForNothing's neo-brutalist theme
---

<div
  id="cookie-banner"
  class="cookie-banner"
  role="region"
  aria-label="Cookie and privacy preferences"
  hidden
>
  <div class="cookie-banner-inner">
    <div class="cookie-main">
      <div class="cookie-icon" aria-hidden="true">🍪</div>
      <div class="cookie-info">
        <h2 class="cookie-title">We Value Your Privacy</h2>
        <p class="cookie-text">
          We use cookies and local storage to keep ClickForNothing fun, smooth, and functioning properly.
          Read our <a href="/cookie-policy/" class="cookie-link">Cookie Policy</a> to learn more.
        </p>
      </div>
    </div>
    <div class="cookie-actions">
      <button
        type="button"
        id="cookie-decline-btn"
        class="cookie-btn cookie-btn-decline"
        aria-label="Decline non-essential cookies"
      >
        Decline
      </button>
      <button
        type="button"
        id="cookie-accept-btn"
        class="cookie-btn cookie-btn-accept"
        aria-label="Accept all cookies"
      >
        Accept All
      </button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: max(16px, env(safe-area-inset-bottom, 16px));
    inset-inline: 0;
    margin-inline: auto;
    width: min(calc(100% - 24px), 780px);
    z-index: 99999;
    pointer-events: none;
    opacity: 0;
    transform: translateY(24px) scale(0.98);
    transition: opacity 220ms ease, transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cookie-banner.is-visible {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .cookie-banner.is-hiding {
    pointer-events: none;
    opacity: 0;
    transform: translateY(20px) scale(0.97);
  }

  .cookie-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 20px;
    background: #fff9df;
    border: 3.5px solid var(--ink, #09080c);
    border-radius: 24px;
    box-shadow: 0 8px 0 var(--ink, #09080c);
    color: var(--ink, #09080c);
  }

  .cookie-main {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1 1 auto;
    min-width: 0;
  }

  .cookie-icon {
    font-size: 2.2rem;
    line-height: 1;
    flex-shrink: 0;
    animation: gentle-spin 6s ease-in-out infinite;
  }

  .cookie-info {
    flex: 1 1 auto;
    min-width: 0;
  }

  .cookie-title {
    margin: 0 0 3px;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.18rem;
    font-weight: 400;
    line-height: 1.1;
    color: var(--purple, #7025ed);
    letter-spacing: -0.01em;
  }

  .cookie-text {
    margin: 0;
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-size: 0.92rem;
    line-height: 1.35;
    font-weight: 600;
    color: var(--ink, #09080c);
  }

  .cookie-link {
    color: var(--pink, #f20caf);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 120ms ease;
  }

  .cookie-link:hover {
    color: var(--purple, #7025ed);
  }

  .cookie-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .cookie-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px 18px;
    border: 2.5px solid var(--ink, #09080c);
    border-radius: 999px;
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-size: 0.96rem;
    font-weight: 800;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 120ms ease, box-shadow 120ms ease, background-color 120ms ease;
  }

  .cookie-btn:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 var(--ink, #09080c);
  }

  .cookie-btn:focus-visible,
  .cookie-link:focus-visible {
    outline: 3px dashed var(--purple, #7025ed);
    outline-offset: 3px;
  }

  .cookie-btn-decline {
    background: #ffffff;
    color: var(--ink, #09080c);
    box-shadow: 0 3px 0 var(--ink, #09080c);
  }

  .cookie-btn-decline:hover {
    background: #f1efdf;
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--ink, #09080c);
  }

  .cookie-btn-accept {
    background: var(--pink, #f20caf);
    color: #ffffff;
    box-shadow: 0 3px 0 var(--ink, #09080c);
  }

  .cookie-btn-accept:hover {
    filter: saturate(1.15);
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--ink, #09080c);
  }

  @keyframes gentle-spin {
    0%, 100% { transform: rotate(0deg); }
    20% { transform: rotate(-10deg); }
    40% { transform: rotate(10deg); }
    60% { transform: rotate(-5deg); }
    80% { transform: rotate(5deg); }
  }

  /* Responsive styling for tablets and small screens */
  @media (max-width: 680px) {
    .cookie-banner {
      width: min(calc(100% - 20px), 520px);
      bottom: max(12px, env(safe-area-inset-bottom, 12px));
    }

    .cookie-banner-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding: 15px 16px;
      border-radius: 20px;
      box-shadow: 0 6px 0 var(--ink, #09080c);
    }

    .cookie-actions {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .cookie-btn {
      width: 100%;
      padding: 8px 12px;
      font-size: 0.94rem;
    }
  }

  /* Extra small screens (e.g. phones <= 360px) */
  @media (max-width: 360px) {
    .cookie-banner {
      width: calc(100% - 14px);
      bottom: max(8px, env(safe-area-inset-bottom, 8px));
    }

    .cookie-icon {
      font-size: 1.8rem;
    }

    .cookie-title {
      font-size: 1.05rem;
    }

    .cookie-text {
      font-size: 0.86rem;
    }

    .cookie-actions {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-banner,
    .cookie-icon,
    .cookie-btn {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'cfn_cookie_consent';

    function initCookieBanner() {
      const banner = document.getElementById('cookie-banner');
      const acceptBtn = document.getElementById('cookie-accept-btn');
      const declineBtn = document.getElementById('cookie-decline-btn');
      if (!banner || !acceptBtn || !declineBtn) return;

      let consent;
      try {
        consent = localStorage.getItem(STORAGE_KEY);
      } catch (e) {
        // LocalStorage might be disabled in private mode
      }

      if (!consent) {
        banner.removeAttribute('hidden');
        // Trigger smooth slide in
        requestAnimationFrame(() => {
          banner.classList.add('is-visible');
        });
      }

      function handleChoice(choice) {
        try {
          localStorage.setItem(STORAGE_KEY, choice);
        } catch (e) {}

        banner.classList.remove('is-visible');
        banner.classList.add('is-hiding');

        const onTransitionEnd = () => {
          banner.setAttribute('hidden', '');
          banner.classList.remove('is-hiding');
        };

        banner.addEventListener('transitionend', onTransitionEnd, { once: true });
        // Fallback in case transition is skipped
        setTimeout(onTransitionEnd, 350);
      }

      acceptBtn.onclick = () => handleChoice('accepted');
      declineBtn.onclick = () => handleChoice('declined');

      // Allow reopening from footer or any custom trigger
      window.addEventListener('cfn:open-cookie-banner', () => {
        banner.removeAttribute('hidden');
        banner.classList.remove('is-hiding');
        requestAnimationFrame(() => {
          banner.classList.add('is-visible');
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCookieBanner);
    } else {
      initCookieBanner();
    }
  })();
</script>
