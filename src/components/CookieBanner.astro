---
import { useTranslations } from '../i18n';
import { getLocalizedPath, getLocaleFromUrl } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);
const cookiePolicyUrl = getLocalizedPath('/cookie-policy/', currentLocale);
---

<div
  id="cookie-banner"
  class="cookie-banner"
  role="region"
  aria-label={t('cookie_banner.aria_label')}
  hidden
>
  <div class="cookie-banner-inner">
    <div class="cookie-main">
      <div class="cookie-icon" aria-hidden="true">🍪</div>
      <div class="cookie-info">
        <h2 class="cookie-title">{t('cookie_banner.title')}</h2>
        <p class="cookie-text">
          {t('cookie_banner.text')}
          <a href={cookiePolicyUrl} class="cookie-link">{t('cookie_banner.cookie_policy')}</a>
        </p>
      </div>
    </div>
    <div class="cookie-actions">
      <button
        type="button"
        id="cookie-decline-btn"
        class="cookie-btn cookie-btn-decline"
        aria-label={t('cookie_banner.decline_aria')}
      >
        {t('cookie_banner.decline')}
      </button>
      <button
        type="button"
        id="cookie-accept-btn"
        class="cookie-btn cookie-btn-accept"
        aria-label={t('cookie_banner.accept_aria')}
      >
        {t('cookie_banner.accept')}
      </button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: max(16px, env(safe-area-inset-bottom, 16px));
    inset-inline: 0;
    margin-inline: auto;
    width: min(calc(100% - 24px), 780px);
    z-index: 99999;
    pointer-events: none;
    opacity: 0;
    transform: translateY(16px) scale(0.99);
    transition: opacity 120ms ease-out, transform 120ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .cookie-banner.is-visible {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .cookie-banner.is-hiding {
    pointer-events: none;
    opacity: 0;
    transform: translateY(12px) scale(0.98);
  }

  .cookie-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 20px;
    background: #fff9df;
    border: 3.5px solid var(--ink, #09080c);
    border-radius: 24px;
    box-shadow: 0 8px 0 var(--ink, #09080c);
    color: var(--ink, #09080c);
    contain: layout paint;
  }

  .cookie-main {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1 1 auto;
    min-width: 0;
  }

  .cookie-icon {
    font-size: 2.2rem;
    line-height: 1;
    flex-shrink: 0;
    user-select: none;
  }

  .cookie-info {
    flex: 1 1 auto;
    min-width: 0;
  }

  .cookie-title {
    margin: 0 0 3px;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.18rem;
    font-weight: 400;
    line-height: 1.1;
    color: var(--purple, #7025ed);
    letter-spacing: -0.01em;
  }

  .cookie-text {
    margin: 0;
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-size: 0.92rem;
    line-height: 1.35;
    font-weight: 600;
    color: var(--ink, #09080c);
  }

  .cookie-link {
    color: var(--pink, #f20caf);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cookie-link:hover {
    color: var(--purple, #7025ed);
  }

  .cookie-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .cookie-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px 18px;
    border: 2.5px solid var(--ink, #09080c);
    border-radius: 999px;
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-size: 0.96rem;
    font-weight: 800;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    touch-action: manipulation;
    transition: transform 90ms ease, box-shadow 90ms ease, filter 90ms ease;
  }

  .cookie-btn:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 var(--ink, #09080c);
  }

  .cookie-btn:focus-visible,
  .cookie-link:focus-visible {
    outline: 3px dashed var(--purple, #7025ed);
    outline-offset: 3px;
  }

  .cookie-btn-decline {
    background: #ffffff;
    color: var(--ink, #09080c);
    box-shadow: 0 3px 0 var(--ink, #09080c);
  }

  .cookie-btn-decline:hover {
    background: #f1efdf;
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--ink, #09080c);
  }

  .cookie-btn-accept {
    background: var(--pink, #f20caf);
    color: #ffffff;
    box-shadow: 0 3px 0 var(--ink, #09080c);
  }

  .cookie-btn-accept:hover {
    filter: saturate(1.15);
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--ink, #09080c);
  }

  /* Responsive styling for tablets and small screens */
  @media (max-width: 680px) {
    .cookie-banner {
      width: min(calc(100% - 20px), 520px);
      bottom: max(12px, env(safe-area-inset-bottom, 12px));
    }

    .cookie-banner-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding: 15px 16px;
      border-radius: 20px;
      box-shadow: 0 6px 0 var(--ink, #09080c);
    }

    .cookie-actions {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .cookie-btn {
      width: 100%;
      padding: 8px 12px;
      font-size: 0.94rem;
    }
  }

  /* Extra small screens (e.g. phones <= 360px) */
  @media (max-width: 360px) {
    .cookie-banner {
      width: calc(100% - 14px);
      bottom: max(8px, env(safe-area-inset-bottom, 8px));
    }

    .cookie-icon {
      font-size: 1.8rem;
    }

    .cookie-title {
      font-size: 1.05rem;
    }

    .cookie-text {
      font-size: 0.86rem;
    }

    .cookie-actions {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-banner,
    .cookie-icon,
    .cookie-btn {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'cfn_cookie_consent';
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept-btn');
    const declineBtn = document.getElementById('cookie-decline-btn');
    if (!banner || !acceptBtn || !declineBtn) return;

    let consent;
    try {
      consent = localStorage.getItem(STORAGE_KEY);
    } catch (e) {}

    if (!consent) {
      banner.removeAttribute('hidden');
      requestAnimationFrame(() => {
        banner.classList.add('is-visible');
      });
    }

    function handleChoice(choice) {
      // Instant UI response: disable interaction immediately and start swift exit
      banner.style.pointerEvents = 'none';
      banner.classList.remove('is-visible');
      banner.classList.add('is-hiding');

      try {
        localStorage.setItem(STORAGE_KEY, choice);
      } catch (e) {}

      // Completely remove from accessibility and render tree in 120ms
      setTimeout(() => {
        banner.setAttribute('hidden', '');
        banner.classList.remove('is-hiding');
      }, 120);
    }

    acceptBtn.onclick = function (e) {
      e.preventDefault();
      handleChoice('accepted');
    };

    declineBtn.onclick = function (e) {
      e.preventDefault();
      handleChoice('declined');
    };

    // Fast reopen trigger from footer or cookie settings link
    window.addEventListener('cfn:open-cookie-banner', function () {
      banner.removeAttribute('hidden');
      banner.style.pointerEvents = 'auto';
      banner.classList.remove('is-hiding');
      requestAnimationFrame(() => {
        banner.classList.add('is-visible');
      });
    });
  })();
</script>
