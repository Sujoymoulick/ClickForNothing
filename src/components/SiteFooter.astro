---
import { getLocalizedPath, getLocaleFromUrl } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);

const homeUrl = getLocalizedPath('/', currentLocale);
const submitUrl = getLocalizedPath('/submit/', currentLocale);
const privacyUrl = getLocalizedPath('/privacy-policy/', currentLocale);
const termsUrl = getLocalizedPath('/terms-and-conditions/', currentLocale);
const currentYear = new Date().getFullYear();
---

<footer class="minimal-footer" role="contentinfo">
  <div class="footer-inner">
    <nav class="footer-nav" aria-label="Footer links">
      <a href={homeUrl} class="footer-brand-link">Click For Nothing</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href={submitUrl}>Submit a Website</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href={privacyUrl}>Privacy Policy</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href={termsUrl}>Terms</a>
    </nav>
    <div class="footer-copy">
      <span>&copy; {currentYear} ClickForNothing</span>
    </div>
  </div>
</footer>

<style>
  .minimal-footer {
    width: 100%;
    background: var(--bg, #faf9f6);
    border-top: 1px solid var(--border, #e6e5e0);
    padding: 24px 20px;
    margin-top: auto;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .footer-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    font-size: 0.85rem;
    color: var(--text-muted, #666666);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .footer-brand-link {
    font-weight: 600;
    color: var(--text, #1a1a1a);
    text-decoration: none;
  }

  .footer-nav a {
    color: var(--text-muted, #666666);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-nav a:hover {
    color: var(--text, #1a1a1a);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .sep {
    color: #b0afab;
    user-select: none;
  }

  .footer-copy {
    color: var(--text-dim, #888888);
    font-size: 0.82rem;
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
    }
    .footer-nav {
      justify-content: center;
    }
  }
</style>
