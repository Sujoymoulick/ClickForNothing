---
import LocaleSwitcher from './LocaleSwitcher.astro';
import { getLocalizedPath, getLocaleFromUrl } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';
import { Show, UserButton, SignInButton } from '@clerk/astro/components';

interface Props {
  activeNav?: string;
  showBack?: boolean;
  backHref?: string;
  backLabel?: string;
}

const { showBack = false, backHref, backLabel = 'Back' } = Astro.props;

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const homeUrl = getLocalizedPath('/', currentLocale);
const resolvedBackHref = backHref || homeUrl;
const dashboardUrl = getLocalizedPath('/dashboard/', currentLocale);
---

<header class="minimal-header" id="site-header">
  <div class="header-inner">
    <div class="header-left">
      {showBack ? (
        <a href={resolvedBackHref} class="back-link" aria-label="Go back">
          <span aria-hidden="true">&larr;</span> <span>{backLabel}</span>
        </a>
      ) : (
        <a href={homeUrl} class="brand-link">
          <span class="brand-dot" aria-hidden="true"></span>
          <span class="brand-name">Click For Nothing</span>
        </a>
      )}
    </div>

    <div class="header-right">
      <div class="header-locale">
        <LocaleSwitcher variant="hero" />
      </div>

      <div class="header-auth">
        <Show when="signed-in">
          <a href={dashboardUrl} class="header-dash-link">Dashboard</a>
          <UserButton />
        </Show>
        <Show when="signed-out">
          <SignInButton mode="modal" forceRedirectUrl={dashboardUrl} class="header-signin-btn">
            Sign In
          </SignInButton>
        </Show>
      </div>
    </div>
  </div>
</header>

<style>
  .minimal-header {
    width: 100%;
    background: var(--bg, #faf9f6);
    border-bottom: 1px solid var(--border, #e6e5e0);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    height: 52px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text, #1a1a1a);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: opacity 0.15s ease;
  }

  .brand-link:hover {
    opacity: 0.75;
  }

  .brand-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #1a1a1a;
  }

  .brand-name {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--text, #1a1a1a);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .back-link:hover {
    background: #f0efe9;
    border-color: var(--border, #e6e5e0);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .header-locale {
    display: flex;
    align-items: center;
    font-size: 0.85rem;
  }

  .header-auth {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header-dash-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: #444444;
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 4px;
    transition: color 0.15s ease;
  }

  .header-dash-link:hover {
    color: #000000;
  }

  .header-signin-btn {
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    color: #333333;
    background: transparent;
    border: 1px solid var(--border, #e6e5e0);
    padding: 4px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .header-signin-btn:hover {
    background: #ffffff;
    color: #000000;
    border-color: #bbbbba;
  }

  @media (max-width: 600px) {
    .header-inner {
      padding: 0 16px;
      height: 48px;
    }
  }
</style>
