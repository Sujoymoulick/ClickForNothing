---
import { useTranslations } from '../i18n';
import { getLocaleFromUrl } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

interface FAQItem {
  question: string;
  answer: string;
  id?: string;
}

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);

const faqs: FAQItem[] = [
  {
    id: "useless-websites-game",
    question: t('faq_section.q1'),
    answer: t('faq_section.a1')
  },
  {
    id: "useless-web-2",
    question: t('faq_section.q2'),
    answer: t('faq_section.a2')
  },
  {
    id: "staggering-beauty",
    question: t('faq_section.q3'),
    answer: t('faq_section.a3')
  },
  {
    id: "useless-web-unblocked",
    question: t('faq_section.q4'),
    answer: t('faq_section.a4')
  },
  {
    id: "useless-web-worm",
    question: t('faq_section.q5'),
    answer: t('faq_section.a5')
  },
  {
    id: "websites-like-useless-web",
    question: t('faq_section.q6'),
    answer: t('faq_section.a6')
  },
  {
    id: "is-useless-web-safe",
    question: t('faq_section.q7'),
    answer: t('faq_section.a7')
  },
  {
    id: "useless-web-all-websites",
    question: t('faq_section.q8'),
    answer: t('faq_section.a8')
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="faq-container" aria-labelledby="faq-main-heading">
  <div class="faq-header">
    <span class="faq-badge">{t('faq_section.badge')}</span>
    <h2 id="faq-main-heading">{t('faq_section.heading')}</h2>
    <p class="faq-intro">{t('faq_section.intro')}</p>
  </div>

  <div class="faq-grid">
    {faqs.map((faq) => (
      <details class="faq-card" id={faq.id}>
        <summary class="faq-question">
          <span class="q-title">{faq.question}</span>
          <span class="q-icon" aria-hidden="true">+</span>
        </summary>
        <div class="faq-answer">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .faq-container {
    max-width: 900px;
    margin: 40px auto;
    padding: 0 20px;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 36px;
  }

  .faq-badge {
    display: inline-block;
    background: #f20caf;
    color: #fff;
    font: 700 0.85rem/1 'Baloo 2', system-ui, sans-serif;
    padding: 6px 14px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .faq-header h2 {
    font: 800 clamp(1.8rem, 4vw, 2.5rem)/1.2 'Lilita One', system-ui, sans-serif;
    color: #17141a;
    margin: 0 0 12px 0;
  }

  .faq-intro {
    font: 500 1.05rem/1.6 'Baloo 2', system-ui, sans-serif;
    color: #4a4650;
    max-width: 680px;
    margin: 0 auto;
  }

  .faq-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-card {
    background: #ffffff;
    border: 2px solid #17141a;
    border-radius: 12px;
    box-shadow: 4px 4px 0px #17141a;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .faq-card[open] {
    box-shadow: 2px 2px 0px #17141a;
    background: #faf7ff;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    font: 700 1.15rem/1.4 'Baloo 2', system-ui, sans-serif;
    color: #17141a;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .q-title {
    flex: 1;
    padding-right: 16px;
  }

  .q-icon {
    font-size: 1.4rem;
    font-weight: 800;
    color: #7025ed;
    transition: transform 0.2s ease;
  }

  .faq-card[open] .q-icon {
    transform: rotate(45deg);
    color: #f20caf;
  }

  .faq-answer {
    padding: 0 24px 20px 24px;
    font: 500 1rem/1.65 'Baloo 2', system-ui, sans-serif;
    color: #333038;
    border-top: 1px dashed #e2d9f3;
    margin-top: 4px;
    padding-top: 16px;
  }

  .faq-answer p {
    margin: 0;
  }

  @media (max-width: 600px) {
    .faq-question {
      padding: 14px 18px;
      font-size: 1rem;
    }
    .faq-answer {
      padding: 0 18px 16px 18px;
      font-size: 0.95rem;
    }
  }
</style>
