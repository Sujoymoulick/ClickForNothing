---
import SiteFooter from '../components/SiteFooter.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/site.css';
import { getLocaleDirection, DEFAULT_LOCALE, type SupportedLocale } from '../i18n/config';
import { getAlternateLinks, getLocaleFromUrl, stripLocaleFromPath, getLocalizedPath } from '../i18n/routing';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  hideFooter?: boolean;
}

const {
  title = 'The Useless Web: Random Useless Websites | ClickForNothing',
  description = 'Discover the useless web with our random website generator! Explore 100+ funny and useless websites to pass time in office. Click now to start exploring!',
  canonicalPath,
  noindex = false,
  image = '/og-image.png',
  type = 'website',
  hideFooter = false,
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://clickfornothing.com';
const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const dir = getLocaleDirection(currentLocale);

// Localize pagePath for the current locale so canonical and alternate hreflangs match the page
const basePath = canonicalPath ? stripLocaleFromPath(canonicalPath) : stripLocaleFromPath(Astro.url.pathname);
const pagePath = getLocalizedPath(basePath, currentLocale);
const { canonicalUrl, alternates } = getAlternateLinks(pagePath, siteUrl);
const imageURL = new URL(image, siteUrl).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://clickfornothing.com/#organization',
  name: 'ClickForNothing',
  url: 'https://clickfornothing.com/',
  logo: 'https://clickfornothing.com/android-chrome-512x512.png',
  description: 'The premier destination to explore the useless web and discover funny, weird, and random websites.',
  sameAs: [],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://clickfornothing.com/#website',
  url: 'https://clickfornothing.com/',
  name: 'ClickForNothing',
  alternateName: ['The Useless Web', 'The Pointless Web', 'Random Useless Website Generator'],
  description: 'Discover the useless web and explore 100+ weird, funny, and wonderfully pointless websites on demand.',
  publisher: {
    '@id': 'https://clickfornothing.com/#organization',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://clickfornothing.com/search/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};
---
<!doctype html>
<html lang={currentLocale} dir={dir}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L9R73KX5CB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-L9R73KX5CB');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7fa27" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    {noindex ? (
      <>
        <meta name="robots" content="noindex, follow" />
        <meta name="googlebot" content="noindex, follow" />
      </>
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      </>
    )}

    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Standard Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Apple Touch Icon (iOS) -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="ClickForNothing" />

    <!-- Web App Manifest (Android / PWA) -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="ClickForNothing" />
    <meta property="og:locale" content={currentLocale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Lilita+One&family=Noto+Sans+Arabic:wght@500;700;800&display=swap" rel="stylesheet" />

    <!-- Global Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <slot />
    {!hideFooter && <SiteFooter />}
    <CookieBanner />
  </body>
</html>
