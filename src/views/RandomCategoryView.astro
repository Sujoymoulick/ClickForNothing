---
import SiteLayout from '../layouts/SiteLayout.astro';
import { type WebsiteCategory } from '../data/categories';
import { websites } from '../data/websites';
import { useTranslations } from '../i18n';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

interface Props {
  categoryObj: WebsiteCategory;
}

const { categoryObj } = Astro.props;
const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);

const catName = t(`categories.${categoryObj.slug}`) || categoryObj.name;
const categorySites = websites.filter(w => w.categorySlug === categoryObj.slug && w.verified && /^https:\/\//i.test(w.url));

const title = `Random ${catName} Generator | ClickForNothing`;
const description = `Instantly jump to a random useless website in ${catName}! Explore hilarious, weird, and interactive time-pass creations online today.`;
const categoryUrl = getLocalizedPath(`/categories/${categoryObj.slug}/`, currentLocale);
const discoverUrl = getLocalizedPath('/discover/', currentLocale);
---
<SiteLayout {title} {description} canonicalPath={`/random/${categoryObj.slug}/`}>
  <main class="random-landing-container">
    <div class="card-box">
      <span class="emoji">{categoryObj.emoji}</span>
      <h1>Redirecting to a Random {catName} Site...</h1>
      <p class="status-msg">Finding a verified website in {catName}.</p>
      <a href={categoryUrl} class="fallback-link">View all {catName} websites</a>
    </div>
  </main>

  <script is:inline set:html={`
    const sites = ${JSON.stringify(categorySites.map(w => w.url))};
    if (sites.length > 0) {
      const randomIndex = Math.floor(Math.random() * sites.length);
      const targetUrl = sites[randomIndex];
      window.location.replace(targetUrl);
    } else {
      window.location.replace('${discoverUrl}');
    }
  `} />
</SiteLayout>

<style>
  .random-landing-container {
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 20px;
    color: #fff;
    text-align: center;
  }
  .card-box {
    background: #18181b;
    border: 2px solid #a855f7;
    border-radius: 24px;
    padding: 48px 32px;
    max-width: 500px;
    width: 100%;
    box-shadow: 0 10px 0 #09080c;
  }
  .emoji { font-size: 4rem; display: block; margin-bottom: 16px; }
  .card-box h1 { font: 800 1.8rem/1.2 'Lilita One', system-ui, sans-serif; margin-bottom: 12px; color: #f7fa27; }
  .status-msg { color: #d4d4d8; font-size: 1rem; margin-bottom: 24px; }
  .fallback-link { color: #f20caf; font-weight: 700; font-size: 0.95rem; text-decoration: underline; text-underline-offset: 3px; }
</style>
