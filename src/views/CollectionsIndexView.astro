---
import SiteLayout from '../layouts/SiteLayout.astro';
import { collections } from '../data/collections';
import { useTranslations } from '../i18n';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);

const title = "Curated Collections of Useless Websites | ClickForNothing";
const description = "Explore curated lists of useless websites: 100 Useless Websites, Websites to Visit When Bored, and weird internet creations to kill boredom online.";
const canonicalPath = "/collections/";

const siteOrigin = (Astro.site?.href || 'https://clickfornothing.com/').replace(/\/$/, '');
const currentPath = getLocalizedPath(canonicalPath, currentLocale);
const fullCanonicalUrl = `${siteOrigin}${currentPath}`;
const homeUrl = getLocalizedPath('/', currentLocale);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home') || 'Home', item: `${siteOrigin}${homeUrl}` },
    { '@type': 'ListItem', position: 2, name: t('nav.collections') || 'Collections', item: fullCanonicalUrl },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Curated Collections of Useless Websites',
  description,
  url: fullCanonicalUrl,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: collections.length,
    itemListElement: collections.map((col, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: col.title,
      url: `${siteOrigin}${getLocalizedPath(`/collections/${col.slug}/`, currentLocale)}`,
    })),
  },
};
---
<SiteLayout {title} {description} {canonicalPath}>
  <main class="collections-container">
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href={homeUrl}>{t('nav.home') || 'Home'}</a> <span>/</span> <span aria-current="page">{t('nav.collections') || 'Collections'}</span>
    </nav>

    <header class="header-section">
      <h1>Curated Collections & Listicles</h1>
      <p class="lead">
        Hand-curated collections of internet time-wasters, weird sites, and useless gems.
      </p>
    </header>

    <section class="collections-grid">
      {collections.map((col) => (
        <article class="collection-card">
          <div class="card-badge">Listicle • {col.siteIds.length} Items</div>
          <h2><a href={getLocalizedPath(`/collections/${col.slug}/`, currentLocale)}>{col.title}</a></h2>
          <p class="subtitle">{col.subtitle}</p>
          <p class="desc">{col.description}</p>
          <a href={getLocalizedPath(`/collections/${col.slug}/`, currentLocale)} class="view-collection-btn">Explore Full List →</a>
        </article>
      ))}
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</SiteLayout>

<style>
  .collections-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 20px 64px;
    color: #f4f4f5;
  }
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: #a1a1aa;
    margin-bottom: 16px;
  }
  .breadcrumbs a { color: #f7fa27; text-decoration: none; }

  .header-section h1 {
    font: 800 clamp(2rem, 4vw, 3rem)/1.1 'Lilita One', system-ui, sans-serif;
    color: #ffffff;
    margin-bottom: 10px;
  }
  .lead {
    font: 500 1.15rem/1.5 'Baloo 2', system-ui, sans-serif;
    color: #d4d4d8;
    margin-bottom: 36px;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .collection-card {
    background: #18181b;
    border: 2px solid #27272a;
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .collection-card:hover {
    transform: translateY(-4px);
    border-color: #7025ed;
  }

  .card-badge {
    color: #f20caf;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .collection-card h2 {
    font: 700 1.4rem/1.2 'Lilita One', system-ui, sans-serif;
    margin: 0 0 8px 0;
  }
  .collection-card h2 a {
    color: #ffffff;
    text-decoration: none;
  }
  .collection-card h2 a:hover {
    color: #f7fa27;
  }

  .subtitle {
    font: 600 0.95rem/1.4 'Baloo 2', system-ui, sans-serif;
    color: #d4d4d8;
    margin-bottom: 10px;
  }
  .desc {
    color: #a1a1aa;
    font-size: 0.92rem;
    line-height: 1.5;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .view-collection-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #7025ed;
    color: #ffffff;
    font: 700 0.95rem/1 'Baloo 2', system-ui, sans-serif;
    padding: 12px 18px;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .view-collection-btn:hover {
    background: #5b18cf;
  }
</style>
