---
import SiteLayout from '../layouts/SiteLayout.astro';
import TopBar from '../components/TopBar.astro';
import { websites } from '../data/websites';

const title = 'Explore Useless Websites — ClickForNothing';
const description = 'A slow, endless wall of useless websites. Hover to pause. Click to open.';
const seed = websites.map((s) => ({ name: s.name, url: s.url, description: s.description }));
---

<SiteLayout {title} {description} canonicalPath="/explore/" hideFooter>
  <TopBar />
  <main class="wall" id="wall" aria-label="Useless websites"></main>
  <script id="wall-seed" type="application/json" set:html={JSON.stringify(seed)} />
</SiteLayout>

<style>
  :global(html), :global(body) { height: 100%; overflow: hidden; }
  .wall {
    position: fixed;
    inset: 0;
    display: flex;
    gap: 16px;
    padding: 0 16px;
    background: #f7f6f3;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 90px, #000 calc(100% - 60px), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 90px, #000 calc(100% - 60px), transparent 100%);
  }
  :global(.col) { flex: 1 1 0; min-width: 0; overflow: hidden; }
  :global(.track) {
    display: flex;
    flex-direction: column;
    gap: 16px;
    animation: fall var(--dur, 90s) linear infinite;
  }
  :global(.col:hover .track) { animation-play-state: paused; }
  @keyframes fall {
    from { transform: translateY(calc(-50% - 8px)); }
    to { transform: translateY(0); }
  }
  :global(.card) {
    display: block;
    padding: 16px;
    background: #fff;
    border: 1px solid #e6e5e0;
    border-radius: 12px;
    color: #111;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  :global(.card:hover) { border-color: #111; transform: translateY(-2px); }
  :global(.card b) { display: block; font-size: 15px; font-weight: 600; margin-bottom: 6px; }
  :global(.card p) { margin: 0 0 10px; font-size: 13px; line-height: 1.5; color: #666; }
  :global(.card small) { font-size: 11.5px; color: #aaa; }
  @media (max-width: 640px) {
    .wall { gap: 10px; padding: 0 10px; }
    :global(.track) { gap: 10px; }
    :global(.card) { padding: 12px; border-radius: 10px; }
    :global(.card b) { font-size: 13.5px; margin-bottom: 4px; }
    :global(.card p) { font-size: 12px; line-height: 1.4; margin-bottom: 6px; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
    :global(.card small) { font-size: 10.5px; overflow-wrap: anywhere; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.track) { animation-duration: 400s; }
  }
</style>

<script>
  type Site = { name: string; url: string; description?: string };

  const shuffle = <T,>(a: T[]) => {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  };
  const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };

  function card(s: Site) {
    const a = document.createElement('a');
    a.className = 'card';
    a.href = s.url;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    const b = document.createElement('b');
    b.textContent = s.name;
    const p = document.createElement('p');
    p.textContent = s.description || '';
    const sm = document.createElement('small');
    sm.textContent = host(s.url);
    a.append(b, p, sm);
    return a;
  }

  async function build() {
    const wall = document.getElementById('wall');
    if (!wall || wall.dataset.ready) return;
    wall.dataset.ready = '1';

    let seed: Site[] = [];
    try { seed = JSON.parse(document.getElementById('wall-seed')?.textContent || '[]'); } catch {}
    let live: Site[] = [];
    try {
      const res = await fetch('/api/published?limit=200');
      if (res.ok) live = ((await res.json()).sites || []).filter((s: Site) => s.name && s.url);
    } catch {}

    const seen = new Set<string>();
    const sites = shuffle([...live, ...seed]).filter((s) => {
      const k = s.url.toLowerCase();
      return seen.has(k) ? false : (seen.add(k), true);
    });

    render(wall, sites);
    let lastCols = colCount(wall.clientWidth);
    window.addEventListener('resize', () => {
      const n = colCount(wall.clientWidth);
      if (n !== lastCols) { lastCols = n; render(wall, sites); }
    });
  }

  const colCount = (w: number) => (w < 640 ? 2 : Math.max(2, Math.min(6, Math.floor(w / 280))));

  function render(wall: HTMLElement, sites: Site[]) {
    wall.replaceChildren();
    const cols = colCount(wall.clientWidth);
    const buckets: Site[][] = Array.from({ length: cols }, () => []);
    sites.forEach((s, i) => buckets[i % cols].push(s));

    buckets.forEach((list, i) => {
      while (list.length && list.length < 8) list.push(...list.slice(0, 8 - list.length));
      const col = document.createElement('div');
      col.className = 'col';
      const track = document.createElement('div');
      track.className = 'track';
      track.style.setProperty('--dur', `${list.length * (9 + (i % 3) * 2)}s`);
      track.style.animationDelay = `-${Math.random() * 30}s`;
      [...list, ...list].forEach((s) => track.appendChild(card(s)));
      col.appendChild(track);
      wall.appendChild(col);
    });
  }

  build();
  document.addEventListener('astro:page-load', build);
</script>
