---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { categories } from '../data/categories.ts';
import { useTranslations } from '../i18n';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';
import { UserButton, SignInButton, SignUpButton } from '@clerk/astro/components';

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);

const title = "Submit Something Completely Useless | ClickForNothing";
const description = "Found a website nobody asked for? Perfect. Submit your favorite useless, weird, pointless, and hilarious websites to ClickForNothing.";

const homeUrl = getLocalizedPath('/', currentLocale);
const discoverUrl = getLocalizedPath('/discover/', currentLocale);
const randomUrl = getLocalizedPath('/random/', currentLocale);
const sitesUrl = getLocalizedPath('/sites/', currentLocale);
const aboutUrl = getLocalizedPath('/about/', currentLocale);
const dashboardUrl = getLocalizedPath('/dashboard/', currentLocale);
---

<SiteLayout {title} {description} canonicalPath="/submit/">
  <!-- Top Navigation Bar -->
  <SiteHeader activeNav="submit" />

  <div class="submit-page-body">
    <!-- Hero Section -->
    <section class="submit-hero" aria-labelledby="hero-heading">
      <!-- Background Decorative Decals -->
      <div class="hero-deco checker-corner checker-top-left" aria-hidden="true"></div>
      <div class="hero-deco checker-corner checker-bottom-right" aria-hidden="true"></div>
      <span class="hero-deco hero-burst burst-1" aria-hidden="true">✹</span>
      <span class="hero-deco hero-burst burst-2" aria-hidden="true">✦</span>
      <span class="hero-deco hero-squiggle squiggle-1" aria-hidden="true">〰</span>
      <span class="hero-deco hero-squiggle squiggle-2" aria-hidden="true">〰</span>
      <span class="hero-deco hero-dot dot-1" aria-hidden="true"></span>
      <span class="hero-deco hero-dot dot-2" aria-hidden="true"></span>

      <!-- Retro Monitor Sticker (Center Right) -->
      <div class="sticker sticker-computer" aria-hidden="true">
        <div class="monitor-screen">
          <div class="monitor-inner-face">
            <span class="pixel-eyes">■ ■</span>
            <span class="pixel-smile">‿</span>
          </div>
        </div>
        <div class="sticker-ribbon">
          USELESS WEBSITES FOREVER ✓
        </div>
      </div>

      <!-- Browser Window Sticker (Right) -->
      <div class="sticker sticker-browser" aria-hidden="true">
        <div class="browser-header-dots">
          <span class="b-dot b-red"></span>
          <span class="b-dot b-yellow"></span>
          <span class="b-dot b-green"></span>
        </div>
        <p class="browser-quote">
          this website serves no purpose and that's perfect.
        </p>
        <span class="sticker-cursor" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" stroke="#09080c" stroke-width="2">
            <path d="m3 3 7 18 3-7 7-3L3 3z"/>
          </svg>
        </span>
      </div>

      <!-- Pixel Saturn Planet (Top Right) -->
      <div class="sticker sticker-planet" aria-hidden="true">
        <svg width="56" height="42" viewBox="0 0 64 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="32" cy="24" rx="16" ry="16" fill="#7025ed"/>
          <ellipse cx="32" cy="24" rx="28" ry="7" stroke="#f20caf" stroke-width="3" transform="rotate(-15 32 24)"/>
        </svg>
      </div>

      <div class="hero-content-wrapper">
        <!-- Community Badge Pill -->
        <div class="community-badge-pill">
          <span class="badge-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f20caf" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m22 2-7 20-4-9-9-4Z"/>
              <path d="M22 2 11 13"/>
            </svg>
          </span>
          <span class="badge-text">COMMUNITY SUBMISSIONS</span>
        </div>

        <!-- Handwritten Doodle Note -->
        <div class="hero-doodle-note" aria-hidden="true">
          <span>we love useless websites</span>
          <svg width="34" height="26" viewBox="0 0 40 30" fill="none">
            <path d="M4 6 C 14 18, 22 24, 34 18" stroke="#09080c" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M28 22 L 35 18 L 32 10" stroke="#09080c" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
          <span class="doodle-heart">♥</span>
        </div>

        <!-- Headline -->
        <h1 class="hero-title" id="hero-heading">
          Submit Something<br />
          <span class="title-highlight">Completely Useless.</span>
        </h1>

        <!-- Supporting text -->
        <p class="hero-subtitle">
          Found a website nobody asked for? Perfect. Send it our way.
        </p>
      </div>
    </section>

    <!-- Main Content Container -->
    <main class="submit-main-wrapper" id="submit-main">
      <div class="submit-grid-layout">
        <!-- LEFT COLUMN: The Submission Form -->
        <div class="grid-col-left">
          <section class="submission-form-card" aria-labelledby="form-card-title">
            <div class="card-header">
              <div class="header-icon-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m22 2-7 20-4-9-9-4Z"/>
                  <path d="M22 2 11 13"/>
                </svg>
              </div>
              <div>
                <h2 class="card-title" id="form-card-title">Submit a Useless Website</h2>
                <p class="card-subtitle">Share a weird, pointless, or completely unnecessary website with the community.</p>
              </div>
            </div>

            <!-- Sign-in prompt banner for signed-out users -->
            <div class="signed-out-form-notice" id="signed-out-form-notice">
              <span class="notice-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </span>
              <p>Sign in using the panel to the right to submit your website.</p>
              <button type="button" class="mini-sign-in-btn" id="mini-sign-in-trigger">
                Sign In
              </button>
            </div>

            <!-- Submission Form -->
            <form class="main-submission-form" id="site-submit-form" novalidate>
              <!-- Field 1: Website URL -->
              <div class="form-field-group">
                <label for="website-url">Website URL <span class="required-asterisk">*</span></label>
                <div class="input-with-icon">
                  <span class="field-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </svg>
                  </span>
                  <input
                    type="url"
                    id="website-url"
                    name="url"
                    placeholder="https://example.com"
                    autocomplete="url"
                    required
                  />
                </div>
                <div class="field-hint" id="hint-url">Must be a valid, accessible URL.</div>
                <div class="field-error-msg" id="err-url" role="alert" aria-live="polite"></div>
              </div>

              <!-- Field 2: Website Name -->
              <div class="form-field-group">
                <label for="website-name">Website Name <span class="required-asterisk">*</span></label>
                <div class="input-with-icon">
                  <span class="field-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="4 7 4 4 20 4 20 7"/>
                      <line x1="9" x2="15" y1="20" y2="20"/>
                      <line x1="12" x2="12" y1="4" y2="20"/>
                    </svg>
                  </span>
                  <input
                    type="text"
                    id="website-name"
                    name="name"
                    placeholder="Example Useless Website"
                    maxlength="80"
                    required
                  />
                </div>
                <div class="field-hint" id="hint-name">A short, catchy name for the website.</div>
                <div class="field-error-msg" id="err-name" role="alert" aria-live="polite"></div>
              </div>

              <!-- Field 3: Short Description -->
              <div class="form-field-group">
                <div class="label-with-counter">
                  <label for="website-description">Short Description <span class="required-asterisk">*</span></label>
                  <span class="char-counter" id="desc-char-counter">0/300</span>
                </div>
                <div class="input-with-icon textarea-wrap">
                  <span class="field-icon textarea-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                      <line x1="16" x2="8" y1="13" y2="13"/>
                      <line x1="16" x2="8" y1="17" y2="17"/>
                      <polyline points="10 9 9 9 8 9"/>
                    </svg>
                  </span>
                  <textarea
                    id="website-description"
                    name="description"
                    rows="3"
                    maxlength="300"
                    placeholder="Explain why this website deserves to exist..."
                    required
                  ></textarea>
                </div>
                <div class="field-hint" id="hint-desc">Tell us what makes this website useless, weird, or interesting.</div>
                <div class="field-error-msg" id="err-desc" role="alert" aria-live="polite"></div>
              </div>

              <!-- Field 4: Category -->
              <div class="form-field-group">
                <label for="website-category">Category <span class="required-asterisk">*</span></label>
                <div class="input-with-icon select-wrap">
                  <span class="field-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/>
                      <circle cx="7" cy="7" r="1.5" fill="currentColor"/>
                    </svg>
                  </span>
                  <select id="website-category" name="category" required>
                    <option value="">Select a category</option>
                    {categories.map((cat) => (
                      <option value={cat.slug}>{cat.name}</option>
                    ))}
                  </select>
                  <span class="select-chevron" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m6 9 6 6 6-6"/>
                    </svg>
                  </span>
                </div>
                <div class="field-hint" id="hint-cat">Choose the best category for this website.</div>
                <div class="field-error-msg" id="err-cat" role="alert" aria-live="polite"></div>
              </div>

              <!-- Form Buttons -->
              <div class="form-actions-row">
                <button type="submit" class="primary-submit-btn" id="submit-form-btn">
                  <span class="btn-spinner" id="btn-spinner" aria-hidden="true"></span>
                  <span class="btn-send-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m22 2-7 20-4-9-9-4Z"/>
                      <path d="M22 2 11 13"/>
                    </svg>
                  </span>
                  <span class="btn-text" id="btn-text">Submit to the Useless Web</span>
                  <span class="btn-arrow" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14"/>
                      <path d="m12 5 7 7-7 7"/>
                    </svg>
                  </span>
                </button>

                <a href={discoverUrl} class="secondary-explore-btn">
                  <span class="btn-explore-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="18" x="3" y="3" rx="3" ry="3"/>
                      <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/>
                      <circle cx="15.5" cy="8.5" r="1.5" fill="currentColor"/>
                      <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                      <circle cx="8.5" cy="15.5" r="1.5" fill="currentColor"/>
                      <circle cx="15.5" cy="15.5" r="1.5" fill="currentColor"/>
                    </svg>
                  </span>
                  <span>Explore Random Sites</span>
                </a>
              </div>
            </form>

            <!-- Success State Message Card -->
            <div class="submission-success-card" id="submission-success" style="display: none;">
              <div class="success-icon-wrap" aria-hidden="true">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
              </div>
              <h3 class="success-title">Submission Received!</h3>
              <p class="success-description" id="success-detail-text">
                Thank you for submitting your site! Our team will review it shortly before publishing to the directory.
              </p>
              <div class="success-actions">
                <button type="button" class="primary-submit-btn compact" id="submit-another-btn">
                  <span>Submit Another Site</span>
                </button>
                <a href={discoverUrl} class="secondary-explore-btn compact">
                  <span>Explore Random Sites</span>
                </a>
              </div>
            </div>
          </section>
        </div>

        <!-- RIGHT COLUMN: Stack of 3 Cards matching the Reference Screenshot -->
        <div class="grid-col-right">
          <!-- CARD 1: User Profile / Auth Status Panel -->
          <div class="sidebar-card user-auth-card">
            <!-- Signed In State View -->
            <div class="auth-state-box" id="signed-in-view" style="display: none;">
              <div class="user-status-card-inner">
                <div class="user-avatar-badge">
                  <UserButton />
                </div>
                <div class="user-text-meta">
                  <div class="user-online-badge">
                    <span class="status-pulse-dot" aria-hidden="true"></span>
                    <span>Logged In</span>
                  </div>
                  <h3 class="user-name-title" id="auth-user-display-name">Community Explorer</h3>
                  <p class="user-subtext">Verified Submitter • Submissions Active</p>
                </div>
                <div class="user-crown-icon" aria-hidden="true">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"/>
                  </svg>
                </div>
              </div>
              <div class="signed-in-callout">
                <span class="callout-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                </span>
                <p>You're ready to submit! Fill out the details on the left to add your favorite useless site to the directory.</p>
              </div>

              <div class="sidebar-dash-cta">
                <a href={dashboardUrl} class="sidebar-dash-btn">
                  <span>View My Submissions (Dashboard) →</span>
                </a>
              </div>
            </div>

            <!-- Signed Out State View -->
            <div class="auth-state-box" id="signed-out-view">
              <div class="auth-header">
                <div class="auth-lock-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7025ed" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                </div>
                <div>
                  <h3 class="auth-title">Sign in to submit</h3>
                  <p class="auth-subtitle">Join our community of web explorers and submit your own useless websites.</p>
                </div>
              </div>

              <!-- Primary Google Login Action -->
              <div class="auth-primary-action">
                <SignInButton mode="modal" class="clerk-auth-btn google-btn" id="google-signin-btn">
                  <svg class="google-logo" viewBox="0 0 24 24" width="20" height="20">
                    <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17Z"/>
                    <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.34 24 12 24Z"/>
                    <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.14-1.55.38-2.27V6.58H1.25C.45 8.17 0 9.97 0 12s.45 3.83 1.25 5.42l4.03-3.15Z"/>
                    <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98Z"/>
                  </svg>
                  <span>Continue with Google</span>
                </SignInButton>
              </div>

              <!-- Divider -->
              <div class="auth-divider">
                <span>or</span>
              </div>

              <!-- Secondary Sign In Actions -->
              <div class="auth-secondary-actions">
                <SignInButton mode="modal" class="clerk-pill-btn" aria-label="Sign in with GitHub">
                  <span class="pill-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                  </span>
                  <span class="pill-label">Continue with GitHub</span>
                </SignInButton>

                <SignInButton mode="modal" class="clerk-pill-btn" aria-label="Sign in with Email">
                  <span class="pill-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="20" height="16" x="2" y="4" rx="2"/>
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                    </svg>
                  </span>
                  <span class="pill-label">Continue with Email</span>
                </SignInButton>

                <SignUpButton mode="modal" class="clerk-pill-btn" aria-label="Create an Account">
                  <span class="pill-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                      <circle cx="12" cy="7" r="4"/>
                    </svg>
                  </span>
                  <span class="pill-label">Create an Account</span>
                </SignUpButton>
              </div>

              <div class="auth-card-footer">
                <span>Already have an account?</span>
                <SignInButton mode="modal" class="text-link-btn">
                  <span>Sign in</span>
                </SignInButton>
              </div>
            </div>
          </div>

          <!-- CARD 2: Community Showcase Stats -->
          <div class="sidebar-card community-stats-card">
            <div class="stats-card-header">
              <div class="stats-header-left">
                <span class="stats-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" x2="18" y1="20" y2="10"/>
                    <line x1="12" x2="12" y1="20" y2="4"/>
                    <line x1="6" x2="6" y1="20" y2="14"/>
                  </svg>
                </span>
                <h3 class="stats-title">Join a growing collection of useless websites.</h3>
              </div>
              <span class="stats-slashes" aria-hidden="true">///</span>
            </div>

            <div class="stats-badges-grid">
              <div class="stat-pill-box">
                <span class="stat-svg-wrap text-red" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
                    <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
                    <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
                    <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
                  </svg>
                </span>
                <span class="stat-num">10K+</span>
                <span class="stat-desc">Useless Sites</span>
              </div>

              <div class="stat-pill-box">
                <span class="stat-svg-wrap text-blue" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                </span>
                <span class="stat-num">5K+</span>
                <span class="stat-desc">Community Members</span>
              </div>

              <div class="stat-pill-box">
                <span class="stat-svg-wrap text-gold" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                </span>
                <span class="stat-num">100%</span>
                <span class="stat-desc">Pointless Fun</span>
              </div>
