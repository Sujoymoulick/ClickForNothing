              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- BOTTOM SPLIT GRID: GUIDELINES & CTA -->
      <div class="bottom-split-grid">
        <!-- Left: Submission Guidelines -->
        <section class="bottom-card guidelines-card" aria-labelledby="guidelines-title">
          <div class="bottom-card-header">
            <span class="b-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7025ed" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
