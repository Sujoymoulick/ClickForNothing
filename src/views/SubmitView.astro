</SiteLayout>

<script>
  import { $authStore, $userStore } from '@clerk/astro/client';

  function initSubmitRedesign() {
    const signedOutView = document.getElementById('signed-out-view');
    const signedInView = document.getElementById('signed-in-view');
    const userDisplayName = document.getElementById('auth-user-display-name');
    const signedOutNotice = document.getElementById('signed-out-form-notice');
    const form = document.getElementById('site-submit-form') as HTMLFormElement | null;
    const formBtn = document.getElementById('submit-form-btn') as HTMLButtonElement | null;
    const btnSpinner = document.getElementById('btn-spinner');
    const btnText = document.getElementById('btn-text');
    const successCard = document.getElementById('submission-success');
    const successDetail = document.getElementById('success-detail-text');
    const submitAnotherBtn = document.getElementById('submit-another-btn');
    const miniSignInBtn = document.getElementById('mini-sign-in-trigger');

    // Form inputs
    const urlInput = document.getElementById('website-url') as HTMLInputElement | null;
    const nameInput = document.getElementById('website-name') as HTMLInputElement | null;
    const descInput = document.getElementById('website-description') as HTMLTextAreaElement | null;
    const catSelect = document.getElementById('website-category') as HTMLSelectElement | null;
    const charCounter = document.getElementById('desc-char-counter');

    // Error message elements
    const errUrl = document.getElementById('err-url');
    const errName = document.getElementById('err-name');
    const errDesc = document.getElementById('err-desc');
    const errCat = document.getElementById('err-cat');

    // 1. Reactive Auth State Manager
    function updateAuthStatus() {
      const state = $authStore.get();
      const user = $userStore.get();
      const isLoggedIn = Boolean(state?.userId);

      if (isLoggedIn) {
        if (signedOutView) signedOutView.style.display = 'none';
        if (signedInView) signedInView.style.display = 'block';
        if (signedOutNotice) signedOutNotice.style.display = 'none';

        if (userDisplayName && user) {
          const name = user.username || user.firstName || (user.primaryEmailAddress ? user.primaryEmailAddress.emailAddress.split('@')[0] : 'Community Explorer');
          userDisplayName.textContent = name;
        }
      } else {
        if (signedOutView) signedOutView.style.display = 'block';
        if (signedInView) signedInView.style.display = 'none';
        if (signedOutNotice) signedOutNotice.style.display = 'flex';
      }
    }

    $authStore.subscribe(updateAuthStatus);
    $userStore.subscribe(updateAuthStatus);
    updateAuthStatus();

    // 2. Character Counter on Description Textarea
    if (descInput && charCounter) {
      const updateCounter = () => {
        const count = descInput.value.length;
        charCounter.textContent = `${count}/300`;
        if (count >= 280) {
          charCounter.classList.add('near-limit');
        } else {
          charCounter.classList.remove('near-limit');
        }
      };
      descInput.addEventListener('input', updateCounter);
      updateCounter();
    }

    // Mini Sign In Banner click triggers Clerk modal
    if (miniSignInBtn) {
      miniSignInBtn.addEventListener('click', () => {
        if (window.Clerk) {
          window.Clerk.openSignIn();
        }
      });
    }

    // Clear field errors on input
    const inputsToClear = [
      { el: urlInput, err: errUrl },
      { el: nameInput, err: errName },
      { el: descInput, err: errDesc },
      { el: catSelect, err: errCat },
    ];

    inputsToClear.forEach(({ el, err }) => {
      if (el && err) {
        el.addEventListener('input', () => {
          err.textContent = '';
          el.removeAttribute('aria-invalid');
        });
        el.addEventListener('change', () => {
          err.textContent = '';
          el.removeAttribute('aria-invalid');
        });
      }
    });

    // 3. Form Validation & Submission
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const state = $authStore.get();
        if (!state?.userId) {
          if (window.Clerk) {
            window.Clerk.openSignIn();
          }
          return;
        }

        let hasError = false;

        // URL Validation
        const urlVal = urlInput?.value.trim() || '';
        let isValidUrl = false;
        try {
          const parsed = new URL(urlVal);
          isValidUrl = parsed.protocol === 'http:' || parsed.protocol === 'https:';
        } catch {
          isValidUrl = false;
        }

        if (!urlVal) {
          if (errUrl) errUrl.textContent = 'Please enter a website URL.';
          urlInput?.setAttribute('aria-invalid', 'true');
          hasError = true;
        } else if (!isValidUrl) {
          if (errUrl) errUrl.textContent = 'Please enter a valid website URL (starting with https:// or http://).';
          urlInput?.setAttribute('aria-invalid', 'true');
          hasError = true;
        } else {
          if (errUrl) errUrl.textContent = '';
          urlInput?.removeAttribute('aria-invalid');
        }

        // Name Validation
        const nameVal = nameInput?.value.trim() || '';
        if (!nameVal || nameVal.length < 2) {
          if (errName) errName.textContent = 'Please enter a website name (at least 2 characters).';
          nameInput?.setAttribute('aria-invalid', 'true');
          hasError = true;
        } else {
          if (errName) errName.textContent = '';
          nameInput?.removeAttribute('aria-invalid');
        }

        // Description Validation
        const descVal = descInput?.value.trim() || '';
        if (!descVal || descVal.length < 10) {
          if (errDesc) errDesc.textContent = 'Please explain in at least 10 characters why this website deserves to exist.';
          descInput?.setAttribute('aria-invalid', 'true');
          hasError = true;
        } else {
          if (errDesc) errDesc.textContent = '';
          descInput?.removeAttribute('aria-invalid');
        }

        // Category Validation
        const catVal = catSelect?.value || '';
        if (!catVal) {
          if (errCat) errCat.textContent = 'Please choose a category.';
          catSelect?.setAttribute('aria-invalid', 'true');
          hasError = true;
        } else {
          if (errCat) errCat.textContent = '';
          catSelect?.removeAttribute('aria-invalid');
        }

        if (hasError) {
          const firstInvalid = form.querySelector('[aria-invalid="true"]') as HTMLElement | null;
          firstInvalid?.focus();
          return;
        }

        // Loading state
        if (formBtn) formBtn.disabled = true;
        if (btnSpinner) btnSpinner.style.display = 'inline-block';
        if (btnText) btnText.textContent = 'Submitting to database...';

        const user = $userStore.get();
        const payload = {
          url: urlVal,
          name: nameVal,
          description: descVal,
          category: catVal,
          user_id: state?.userId || null,
          user_email: user?.primaryEmailAddress?.emailAddress || null,
          user_name: user?.username || user?.firstName || null,
        };

        // Modal handlers
        const confirmModal = document.getElementById('submission-confirm-modal');
        const confirmCloseBtn = document.getElementById('confirm-close-btn');
        const confirmModalCloseBtn = document.getElementById('confirm-modal-close-btn');

        if (confirmCloseBtn && confirmModal) {
          confirmCloseBtn.addEventListener('click', () => { confirmModal.style.display = 'none'; });
        }
        if (confirmModalCloseBtn && confirmModal) {
          confirmModalCloseBtn.addEventListener('click', () => { confirmModal.style.display = 'none'; });
        }
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && confirmModal) {
            confirmModal.style.display = 'none';
          }
        });

        // Get authenticated Clerk session token
        (async () => {
          try {
            let token: string | null = null;
            if (window.Clerk && window.Clerk.session) {
              try {
                token = await window.Clerk.session.getToken();
              } catch (e) {
                console.warn('Could not retrieve Clerk token:', e);
              }
            }

            const headers: Record<string, string> = { 'Content-Type': 'application/json' };
            if (token) {
              headers['Authorization'] = `Bearer ${token}`;
            }

            const res = await fetch('/api/submit', {
              method: 'POST',
              headers,
              credentials: 'include',
              body: JSON.stringify(payload),
            });

            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              throw new Error(data.error || 'Failed to save submission to database.');
            }

            form.style.display = 'none';
            if (signedOutNotice) signedOutNotice.style.display = 'none';
            if (successCard) successCard.style.display = 'block';

            if (successDetail) {
              successDetail.textContent = `Thank you for submitting "${nameVal}"! Your website was saved to our Neon database and our team will review it shortly.`;
            }

            // Show Confirmation Popup Modal (Requirement 3 & 12)
            if (confirmModal) {
              confirmModal.style.display = 'flex';
            }

            form.reset();
            if (charCounter) charCounter.textContent = '0/300';
          } catch (err: any) {
            console.error('Submission error:', err);
            if (errDesc) {
              errDesc.textContent = err?.message || 'Submission failed. Please check your details and try again.';
            }
          } finally {
            if (formBtn) formBtn.disabled = false;
            if (btnSpinner) btnSpinner.style.display = 'none';
            if (btnText) btnText.textContent = 'Submit to the Useless Web';
          }
        })();
      });
    }

    if (submitAnotherBtn && form && successCard) {
      submitAnotherBtn.addEventListener('click', () => {
        successCard.style.display = 'none';
        form.style.display = 'flex';
        updateAuthStatus();
        urlInput?.focus();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSubmitRedesign);
  } else {
    initSubmitRedesign();
  }
  document.addEventListener('astro:page-load', initSubmitRedesign);
</script>

<style>
  :root {
    --ink: #09080c;
    --lime: #f7fa27;
    --pink: #f20caf;
    --purple: #7025ed;
    --cyan: #19e8c5;
    --page-bg: #fff9df;
  }

  .submit-page-body {
    background: #fbfbfa;
    color: var(--ink);
    font-family: 'Baloo 2', system-ui, sans-serif;
    min-height: calc(100vh - 70px);
    overflow-x: hidden;
  }

  /* =========================================
     HERO SECTION
     ========================================= */
  .submit-hero {
    position: relative;
    background: radial-gradient(ellipse at 50% 48%, #fff86a 0%, #f7fa27 70%, #edf125 100%);
    border-bottom: 3.5px solid var(--ink);
    padding: clamp(48px, 6vw, 76px) 20px clamp(44px, 5vw, 68px);
    overflow: hidden;
    color: var(--ink);
    text-align: center;
  }

  /* Decorative Decals */
  .hero-deco {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 1;
  }

  .checker-corner {
    width: clamp(140px, 18vw, 240px);
    height: clamp(100px, 14vw, 180px);
    background: conic-gradient(var(--ink) 25%, #ffffff 0 50%, var(--ink) 0 75%, #ffffff 0);
    background-size: 40px 40px;
    opacity: 0.95;
  }

  .checker-top-left {
    top: -20px;
    left: -20px;
    clip-path: ellipse(80% 65% at 20% 20%);
    transform: rotate(-6deg);
  }

  .checker-bottom-right {
    bottom: -20px;
    right: -20px;
    clip-path: ellipse(80% 65% at 80% 80%);
    transform: rotate(-8deg);
  }

  .hero-burst {
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 1;
    font-family: system-ui, sans-serif;
    animation: floatBob 4s ease-in-out infinite;
  }
  .burst-1 { top: 14%; left: 14%; color: var(--pink); animation-delay: 0.3s; }
  .burst-2 { bottom: 18%; right: 14%; color: var(--purple); animation-delay: 1.2s; }

  .hero-squiggle {
    font-size: clamp(4rem, 7vw, 7.5rem);
    font-weight: 800;
    line-height: 0.5;
  }
  .squiggle-1 { bottom: 18%; left: 8%; color: var(--pink); transform: rotate(-25deg); }
  .squiggle-2 { top: 14%; right: 10%; color: var(--purple); transform: rotate(-30deg); }

  .hero-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
  }
  .dot-1 { top: 28%; left: 4%; background: var(--cyan); }
  .dot-2 { bottom: 25%; right: 5%; background: var(--pink); }

  @keyframes floatBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }

  /* Stickers */
  .sticker {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    user-select: none;
  }

  .sticker-computer {
    right: clamp(180px, 22vw, 300px);
    top: 50%;
    transform: translateY(-50%) rotate(3deg);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .monitor-screen {
    width: 140px;
    height: 110px;
    background: #ffffff;
    border: 4px solid var(--ink);
    border-radius: 24px;
    box-shadow: 6px 6px 0 var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .monitor-inner-face {
    width: 105px;
    height: 75px;
    background: #09080c;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .pixel-eyes {
    color: var(--pink);
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: 6px;
    text-shadow: 0 0 6px var(--pink);
  }

  .pixel-smile {
    color: var(--pink);
    font-size: 1.4rem;
    font-weight: 900;
    line-height: 0.8;
  }

  .sticker-ribbon {
    margin-top: -12px;
    background: #ffffff;
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 8px;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 0.78rem;
    padding: 4px 10px;
    letter-spacing: 0.04em;
    box-shadow: 4px 4px 0 var(--ink);
    transform: rotate(-3deg);
    white-space: nowrap;
  }

  .sticker-browser {
    right: clamp(20px, 4vw, 70px);
    top: 50%;
    transform: translateY(-50%) rotate(5deg);
    width: 175px;
    background: #ffffff;
    border: 3.5px solid var(--ink);
    border-radius: 18px;
    padding: 10px 14px;
    box-shadow: 6px 6px 0 var(--ink);
  }

  .browser-header-dots {
    display: flex;
    gap: 6px;
    margin-bottom: 8px;
  }

  .b-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
  }
  .b-red { background: #ef4444; }
  .b-yellow { background: #eab308; }
  .b-green { background: #22c55e; }

  .browser-quote {
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-size: 0.92rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--ink);
    margin: 0;
  }

  .sticker-cursor {
    position: absolute;
    bottom: -18px;
    right: -10px;
    filter: drop-shadow(3px 3px 0 var(--ink));
    transform: rotate(-15deg);
  }

  .sticker-planet {
    right: 3%;
    top: 10%;
    filter: drop-shadow(4px 4px 0 var(--ink));
  }

  /* Hero Content */
  .hero-content-wrapper {
    position: relative;
    z-index: 3;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .community-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 2.5px solid var(--ink);
    border-radius: 999px;
    padding: 6px 18px;
    box-shadow: 0 3px 0 var(--ink);
    margin-bottom: 14px;
  }

  .badge-icon {
    display: flex;
    align-items: center;
  }

  .badge-text {
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 0.92rem;
    letter-spacing: 0.08em;
    color: var(--purple);
  }

  .hero-doodle-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .doodle-heart {
    color: var(--pink);
    font-size: 1.2rem;
  }

  .hero-title {
    margin: 0 0 14px 0;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    -webkit-text-stroke: 1.5px var(--ink);
    paint-order: stroke fill;
    filter: drop-shadow(5px 6px 0 var(--ink));
  }

  .title-highlight {
    color: var(--pink);
    display: inline-block;
  }

  .hero-subtitle {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 800;
    color: var(--ink);
    max-width: 620px;
    line-height: 1.35;
  }

  /* =========================================
     MAIN CONTENT & TWO-COLUMN GRID
     ========================================= */
  .submit-main-wrapper {
    max-width: 1220px;
    margin: 0 auto;
    padding: clamp(32px, 4vw, 48px) 20px 80px;
  }

  .submit-grid-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(24px, 3vw, 36px);
    align-items: start;
    margin-bottom: 48px;
  }

  /* FORM CARD (Left Column) */
  .submission-form-card {
    background: #ffffff;
    border: 2.5px solid var(--ink);
    border-radius: 24px;
    padding: clamp(24px, 3.5vw, 36px);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 18px;
    border-bottom: 1.5px solid #f1f5f9;
  }

  .header-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--purple);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 3px 0 var(--ink);
  }

  .card-title {
    margin: 0 0 4px 0;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .card-subtitle {
    margin: 0;
    font-size: 0.96rem;
    font-weight: 600;
    color: #64748b;
    line-height: 1.4;
  }

  /* Signed-out Notice inside Form */
  .signed-out-form-notice {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fefce8;
    border: 1.5px dashed #ca8a04;
    border-radius: 12px;
    padding: 10px 16px;
    margin-bottom: 22px;
  }

  .signed-out-form-notice .notice-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .signed-out-form-notice p {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 700;
    color: #854d0e;
    flex-grow: 1;
  }

  .mini-sign-in-btn {
    background: var(--pink);
    color: #ffffff;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 6px 14px;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 0.88rem;
    cursor: pointer;
    box-shadow: 0 2px 0 var(--ink);
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .mini-sign-in-btn:hover {
    transform: translateY(-1px);
    background: #e006a0;
  }

  /* Form Fields */
  .main-submission-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field-group label {
    font-weight: 800;
    font-size: 0.96rem;
    color: var(--ink);
  }

  .required-asterisk {
    color: var(--pink);
  }

  .label-with-counter {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .char-counter {
    font-size: 0.82rem;
    font-weight: 700;
    color: #94a3b8;
  }

  .char-counter.near-limit {
    color: #ef4444;
  }

  /* Input Wrappers with Professional Icons */
  .input-with-icon {
    position: relative;
    display: flex;
    align-items: center;
  }

  .field-icon {
    position: absolute;
    left: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }

  .textarea-icon {
    top: 14px;
  }

  .input-with-icon input,
  .input-with-icon select,
  .input-with-icon textarea {
    width: 100%;
    padding: 12px 16px 12px 42px;
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    color: var(--ink);
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-size: 0.98rem;
    font-weight: 600;
    transition: all 0.2s ease;
    box-sizing: border-box;
    outline: none;
  }

  .input-with-icon textarea {
    padding-top: 12px;
    resize: vertical;
    min-height: 86px;
    line-height: 1.45;
  }

  .input-with-icon input::placeholder,
  .input-with-icon textarea::placeholder {
    color: #94a3b8;
    font-weight: 500;
  }

  .input-with-icon input:focus,
  .input-with-icon select:focus,
  .input-with-icon textarea:focus {
    border-color: var(--pink);
    box-shadow: 0 0 0 3px rgba(242, 12, 175, 0.15);
  }

  .input-with-icon input[aria-invalid="true"],
  .input-with-icon select[aria-invalid="true"],
  .input-with-icon textarea[aria-invalid="true"] {
    border-color: #ef4444;
    background: #fef2f2;
  }

  .select-wrap select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    padding-right: 40px;
  }

  .select-chevron {
    position: absolute;
    right: 14px;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .field-hint {
    font-size: 0.82rem;
    color: #64748b;
    font-weight: 600;
  }

  .field-error-msg {
    font-size: 0.84rem;
    color: #ef4444;
    font-weight: 700;
    min-height: 18px;
  }

  /* Form Actions Row */
  .form-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 6px;
  }

  .primary-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--pink);
    color: #ffffff;
    border: 3px solid var(--ink);
    border-radius: 999px;
    padding: 14px 28px;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: 0 4px 0 var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    text-decoration: none;
  }

  .primary-submit-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 var(--ink);
    background: #e006a0;
  }

  .primary-submit-btn:active:not(:disabled) {
    transform: translateY(2px);
    box-shadow: 0 1px 0 var(--ink);
  }

  .primary-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-send-icon,
  .btn-arrow {
    display: flex;
    align-items: center;
  }

  .btn-spinner {
    display: none;
    width: 18px;
    height: 18px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .secondary-explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 22px;
    background: #ffffff;
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 999px;
    text-decoration: none;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.05rem;
    box-shadow: 0 3px 0 var(--ink);
    transition: all 0.15s ease;
  }

  .secondary-explore-btn:hover {
    background: #f8fafc;
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--ink);
  }

  .btn-explore-icon {
    display: flex;
    align-items: center;
  }

  /* Submission Success Card */
  .submission-success-card {
    text-align: center;
    padding: 36px 20px;
    background: #f0fdf4;
    border: 2.5px solid #22c55e;
    border-radius: 20px;
  }

  .success-icon-wrap {
    margin-bottom: 12px;
  }

  .success-title {
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 2.2rem;
    color: #15803d;
    margin: 0 0 10px 0;
  }

  .success-description {
    font-size: 1.05rem;
    font-weight: 600;
    color: #334155;
    max-width: 480px;
    margin: 0 auto 26px;
    line-height: 1.5;
  }

  .success-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  /* =========================================
     RIGHT COLUMN: STACK OF 3 CARDS
     ========================================= */
  .grid-col-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sidebar-card {
    border: 2px solid var(--ink);
    border-radius: 22px;
    padding: 22px;
    box-shadow: 4px 4px 0 var(--ink);
  }

  /* CARD 1: User / Auth Panel */
  .user-auth-card {
    background: #faf5ff;
    border-color: var(--ink);
  }

  .user-status-card-inner {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
    position: relative;
  }

  .user-avatar-badge {
    position: relative;
    flex-shrink: 0;
  }

  .user-online-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #dcfce7;
    border: 1px solid #86efac;
    color: #15803d;
    border-radius: 999px;
    padding: 2px 9px;
    font-size: 0.76rem;
    font-weight: 800;
    margin-bottom: 4px;
  }

  .status-pulse-dot {
    width: 6px;
    height: 6px;
    background: #22c55e;
    border-radius: 50%;
  }

  .user-name-title {
    margin: 0 0 2px 0;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.45rem;
    color: var(--ink);
  }

  .user-subtext {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 700;
    color: #64748b;
  }

  .user-crown-icon {
    position: absolute;
    right: 4px;
    top: 4px;
    display: flex;
    align-items: center;
  }

  .signed-in-callout {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #ffffff;
    border: 1.5px solid #e9d5ff;
    border-radius: 14px;
    padding: 12px 14px;
  }

  .callout-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .signed-in-callout p {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 700;
    color: #475569;
    line-height: 1.4;
  }

  /* Signed out state in auth card */
  .auth-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 18px;
  }

  .auth-lock-icon {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: #ede9fe;
    color: var(--purple);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .auth-title {
    margin: 0 0 4px 0;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.35rem;
    color: var(--ink);
  }

  .auth-subtitle {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: #64748b;
    line-height: 1.35;
  }

  .auth-primary-action {
    margin-bottom: 14px;
  }

  .clerk-auth-btn.google-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #ffffff;
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 14px;
    padding: 12px 18px;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.05rem;
    cursor: pointer;
    box-shadow: 0 3px 0 var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    text-decoration: none;
  }

  .clerk-auth-btn.google-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--ink);
  }

  .auth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 14px 0;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #cbd5e1;
  }

  .auth-divider span {
    padding: 0 12px;
    font-size: 0.8rem;
    font-weight: 800;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .auth-secondary-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }

  .clerk-pill-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    color: var(--ink);
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    padding: 9px 14px;
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-size: 0.94rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .clerk-pill-btn:hover {
    background: #f8fafc;
    border-color: var(--purple);
    transform: translateY(-1px);
  }

  .pill-icon {
    display: flex;
    align-items: center;
    color: #64748b;
  }

  .auth-card-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.88rem;
    font-weight: 700;
    color: #64748b;
    padding-top: 12px;
    border-top: 1px solid #e2e8f0;
  }

  .text-link-btn {
    background: none;
    border: none;
    color: var(--pink);
    font-weight: 800;
    cursor: pointer;
    font-family: 'Baloo 2', system-ui, sans-serif;
    font-size: 0.88rem;
    padding: 0;
    text-decoration: underline;
  }

  /* CARD 2: Community Stats */
  .community-stats-card {
    background: #fefce8;
    border-color: var(--ink);
  }

  .stats-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .stats-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .stats-icon {
    display: flex;
    align-items: center;
  }

  .stats-title {
    margin: 0;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.25rem;
    color: var(--ink);
    line-height: 1.25;
  }

  .stats-slashes {
    color: var(--pink);
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.3rem;
    letter-spacing: -2px;
  }

  .stats-badges-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .stat-pill-box {
    background: #ffffff;
    border: 2px solid var(--ink);
    border-radius: 16px;
    padding: 14px 8px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    box-shadow: 0 2px 0 var(--ink);
  }

  .stat-svg-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-num {
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.35rem;
    color: var(--ink);
    line-height: 1;
  }

  .stat-desc {
    font-size: 0.78rem;
    font-weight: 800;
    color: #64748b;
    line-height: 1.2;
  }

  /* CARD 3: What Qualifies Widget */
  .qualifies-card-widget {
    background: #ffffff;
    border-color: var(--ink);
  }

  .qualifies-widget-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .q-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .q-brain-icon {
    display: flex;
    align-items: center;
  }

  .q-widget-title {
    margin: 0;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.3rem;
    color: var(--ink);
  }

  .q-slashes {
    color: #22c55e;
    font-family: 'Lilita One', system-ui, sans-serif;
    font-size: 1.3rem;
    letter-spacing: -2px;
  }

  .q-widget-subtext {
    margin: 0 0 16px 0;
    font-size: 0.92rem;
    font-weight: 700;
    color: #64748b;
  }

  .q-widget-subtext strong {
    color: var(--ink);
  }

  .q-mini-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .q-mini-card {
    border: 2px solid var(--ink);
    border-radius: 14px;
    padding: 12px 10px;
    box-shadow: 0 2px 0 var(--ink);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

