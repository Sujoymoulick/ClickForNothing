              <span class="q-slashes" aria-hidden="true">///</span>
            </div>
            <p class="q-widget-subtext">
              If it makes you say <strong>"why does this exist?"</strong>, it probably belongs here.
            </p>

            <div class="q-mini-cards-grid">
              <!-- Mini Card 1: Completely unnecessary -->
              <div class="q-mini-card mini-pink">
                <span class="q-mini-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#d946ef" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                    <path d="M12 17h.01"/>
                  </svg>
                </span>
                <h4 class="q-mini-title">Completely unnecessary</h4>
                <p class="q-mini-desc">A website solving a problem nobody has.</p>
              </div>

              <!-- Mini Card 2: Pointlessly addictive -->
              <div class="q-mini-card mini-purple">
                <span class="q-mini-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7025ed" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                    <path d="M17 12a5 5 0 1 1-3.455-4.755"/>
                    <path d="M13 12a1 1 0 1 1-.69-0.95"/>
                  </svg>
                </span>
                <h4 class="q-mini-title">Pointlessly addictive</h4>
                <p class="q-mini-desc">You don't know why you're still here.</p>
              </div>

              <!-- Mini Card 3: Beautifully pointless -->
              <div class="q-mini-card mini-cyan">
                <span class="q-mini-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                  </svg>
                </span>
                <h4 class="q-mini-title">Beautifully pointless</h4>
                <p class="q-mini-desc">Zero productivity. Maximum commitment.</p>
              </div>

              <!-- Mini Card 4: Why does this exist? -->
              <div class="q-mini-card mini-yellow">
                <span class="q-mini-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 10h.01"/>
                    <path d="M15 10h.01"/>
                    <path d="M10 18v-3a2 2 0 0 1 4 0v3"/>
                    <path d="M18 19a3 3 0 0 1-6 0 3 3 0 0 1-6 0c0-6 4-10 6-10s6 4 6 10Z"/>
                  </svg>
                </span>
                <h4 class="q-mini-title">Why does this exist?</h4>
