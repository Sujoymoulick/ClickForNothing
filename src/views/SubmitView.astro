    </main>

    <!-- Submission Received Confirmation Popup Modal (Requirement 3 & 12) -->
    <div class="confirm-modal-backdrop" id="submission-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-heading" style="display: none;">
      <div class="confirm-modal-card">
        <button type="button" class="confirm-modal-close" id="confirm-modal-close-btn" aria-label="Close dialog">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>

        <div class="confirm-modal-badge">
          <span class="badge-icon" aria-hidden="true">✓</span>
          <span>SUBMISSION STORED IN NEON</span>
        </div>

        <h2 class="confirm-modal-title" id="confirm-modal-heading">Submission received</h2>

        <div class="confirm-modal-content">
          <p class="confirm-lead-text">
            Your website has been submitted for review.
          </p>
          <p class="confirm-sub-text">
            We review every submission to make sure it follows our guidelines.
          </p>

          <div class="confirm-timeframe-box">
            <div class="timeframe-header">
              <span class="clock-emoji" aria-hidden="true">⏱️</span>
              <strong class="timeframe-title">Maximum review time: 24 hours.</strong>
            </div>
            <p class="timeframe-detail">
              If your website follows our guidelines, it will be published within 24 hours.
            </p>
          </div>
        </div>

        <div class="confirm-modal-actions">
          <a href={dashboardUrl} class="primary-submit-btn compact" id="confirm-view-dashboard-btn">
            <span>View My Submissions →</span>
          </a>
          <button type="button" class="secondary-explore-btn compact" id="confirm-close-btn">
            <span>Close</span>
