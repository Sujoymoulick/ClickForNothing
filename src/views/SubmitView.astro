                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <span>Must be safe for visitors</span>
            </li>
            <li>
              <span class="check-box" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <span>Must not require illegal activity</span>
            </li>
            <li>
              <span class="check-box" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <span>No spam or malicious websites</span>
            </li>
            <li>
              <span class="check-box" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <span>Must actually be interesting, weird, pointless, or useless</span>
            </li>
          </ul>
        </section>

        <!-- Right: Community CTA -->
        <section class="bottom-card finish-cta-card" aria-labelledby="finish-title">
          <div class="bottom-card-header">
            <span class="b-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f20caf" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="6" x2="10" y1="12" y2="12"/>
                <line x1="8" x2="8" y1="10" y2="14"/>
                <line x1="15" x2="15.01" y1="13" y2="13"/>
                <line x1="18" x2="18.01" y1="11" y2="11"/>
                <rect width="20" height="12" x="2" y="6" rx="6"/>
              </svg>
            </span>
            <div>
              <h2 class="bottom-card-title" id="finish-title">Finished submitting?</h2>
              <p class="bottom-card-subtitle">Now go waste some time.</p>
            </div>
          </div>

          <div class="cta-actions-column">
            <a href={discoverUrl} class="cta-primary-btn">
              <span class="cta-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                </svg>
              </span>
              <span>Discover Useless Websites</span>
            </a>

            <a href={randomUrl} class="cta-secondary-btn">
              <span class="cta-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 3 21 3 21 8"/>
                  <line x1="4" x2="21" y1="20" y2="3"/>
                  <polyline points="21 16 21 21 16 21"/>
                  <line x1="15" x2="21" y1="15" y2="21"/>
                  <line x1="4" x2="9" y1="4" y2="9"/>
                </svg>
