---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FallingCards from '../components/FallingCards.astro';
import { useTranslations } from '../i18n';
import { getLocalizedPath, getLocaleFromUrl } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);

const title = `ClickForNothing — ${t('hero.title_start')} ${t('hero.title_end')}`;
const description = t('hero.subtitle');
const exploreUrl = getLocalizedPath('/explore/', currentLocale);
const submitUrl = getLocalizedPath('/submit/', currentLocale);
---

<SiteLayout {title} {description}>
  <SiteHeader />

  <main class="home-main">
    <div class="home-container">
      <!-- Minimal Hero Section -->
      <section class="minimal-hero" aria-labelledby="hero-heading">
        <h1 id="hero-heading" class="hero-heading">
          Nothing to do? Click something.
        </h1>
        <p class="hero-subtitle">
          {description}
        </p>

        <div class="hero-cta-group">
          <a href={exploreUrl} class="btn btn-primary">
            Explore Randomly
          </a>
          <a href={submitUrl} class="btn btn-secondary">
            Submit a Website
          </a>
        </div>
      </section>

      <!-- Falling Cards Section -->
      <section class="falling-section" aria-label="Falling Cards Stream">
        <FallingCards limit={45} />
      </section>
    </div>
  </main>
</SiteLayout>

<style>
  .home-main {
    width: 100%;
    min-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    padding: 32px 20px 48px;
    background: var(--bg, #faf9f6);
  }

  .home-container {
    max-width: 1040px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 5vh, 48px);
  }

  .minimal-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(24px, 4vh, 48px) 16px 0;
  }

  .hero-heading {
    margin: 0 0 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(2.2rem, 5.2vw, 3.8rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text, #1a1a1a);
    max-width: 780px;
  }

  .hero-subtitle {
    margin: 0 0 28px;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-muted, #666666);
    max-width: 580px;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 22px;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border-radius: var(--radius, 8px);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: #111111;
    color: #ffffff;
    border: 1px solid #111111;
  }

  .btn-primary:hover {
    background: #2a2a2a;
    border-color: #2a2a2a;
    transform: translateY(-1px);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-secondary {
    background: #ffffff;
    color: #111111;
    border: 1px solid var(--border, #e6e5e0);
  }

  .btn-secondary:hover {
    background: #f7f6f2;
    border-color: #cccccc;
    transform: translateY(-1px);
  }

  .btn-secondary:active {
    transform: translateY(0);
  }

  .falling-section {
    width: 100%;
  }

  @media (max-width: 640px) {
    .home-main {
      padding: 16px 12px 32px;
    }
    .hero-heading {
      font-size: 2rem;
    }
    .hero-subtitle {
      font-size: 0.98rem;
      margin-bottom: 22px;
    }
    .btn {
      width: 100%;
      max-width: 280px;
    }
  }
</style>
