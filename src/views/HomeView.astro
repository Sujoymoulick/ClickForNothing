---
import SiteLayout from '../layouts/SiteLayout.astro';
import TopBar from '../components/TopBar.astro';
import { websites } from '../data/websites';
import { categories } from '../data/categories';
import { Show, SignInButton } from '@clerk/astro/components';

const title = 'ClickForNothing — Submit a useless website';
const description = 'Submit a useless website. Watch it fall. Click it if you must.';
const seed = websites.slice(0, 40).map((s) => ({ name: s.name, url: s.url }));
---

<SiteLayout {title} {description} canonicalPath="/" hideFooter>
  <TopBar />
  <main class="stage" id="stage">
    <div class="side" id="panel">
    <section class="panel" aria-labelledby="panel-title">
      <div class="counter" aria-label="Total sites submitted">
        <strong id="sub-count">…</strong>
        <span>submitted</span>
      </div>
      <h1 id="panel-title">Submit a useless website</h1>
      <p class="muted">Free to submit. Reviewed by a human.</p>

      <Show when="signed-out">
        <SignInButton mode="modal" class="btn">Sign in to submit</SignInButton>
      </Show>

      <Show when="signed-in">
        <form id="submit-form" novalidate>
          <input name="url" type="url" placeholder="https://" required autocomplete="off" />
          <input name="name" type="text" placeholder="Site name" maxlength="80" required autocomplete="off" />
          <textarea name="description" rows="2" placeholder="What does it do? (nothing, ideally)" maxlength="300" required></textarea>
          <select name="category" required>
            <option value="" disabled selected>Category</option>
            {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
          </select>
          <button type="submit" class="btn">Submit</button>
          <p class="msg" id="form-msg" role="status" aria-live="polite"></p>
        </form>
      </Show>
    </section>
    <a class="sotd" id="sotd" href="#" target="_blank" rel="noopener noreferrer" hidden>
      <span class="sotd-label">Site of the day</span>
      <strong id="sotd-name"></strong>
      <span class="sotd-desc" id="sotd-desc"></span>
    </a>
    </div>
  </main>
  <script id="ball-seed" type="application/json" set:html={JSON.stringify(seed)} />
</SiteLayout>

<style>
  :global(html), :global(body) { height: 100%; overflow: hidden; }
  .stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: #f7f6f3;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    touch-action: none;
  }
  .side {
    position: absolute;
    left: 24px;
    top: 50%;
    transform: translateY(-50%);
    width: 340px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 5;
    touch-action: auto;
  }
  .sotd {
    display: block;
    padding: 14px 16px;
    background: #fff;
    border: 1px solid #e6e5e0;
    border-radius: 14px;
    color: #111;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .sotd[hidden] { display: none; }
  .sotd:hover { border-color: #111; }
  .sotd-label { display: block; font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; color: #a07a00; margin-bottom: 4px; }
  .sotd strong { display: block; font-size: 15px; font-weight: 650; }
  .sotd-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 3px; font-size: 12.5px; color: #777; line-height: 1.4; }
  .panel {
    position: relative;
    padding: 22px;
    background: #fff;
    border: 1px solid #e6e5e0;
    border-radius: 14px;
    z-index: 5;
    touch-action: auto;
  }
  h1 { margin: 0 0 6px; font-size: 18px; font-weight: 650; color: #111; letter-spacing: -0.01em; }
  .muted { margin: 0 0 16px; font-size: 13px; color: #888; line-height: 1.45; }
  form { display: grid; gap: 8px; }
  input, textarea, select {
    width: 100%;
    font: inherit;
    font-size: 14px;
    padding: 10px 12px;
    border: 1px solid #e2e1dc;
    border-radius: 8px;
    background: #fbfbfa;
    color: #111;
    resize: none;
  }
  input:focus, textarea:focus, select:focus { outline: none; border-color: #111; background: #fff; }
  .panel :global(.btn) {
    width: 100%;
    padding: 11px;
    border: 0;
    border-radius: 8px;
    background: #111;
    color: #fff;
    font: 600 14px/1 inherit;
    font-family: inherit;
    cursor: pointer;
  }
  .panel :global(.btn:disabled) { opacity: 0.5; cursor: default; }
  .counter {
    position: absolute;
    top: -22px;
    right: -22px;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
  }
  .counter strong { font-size: 20px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  .counter span { font-size: 9.5px; letter-spacing: 0.04em; text-transform: uppercase; color: #bbb; }
  h1, .muted { padding-right: 56px; }
  .msg { margin: 0; min-height: 16px; font-size: 12.5px; color: #888; }
  .msg.err { color: #b42318; }
  .msg.ok { color: #1a7f37; }

  :global(.ball) {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    text-align: center;
    text-decoration: none;
    font-weight: 600;
    line-height: 1.15;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
    will-change: transform;
    z-index: 2;
  }
  :global(.ball > .shade), :global(.ball > .label) {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transition: scale 0.18s ease;
  }
  /* Fixed light source (top-left): the shading never rotates, only the label rolls */
  :global(.ball > .shade) {
    background: var(--sphere);
    box-shadow:
      inset -10px -14px 28px rgba(0, 0, 0, 0.18),
      inset 6px 8px 16px rgba(255, 255, 255, 0.10),
      0 16px 24px -10px rgba(0, 0, 0, 0.35);
  }
  :global(.ball > .shade::after) {
    content: '';
    position: absolute;
    left: 18%;
    top: 12%;
    width: 34%;
    height: 22%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, var(--spec)) 0%, rgba(255, 255, 255, 0) 70%);
    transform: rotate(-30deg);
  }
  :global(.ball > .label) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16%;
    color: var(--fg);
    text-shadow: var(--ts);
    overflow-wrap: anywhere;
    will-change: transform;
  }
  :global(.ball:hover > *), :global(.ball:focus-visible > *) { scale: 1.07; }
  :global(.ball.dragging) { cursor: grabbing; z-index: 3; }

  @media (max-width: 720px) {
    .side { left: 12px; right: 12px; top: 64px; width: auto; transform: none; gap: 8px; }
    .panel { padding: 16px; }
    .sotd { padding: 10px 14px; }
    .sotd-desc { display: none; }
    .counter { top: 12px; right: 12px; width: 58px; height: 58px; }
    .counter strong { font-size: 16px; }
    .counter span { font-size: 8px; }
    .muted { margin-bottom: 12px; }
    textarea { display: none; }
  }
</style>

<script>
  type Ball = { el: HTMLAnchorElement; label: HTMLSpanElement; x: number; y: number; vx: number; vy: number; r: number; m: number; a: number; w: number };
  type Site = { name: string; url: string };

  const PALETTE = [
    {
      sphere: 'radial-gradient(circle at 32% 28%, #6a6a6a 0%, #2a2a2a 30%, #0d0d0d 70%, #000 100%)',
      fg: '#ffffff', spec: '0.55', ts: '0 1px 3px rgba(0,0,0,0.7)',
    },
    {
      sphere: 'radial-gradient(circle at 32% 28%, #ffffff 0%, #f7f6f2 35%, #dcdad2 78%, #bcb9ae 100%)',
      fg: '#111111', spec: '0.95', ts: '0 1px 0 rgba(255,255,255,0.7)',
    },
    {
      sphere: 'radial-gradient(circle at 32% 28%, #fdfcf9 0%, #e8e5de 35%, #c9c5ba 78%, #a9a598 100%)',
      fg: '#111111', spec: '0.9', ts: '0 1px 0 rgba(255,255,255,0.6)',
    },
  ];

  function shuffle<T>(a: T[]) {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  async function loadSites(): Promise<Site[]> {
    let seed: Site[] = [];
    try { seed = JSON.parse(document.getElementById('ball-seed')?.textContent || '[]'); } catch {}
    let live: Site[] = [];
    try {
      const res = await fetch('/api/published?limit=60');
      if (res.ok) {
        const data = await res.json();
        live = (data.sites || []).filter((s: Site) => s.name && s.url);
      }
    } catch {}
    const seen = new Set<string>();
    // Real user submissions first (newest first, as the API returns them), then curated sites
    const merged = [...live, ...shuffle(seed)].filter((s) => {
      const k = s.url.toLowerCase();
      if (seen.has(k)) return false;
      seen.add(k);
      return true;
    });
    const count = Math.max(10 + Math.floor(Math.random() * 6), Math.min(live.length, 15));
    return merged.slice(0, count);
  }

  function init() {
    const stage = document.getElementById('stage');
    const panel = document.getElementById('panel');
    if (!stage || !panel || stage.dataset.ready) return;
    stage.dataset.ready = '1';

    const balls: Ball[] = [];
    let W = stage.clientWidth;
    let H = stage.clientHeight;
    let rect = { l: 0, t: 0, r: 0, b: 0 };
    let mobile = false;
    const measure = () => {
      W = stage.clientWidth;
      H = stage.clientHeight;
      const p = panel.getBoundingClientRect();
      const s = stage.getBoundingClientRect();
      rect = { l: p.left - s.left, t: p.top - s.top, r: p.right - s.left, b: p.bottom - s.top };
      mobile = window.matchMedia('(max-width: 720px)').matches;
    };
    measure();
    new ResizeObserver(measure).observe(panel);
    window.addEventListener('resize', measure);

    const scale = () => (mobile ? Math.max(0.5, Math.min(0.75, W / 600)) : Math.min(1.1, Math.max(0.62, Math.min(W, H) / 820)));

    function spawn(site: Site, i: number) {
      const r = (40 + Math.min(site.name.length, 40) * 2.4) * scale();
      const c = PALETTE[i % PALETTE.length];
      const el = document.createElement('a');
      el.className = 'ball';
      el.href = site.url;
      el.target = '_blank';
      el.rel = 'noopener noreferrer';
      el.title = site.url;
      el.style.width = el.style.height = `${r * 2}px`;
      el.style.fontSize = `${Math.max(11, Math.min(17, r / 4.2))}px`;
      el.style.setProperty('--sphere', c.sphere);
      el.style.setProperty('--fg', c.fg);
      el.style.setProperty('--spec', c.spec);
      el.style.setProperty('--ts', c.ts);
      const shade = document.createElement('span');
      shade.className = 'shade';
      shade.setAttribute('aria-hidden', 'true');
      const label = document.createElement('span');
      label.className = 'label';
      label.textContent = site.name;
      el.append(shade, label);
      stage!.appendChild(el);
      measure();
      const minX = mobile ? r : Math.min(rect.r + r, W - r);
      const x = minX + Math.random() * Math.max(1, W - r - minX);
      const y = mobile ? rect.b + r + 4 : -r - 10;
      const b: Ball = { el, label, x, y, vx: (Math.random() - 0.5) * 120, vy: 0, r, m: r * r, a: 0, w: (Math.random() - 0.5) * 2 };
      balls.push(b);
      bindPointer(b);
    }

    // Drag / throw / hover
    let drag: { b: Ball; ox: number; oy: number; lx: number; ly: number; lt: number; moved: number } | null = null;
    function bindPointer(b: Ball) {
      b.el.addEventListener('pointerenter', (e) => {
        if (drag || e.pointerType !== 'mouse') return;
        b.vy -= 260;
        b.vx += (Math.random() - 0.5) * 160;
      });
      b.el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        b.el.setPointerCapture(e.pointerId);
        b.el.classList.add('dragging');
        drag = { b, ox: e.clientX - b.x, oy: e.clientY - b.y, lx: e.clientX, ly: e.clientY, lt: performance.now(), moved: 0 };
      });
      b.el.addEventListener('pointermove', (e) => {
        if (!drag || drag.b !== b) return;
        const now = performance.now();
        const dt = Math.max(1, now - drag.lt) / 1000;
        b.vx = (e.clientX - drag.lx) / dt;
        b.vy = (e.clientY - drag.ly) / dt;
        drag.moved += Math.abs(e.clientX - drag.lx) + Math.abs(e.clientY - drag.ly);
        drag.lx = e.clientX;
        drag.ly = e.clientY;
        drag.lt = now;
        b.x = e.clientX - drag.ox;
        b.y = e.clientY - drag.oy;
      });
      const end = () => {
        if (!drag || drag.b !== b) return;
        b.el.classList.remove('dragging');
        if (drag.moved < 6) window.open(b.el.href, '_blank', 'noopener,noreferrer');
        b.vx = Math.max(-2500, Math.min(2500, b.vx));
        b.vy = Math.max(-2500, Math.min(2500, b.vy));
        b.w = (b.vx / b.r) * 0.4;
        drag = null;
      };
      b.el.addEventListener('pointerup', end);
      b.el.addEventListener('pointercancel', () => { b.el.classList.remove('dragging'); drag = null; });
      b.el.addEventListener('click', (e) => e.preventDefault());
      b.el.addEventListener('keydown', (e) => { if (e.key === 'Enter') window.open(b.el.href, '_blank', 'noopener,noreferrer'); });
    }

    const G = 1700, REST = 0.45, AIR = 0.999;
    function collideRect(b: Ball) {
      // Mobile: panel spans the width, so its bottom edge acts as the ceiling of the play area
      if (mobile) {
        if (b.y - b.r < rect.b) { b.y = rect.b + b.r; if (b.vy < 0) b.vy *= -REST; }
        return;
      }
      const cx = Math.max(rect.l, Math.min(b.x, rect.r));
      const cy = Math.max(rect.t, Math.min(b.y, rect.b));
      let dx = b.x - cx, dy = b.y - cy;
      const d2 = dx * dx + dy * dy;
      if (d2 >= b.r * b.r) return;
      let d = Math.sqrt(d2);
      if (d === 0) { dx = 0; dy = -1; d = 1; b.y = rect.t; }
      const nx = dx / d, ny = dy / d;
      b.x += nx * (b.r - d);
      b.y += ny * (b.r - d);
      const vn = b.vx * nx + b.vy * ny;
      if (vn < 0) { b.vx -= (1 + REST) * vn * nx; b.vy -= (1 + REST) * vn * ny; }
    }

    function step(dt: number) {
      for (const b of balls) {
        if (drag?.b === b) continue;
        b.vy += G * dt;
        b.vx *= AIR;
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        if (b.y + b.r > H) {
          b.y = H - b.r;
          if (b.vy > 0) b.vy *= -REST;
          b.vx *= 0.985;
          if (Math.abs(b.vy) < 30) b.vy = 0;
          // Rolling contact: spin converges to v / r
          b.w += (b.vx / b.r - b.w) * 0.25;
        }
        if (b.x - b.r < 0) { b.x = b.r; if (b.vx < 0) b.vx *= -REST; }
        if (b.x + b.r > W) { b.x = W - b.r; if (b.vx > 0) b.vx *= -REST; }
        collideRect(b);
      }
      for (let i = 0; i < balls.length; i++) {
        for (let j = i + 1; j < balls.length; j++) {
          const a = balls[i], c = balls[j];
          const dx = c.x - a.x, dy = c.y - a.y;
          const min = a.r + c.r;
          const d2 = dx * dx + dy * dy;
          if (d2 >= min * min || d2 === 0) continue;
          const d = Math.sqrt(d2), nx = dx / d, ny = dy / d;
          const overlap = min - d;
          const ia = drag?.b === a ? 0 : 1 / a.m, ic = drag?.b === c ? 0 : 1 / c.m;
          const sum = ia + ic || 1;
          a.x -= nx * overlap * (ia / sum); a.y -= ny * overlap * (ia / sum);
          c.x += nx * overlap * (ic / sum); c.y += ny * overlap * (ic / sum);
          const rv = (c.vx - a.vx) * nx + (c.vy - a.vy) * ny;
          if (rv > 0) continue;
          const jimp = (-(1 + REST) * rv) / sum;
          a.vx -= jimp * ia * nx; a.vy -= jimp * ia * ny;
          c.vx += jimp * ic * nx; c.vy += jimp * ic * ny;
          // Friction at the contact point transfers spin between balls
          const tx = -ny, ty = nx;
          const vt = (c.vx - a.vx) * tx + (c.vy - a.vy) * ty + a.w * a.r + c.w * c.r;
          const k = 0.12 * vt;
          if (ia) a.w -= k / a.r;
          if (ic) c.w -= k / c.r;
        }
      }
      for (const b of balls) {
        if (drag?.b === b) continue;
        b.w *= 0.995;
        b.a += b.w * dt;
        // Nearly at rest: settle the label upright so the text stays readable
        if (Math.abs(b.w) < 0.8 && Math.abs(b.vx) < 20 && Math.abs(b.vy) < 20) {
          const target = Math.round(b.a / (2 * Math.PI)) * 2 * Math.PI;
          b.a += (target - b.a) * Math.min(1, dt * 4);
          b.w *= 0.9;
        }
      }
    }

    let last = performance.now();
    function frame(now: number) {
      const dt = Math.min(0.033, (now - last) / 1000);
      last = now;
      for (let k = 0; k < 4; k++) step(dt / 4);
      for (const b of balls) {
        b.el.style.transform = `translate(${b.x - b.r}px, ${b.y - b.r}px)`;
        b.label.style.transform = `rotate(${b.a}rad)`;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);

    loadSites().then((sites) => sites.forEach((s, i) => setTimeout(() => spawn(s, i), 300 + i * 420)));
  }

  async function token(): Promise<string | null> {
    try { return (await (window as any).Clerk?.session?.getToken()) || null; } catch { return null; }
  }

  function bindForm() {
    const form = document.getElementById('submit-form') as HTMLFormElement | null;
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';
    const msg = document.getElementById('form-msg')!;
    const say = (t: string, kind = '') => { msg.textContent = t; msg.className = `msg ${kind}`; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const url = String(f.get('url') || '').trim();
      const name = String(f.get('name') || '').trim();
      let description = String(f.get('description') || '').trim();
      const category = String(f.get('category') || '');
      if (!description && window.matchMedia('(max-width: 720px)').matches) description = `${name} — a useless website.`;
      if (!/^https?:\/\//i.test(url)) return say('URL must start with http:// or https://', 'err');
      if (name.length < 2) return say('Name is too short.', 'err');
      if (description.length < 10) return say('Description needs at least 10 characters.', 'err');
      if (!category) return say('Pick a category.', 'err');

      const btn = form.querySelector('button')!;
      btn.disabled = true;
      say('Sending…');
      try {
        const t = await token();
        const res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...(t ? { Authorization: `Bearer ${t}` } : {}) },
          credentials: 'include',
          body: JSON.stringify({ url, name, description, category, designId: 'theme-01' }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) { form.reset(); say('Submitted. Pending review.', 'ok'); }
        else say(data.error || 'Could not submit. Try again.', 'err');
      } catch {
        say('Network error. Try again.', 'err');
      } finally {
        btn.disabled = false;
      }
    });
  }

  async function loadCount() {
    const out = document.getElementById('sub-count');
    if (!out || out.dataset.ready) return;
    out.dataset.ready = '1';
    try {
      const res = await fetch('/api/stats');
      const { count } = await res.json();
      if (typeof count === 'number') out.textContent = count.toLocaleString();
      else out.textContent = '—';
    } catch {
      out.textContent = '—';
    }
  }

  async function loadSiteOfTheDay() {
    const card = document.getElementById('sotd') as HTMLAnchorElement | null;
    if (!card || card.dataset.ready) return;
    card.dataset.ready = '1';
    try {
      const { site } = await (await fetch('/api/site-of-the-day')).json();
      if (!site?.url || !/^https?:\/\//i.test(site.url)) return;
      card.href = site.url;
      document.getElementById('sotd-name')!.textContent = site.name;
      document.getElementById('sotd-desc')!.textContent = site.description || '';
      card.hidden = false;
    } catch {}
  }

  const boot = () => { init(); bindForm(); loadCount(); loadSiteOfTheDay(); };
  boot();
  document.addEventListener('astro:page-load', boot);
  // Clerk renders <Show> content after load
  new MutationObserver(bindForm).observe(document.body, { childList: true, subtree: true });
</script>
