---
import SiteLayout from '../layouts/SiteLayout.astro';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import PepeMascot from '../components/PepeMascot.astro';
import { useTranslations } from '../i18n';
import { getLocalizedPath, getLocaleFromUrl } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);

const title = `ClickForNothing — ${t('hero.title_start')} ${t('hero.title_end')}`;
const description = t('hero.subtitle');
const discoverUrl = getLocalizedPath('/discover/', currentLocale);
const siteUrl = Astro.site?.toString() ?? 'https://clickfornothing.com';
const currentUrl = new URL(getLocalizedPath('/', currentLocale), siteUrl).href;
---
<SiteLayout {title} {description}>
  <main class="hero-stage">
    <div class="deco checker checker-top" aria-hidden="true"></div>
    <div class="deco checker checker-bottom" aria-hidden="true"></div>
    <div class="deco pink-puddle" aria-hidden="true"></div>
    <div class="deco purple-puddle" aria-hidden="true"></div>
    <span class="deco burst burst-pink" aria-hidden="true">✹</span>
    <span class="deco burst burst-teal" aria-hidden="true">✹</span>
    <span class="deco burst burst-violet" aria-hidden="true">✷</span>
    <span class="deco twinkle twinkle-left" aria-hidden="true">✦</span>
    <span class="deco twinkle twinkle-right" aria-hidden="true">✦</span>
    <span class="deco squiggle squiggle-pink" aria-hidden="true">〰</span>
    <span class="deco squiggle squiggle-purple" aria-hidden="true">〰</span>
    <span class="deco dot dot-one" aria-hidden="true"></span><span class="deco dot dot-two" aria-hidden="true"></span>
    <span class="deco dot dot-three" aria-hidden="true"></span><span class="deco dot dot-four" aria-hidden="true"></span>
    <span class="deco dot dot-five" aria-hidden="true"></span>
    <span class="deco cursor" aria-hidden="true">➤</span>

    <div class="hero-top-bar">
      <LocaleSwitcher variant="hero" />
    </div>

    <section class="hero-content" aria-labelledby="hero-title">
      <h1 class="hero-title" id="hero-title">
        <span class="pink">{t('hero.title_start')}</span>
        <span class="purple">{t('hero.title_end')}</span>
      </h1>
      <PepeMascot />
      <p class="hero-subtitle">{description}</p>
      <div class="hero-actions">
        <a class="go-button" href={discoverUrl} aria-label={t('hero.cta_aria')}>
          <span>{t('hero.cta')}</span><span class="arrow" aria-hidden="true">↗︎</span>
        </a>
        <div class="share-buttons">
          <button class="share-button" data-platform="twitter" aria-label="Share on Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
          </button>
          <button class="share-button" data-platform="facebook" aria-label="Share on Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </button>
          <button class="share-button" data-platform="whatsapp" aria-label="Share on WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          </button>
          <button class="share-button" data-platform="copy" aria-label="Copy link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2 2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
      </div>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'WebSite', name: 'ClickForNothing',
    url: currentUrl, description,
  })} />
</SiteLayout>
