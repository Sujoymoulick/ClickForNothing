---
import SiteLayout from '../layouts/SiteLayout.astro';
import TopBar from '../components/TopBar.astro';
import { Show, SignInButton } from '@clerk/astro/components';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const locale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const home = getLocalizedPath('/', locale);
---

<SiteLayout title="Dashboard — ClickForNothing" description="Your submitted websites." canonicalPath="/dashboard/" noindex hideFooter>
  <TopBar />
  <main class="dash">
    <div class="box">
      <div class="head">
        <h1>Your submissions</h1>
        <a href={home} class="link">+ Submit</a>
      </div>

      <Show when="signed-out">
        <p class="muted">Sign in to see what you submitted.</p>
        <SignInButton mode="modal" class="btn">Sign in</SignInButton>
      </Show>

      <Show when="signed-in">
        <ul class="list" id="list" aria-live="polite"><li class="muted">Loading…</li></ul>
      </Show>
    </div>
  </main>
</SiteLayout>

<style>
  :global(html), :global(body) { height: 100%; overflow: hidden; }
  .dash {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 72px 16px 24px;
    background: #f7f6f3;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .box {
    width: 100%;
    max-width: 560px;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e6e5e0;
    border-radius: 14px;
    padding: 22px;
  }
  .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
  h1 { margin: 0; font-size: 18px; font-weight: 650; color: #111; }
  .link { font-size: 14px; color: #111; text-decoration: none; }
  .link:hover { text-decoration: underline; }
  .muted { color: #888; font-size: 13.5px; margin: 0 0 14px; }
  .box :global(.btn) {
    width: 100%; padding: 11px; border: 0; border-radius: 8px;
    background: #111; color: #fff; font: 600 14px/1 inherit; font-family: inherit; cursor: pointer;
  }
  .list { list-style: none; margin: 0; padding: 0; overflow-y: auto; }
  :global(.row) {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 12px 0; border-top: 1px solid #f0efe9;
  }
  :global(.row:first-child) { border-top: 0; }
  :global(.row a) { color: #111; text-decoration: none; font-size: 14.5px; font-weight: 550; }
  :global(.row a:hover) { text-decoration: underline; }
  :global(.row small) { display: block; color: #999; font-size: 12px; margin-top: 3px; }
  :global(.tag) {
    flex: none; font-size: 11.5px; padding: 4px 9px; border-radius: 999px;
    background: #f1f0ec; color: #666; text-transform: capitalize;
  }
  :global(.tag.published), :global(.tag.approved) { background: #e8f5ec; color: #1a7f37; }
  :global(.tag.rejected) { background: #fdecea; color: #b42318; }
</style>

<script>
  type Sub = { name: string; url: string; status: string; created_at?: string; rejection_reason?: string };

  let tries = 0;
  async function load() {
    const list = document.getElementById('list');
    if (!list || list.dataset.ready) return;
    const clerk = (window as any).Clerk;
    if (!clerk?.session) { if ((tries += 1) < 40) setTimeout(load, 250); return; }
    list.dataset.ready = '1';
    try {
      const token = await clerk.session.getToken();
      const res = await fetch('/api/submissions', {
        headers: { Accept: 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
        credentials: 'include',
      });
      if (!res.ok) throw new Error();
      const subs: Sub[] = (await res.json()).submissions || [];
      list.replaceChildren();
      if (!subs.length) {
        const li = document.createElement('li');
        li.className = 'muted';
        li.textContent = 'Nothing yet. Go submit something useless.';
        list.appendChild(li);
        return;
      }
      for (const s of subs) {
        const li = document.createElement('li');
        li.className = 'row';
        const left = document.createElement('div');
        const a = document.createElement('a');
        a.href = s.url; a.target = '_blank'; a.rel = 'noopener noreferrer';
        a.textContent = s.name;
        const meta = document.createElement('small');
        const date = s.created_at ? new Date(s.created_at).toLocaleDateString() : '';
        meta.textContent = [date, s.status === 'rejected' ? s.rejection_reason : ''].filter(Boolean).join(' · ');
        left.append(a, meta);
        const tag = document.createElement('span');
        tag.className = `tag ${s.status}`;
        tag.textContent = s.status || 'pending';
        li.append(left, tag);
        list.appendChild(li);
      }
    } catch {
      list.innerHTML = '<li class="muted">Could not load. Refresh to try again.</li>';
    }
  }

  load();
  document.addEventListener('astro:page-load', load);
  new MutationObserver(load).observe(document.body, { childList: true, subtree: true });
</script>
