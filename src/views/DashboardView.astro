    function closeAllModals() {
      if (editModal) editModal.style.display = 'none';
      if (liveCardModal) liveCardModal.style.display = 'none';
      if (reasonModal) reasonModal.style.display = 'none';
    }

    if (editModalClose) editModalClose.addEventListener('click', () => { if (editModal) editModal.style.display = 'none'; });
    if (editCancelBtn) editCancelBtn.addEventListener('click', () => { if (editModal) editModal.style.display = 'none'; });
    if (liveCardModalClose) liveCardModalClose.addEventListener('click', () => { if (liveCardModal) liveCardModal.style.display = 'none'; });
    if (liveCardDoneBtn) liveCardDoneBtn.addEventListener('click', () => { if (liveCardModal) liveCardModal.style.display = 'none'; });
    if (reasonModalClose) reasonModalClose.addEventListener('click', () => { if (reasonModal) reasonModal.style.display = 'none'; });
    if (reasonCloseBtn) reasonCloseBtn.addEventListener('click', () => { if (reasonModal) reasonModal.style.display = 'none'; });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAllModals();
    });

    // Clerk Bearer token helper with retry
    async function getAuthToken(retries = 3): Promise<string | null> {
      for (let i = 0; i < retries; i++) {
        if ((window as any).Clerk?.session) {
          try {
            const token = await (window as any).Clerk.session.getToken();
            if (token) return token;
          } catch {
            // retry
          }
        }
        if (i < retries - 1) {
          await new Promise((r) => setTimeout(r, 200));
        }
      }
      return null;
    }

    // Set Live indicator status
    function setLiveStatus(status: 'connected' | 'syncing' | 'offline', message?: string) {
      if (!liveStrip || !liveText) return;
      liveStrip.classList.remove('offline', 'syncing');

      if (status === 'connected') {
        liveText.textContent = message || 'Live updates enabled · Synced just now';
      } else if (status === 'syncing') {
        liveStrip.classList.add('syncing');
        liveText.textContent = message || '↻ Syncing with Neon...';
      } else if (status === 'offline') {
        liveStrip.classList.add('offline');
        liveText.textContent = message || '🔴 Live updates unavailable · Will retry automatically';
      }
    }

    // Fetch Submissions from Neon via /api/submissions
    async function fetchSubmissions(isInitial = false) {
      if (isFetching) return;
      const state = $authStore.get();
      if (!state?.userId) return;

      isFetching = true;
      if (refreshBtn) refreshBtn.classList.add('spinning');
      if (refreshLabel) refreshLabel.textContent = 'Refreshing...';
      setLiveStatus('syncing');

      if (isInitial && (!cachedSubmissions || cachedSubmissions.length === 0)) {
        if (skeletonList) skeletonList.style.display = 'block';
        if (submissionsList) submissionsList.style.display = 'none';
        if (emptyView) emptyView.style.display = 'none';
        if (errorView) errorView.style.display = 'none';
      }

      try {
        const token = await getAuthToken();
        const headers: Record<string, string> = { Accept: 'application/json' };
        if (token) {
          headers['Authorization'] = `Bearer ${token}`;
        }

        const res = await fetch('/api/submissions', {
          method: 'GET',
          headers,
          credentials: 'include',
        });

        if (!res.ok) {
          if (res.status === 401) return;
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `Failed to fetch submissions (${res.status})`);
        }

        const data = await res.json();
        cachedSubmissions = Array.isArray(data.submissions) ? data.submissions : [];
        lastFetchTimestamp = Date.now();

        if (errorView) errorView.style.display = 'none';
        setLiveStatus('connected', 'Live updates enabled · Synced just now');

        updateCounts();
        renderSubmissions();

        if (refreshLabel) {
          refreshLabel.textContent = 'Updated just now';
          setTimeout(() => {
            if (refreshLabel) refreshLabel.textContent = 'Refresh';
          }, 2000);
        }
      } catch (err: any) {
        console.error('Error fetching submissions from Neon:', err);
        setLiveStatus('offline', 'Failed to reach Neon · Retrying automatically');

        if (isInitial && (!cachedSubmissions || cachedSubmissions.length === 0)) {
          if (skeletonList) skeletonList.style.display = 'none';
          if (submissionsList) submissionsList.style.display = 'none';
          if (emptyView) emptyView.style.display = 'none';
          if (errorView) {
            errorView.style.display = 'block';
            if (errorMsg) errorMsg.textContent = err?.message || 'Could not connect to database.';
          }
        }
      } finally {
        isFetching = false;
        if (skeletonList) skeletonList.style.display = 'none';
        if (refreshBtn) refreshBtn.classList.remove('spinning');
      }
    }

    // Update 5 Stat Counts
    function updateCounts() {
      const total = cachedSubmissions.length;
      const review = cachedSubmissions.filter((s) => s.status === 'pending_review' || s.status === 'pending').length;
      // An approved or published submission counts towards approved (ready to publish / published)
      const approved = cachedSubmissions.filter((s) => s.status === 'approved' || s.status === 'published').length;
      const published = cachedSubmissions.filter((s) => s.status === 'published').length;
      const rejected = cachedSubmissions.filter((s) => s.status === 'rejected').length;

      if (countTotal) countTotal.textContent = String(total);
      if (countReview) countReview.textContent = String(review);
      if (countApproved) countApproved.textContent = String(approved);
      if (countPublished) countPublished.textContent = String(published);
      if (countRejected) countRejected.textContent = String(rejected);

      const labelTotal = document.getElementById('label-subtext-total');
      if (labelTotal) labelTotal.textContent = total === 1 ? 'Submission' : 'Submissions';
    }

    // Search input listener
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentSearchQuery = searchInput.value.trim().toLowerCase();
        renderSubmissions();
      });
    }

    // Filter & Sort Change Listeners
    const statCards = document.querySelectorAll('.stat-card');
    statCards.forEach((card) => {
      card.addEventListener('click', () => {
        const filter = card.getAttribute('data-filter') || 'all';
        setFilter(filter);
      });
    });

    if (statusSelect) {
      statusSelect.addEventListener('change', () => {
        setFilter(statusSelect.value);
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        currentSort = sortSelect.value;
        renderSubmissions();
      });
    }

    function setFilter(filter: string) {
      currentFilter = filter;
      statCards.forEach((c) => {
        if (c.getAttribute('data-filter') === filter) {
          c.classList.add('active');
        } else {
          c.classList.remove('active');
        }
      });
      if (statusSelect && statusSelect.value !== filter) {
        statusSelect.value = filter;
      }
      renderSubmissions();
    }

    function formatCount(num: number | string): string {
      const n = Number(num) || 0;
      if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
      if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
      return String(n);
    }

    // Render Submissions List
    function renderSubmissions() {
      if (!submissionsList || !emptyView) return;

      if (cachedSubmissions.length === 0) {
        submissionsList.style.display = 'none';
        emptyView.style.display = 'block';
        return;
      }

      emptyView.style.display = 'none';
      submissionsList.style.display = 'flex';

      // 1. Filter by Status
      let list = [...cachedSubmissions];
      if (currentFilter !== 'all') {
        if (currentFilter === 'pending_review') {
          list = list.filter((s) => s.status === 'pending_review' || s.status === 'pending');
        } else if (currentFilter === 'approved') {
          list = list.filter((s) => s.status === 'approved' || s.status === 'published');
        } else {
          list = list.filter((s) => s.status === currentFilter);
        }
      }

      // 2. Filter by Search Query
      if (currentSearchQuery) {
        list = list.filter((s) => {
          const nameMatch = (s.name || '').toLowerCase().includes(currentSearchQuery);
          const urlMatch = (s.url || '').toLowerCase().includes(currentSearchQuery);
          const descMatch = (s.description || '').toLowerCase().includes(currentSearchQuery);
          const catMatch = (s.category || '').toLowerCase().includes(currentSearchQuery);
          return nameMatch || urlMatch || descMatch || catMatch;
        });
      }

      // 3. Sort
      list.sort((a, b) => {
        const dateA = new Date(a.submitted_at || a.created_at || 0).getTime();
        const dateB = new Date(b.submitted_at || b.created_at || 0).getTime();
        if (currentSort === 'newest') return dateB - dateA;
        if (currentSort === 'oldest') return dateA - dateB;
        if (currentSort === 'name_asc') return (a.name || '').localeCompare(b.name || '');
        if (currentSort === 'name_desc') return (b.name || '').localeCompare(a.name || '');
        return 0;
      });

      if (list.length === 0) {
        submissionsList.innerHTML = `
          <div style="text-align: center; padding: 48px 20px; font-weight: 700; color: #6b7280; background: #ffffff; border: 1.5px solid #e5e7eb; border-radius: 16px;">
            No submissions found matching your filters.
          </div>
        `;
        return;
      }

      submissionsList.innerHTML = list.map((sub) => {
        const id = sub.id;
        const name = sub.name || 'Untitled Project';
        const displayName = formatTitle(name);
        const url = sub.url || '#';
        const desc = sub.description || 'No description provided.';
        const rawCat = sub.category || 'Creative';
        const category = rawCat ? (rawCat.charAt(0).toUpperCase() + rawCat.slice(1).toLowerCase()) : 'Creative';
        const status = sub.status || 'pending_review';

        const designKey = sub.design_id || sub.preview_info?.theme || 'theme-01';
        const themeInfo = themeDisplayMap[designKey] || themeDisplayMap['theme-01'];

        let domain = 'website.com';
        try { domain = new URL(url).hostname; } catch {}

        const formattedDate = formatDate(sub.submitted_at || sub.created_at);

        // Status pill badges rendering
        let statusPillsHtml = '';
        if (status === 'published') {
          statusPillsHtml = `
            <span class="pill-badge pill-approved"><span class="badge-check-circle">✓</span> Approved</span>
            <span class="pill-badge pill-published"><span class="badge-icon">🚀</span> Published</span>
          `;
        } else if (status === 'approved') {
          statusPillsHtml = `
            <span class="pill-badge pill-approved"><span class="badge-check-circle">✓</span> Approved</span>
            <span class="pill-badge pill-ready"><span class="badge-icon">⏳</span> Ready to publish</span>
          `;
        } else if (status === 'rejected') {
          statusPillsHtml = `<span class="pill-badge pill-rejected"><span class="badge-icon">✕</span> Rejected</span>`;
        } else {
          statusPillsHtml = `<span class="pill-badge pill-review"><span class="badge-icon">⏳</span> Under Review</span>`;
        }

        // Left Banner Visual Preview
        let bannerVisualHtml = '';
        if (sub.thumbnail_url) {
          bannerVisualHtml = `<img src="${escapeHtml(sub.thumbnail_url)}" alt="${escapeHtml(name)}" class="banner-custom-img" loading="lazy" />`;
        } else {
          bannerVisualHtml = `
            <div class="banner-thumb-svg-wrap" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 14px;">
              ${generateTemplateSvg(sub.design_id || themeInfo.id, displayName, category)}
            </div>
          `;
        }


        return `
          <article class="sub-card-box" data-id="${id}">
            <!-- 1. Left: Visual Card Banner / Thumbnail Preview -->
            <div class="sub-banner-wrap theme-${escapeHtml(themeInfo.slug)}" id="card-banner-${id}">
              ${bannerVisualHtml}
            </div>

            <!-- 2. Middle: Information & Metadata -->
            <div class="sub-info-col">
              <span class="sub-kicker">${escapeHtml((name || '').toUpperCase())}</span>
              <h3 class="sub-title">${escapeHtml(displayName)}</h3>
              <p class="sub-desc">${escapeHtml(desc)}</p>

              <a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer" class="sub-domain-link">
                <span class="globe-icon" aria-hidden="true">🌐</span>
                <span>${escapeHtml(domain)}</span>
                <span class="ext-arrow" aria-hidden="true">↗</span>
              </a>

              <div class="sub-tags-row">
                <span class="tag-pill tag-views" title="Real Website Views">👁️ ${formatCount(sub.views_count || 0)} Views</span>
                <span class="tag-pill tag-loves" title="Real User Loves">❤️ ${formatCount(sub.likes_count || 0)} Loves</span>
                <span class="tag-pill tag-category">🏷️ ${escapeHtml(category)}</span>
                <span class="tag-pill tag-theme">🎨 ${escapeHtml(themeInfo.name)}</span>
                <span class="tag-pill tag-date">📅 Submitted ${formattedDate}</span>
              </div>
            </div>

            <!-- 3. Right: Moderation Badges & Actions -->
            <div class="sub-actions-col">
              <div class="sub-status-header">
                <div class="sub-status-pills">
                  ${statusPillsHtml}
                </div>
                <button type="button" class="sub-dots-btn" aria-label="More options" data-id="${id}">•••</button>
              </div>

              <div class="sub-buttons-group">
                <button type="button" class="btn-preview-card btn-live-preview-modal" data-preview-id="${id}">
                  <span class="btn-icon">👁</span>
                  <span>Preview card</span>
                </button>

                <button type="button" class="btn-customize-card trigger-edit-pres" data-edit-id="${id}">
                  <span class="btn-icon">✏️</span>
                  <span>Customize card</span>
                </button>

                ${status === 'rejected' ? `
                  <button type="button" class="btn-feedback trigger-reason-modal" data-reason-id="${id}">
                    <span>ℹ️</span>
                    <span>View Feedback</span>
                  </button>
                ` : ''}
              </div>
            </div>
          </article>
        `;
      }).join('');

      attachActionListeners();
    }

    // Attach card action button click listeners
    function attachActionListeners() {
      // 1. Customize card modal opener
      document.querySelectorAll('.trigger-edit-pres').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const subId = btn.getAttribute('data-edit-id');
          openEditModal(subId);
        });
      });

      // 2. Full Live Card preview modal opener
      document.querySelectorAll('.btn-live-preview-modal').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const subId = btn.getAttribute('data-preview-id');
          openLiveCardModal(subId);
        });
      });

      // 3. Rejection Reason modal opener
      document.querySelectorAll('.trigger-reason-modal').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const subId = btn.getAttribute('data-reason-id');
          openReasonModal(subId);
        });
      });
    }

    // Open Customize Modal with exact submission state
    function openEditModal(subId: string | null) {
      if (!subId || !editModal || !editForm) return;
      const sub = cachedSubmissions.find((s) => String(s.id) === String(subId));
      if (!sub) return;

      const idInput = document.getElementById('edit-form-id') as HTMLInputElement | null;
      if (idInput) idInput.value = String(sub.id);

      // Website Name and URL are permanently locked after submission
      if (editFieldName) editFieldName.value = sub.name || '';
      if (editFieldUrl) editFieldUrl.value = sub.url || '';

      // Editable fields: description and thumbnail
      if (editFieldDesc) {
        editFieldDesc.value = sub.description || '';
        if (descCharCount) descCharCount.textContent = `${(sub.description || '').length}/500`;
      }
      if (editFieldThumb) {
        editFieldThumb.value = sub.thumbnail_url || '';
      }

      // Theme radio selection
      const currentDesign = normalizeDesignId(sub.design_id || sub.preview_info?.design_id || sub.preview_info?.theme || 'gift-box');
      const radio = editForm.querySelector<HTMLInputElement>(`input[name="theme"][value="${currentDesign}"]`) ||
                    editForm.querySelector<HTMLInputElement>(`input[name="theme"][value="${themeDisplayMap[currentDesign]?.id || 'gift-box'}"]`);
      if (radio) radio.checked = true;

      // Update right-side Live Preview in Modal
      updateModalLivePreview(currentDesign, sub.name, sub.description, sub.category);

      if (editFormStatus) editFormStatus.style.display = 'none';
      editModal.style.display = 'flex';
    }

    // Update the live preview card in the edit modal
    function updateModalLivePreview(designKey: string, name?: string, desc?: string, cat?: string) {
      if (!modalCardPreview) return;
      const normalizedKey = normalizeDesignId(designKey);
      const info = themeDisplayMap[normalizedKey] || themeDisplayMap['gift-box'];
      modalCardPreview.className = `live-theme-card-preview theme-${info.slug}`;
      if (modalPreviewTitle) modalPreviewTitle.textContent = name || 'PROJECT TITLE';
      if (modalPreviewDesc) modalPreviewDesc.textContent = desc || 'Your website description will appear here...';
      if (modalPreviewCat) modalPreviewCat.textContent = cat || 'Creative';
      const artworkBox = document.getElementById('modal-preview-artwork');
      if (artworkBox) {
        artworkBox.innerHTML = `
          <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 8px;">
            ${generateTemplateSvg(normalizedKey, name || 'PROJECT TITLE', cat)}
          </div>
        `;
      }
    }

    // Modal Live Sync on form input / theme select
    if (editForm) {
      editForm.addEventListener('input', () => {
        const theme = editForm.querySelector<HTMLInputElement>('input[name="theme"]:checked')?.value || 'gift-box';
        const name = editFieldName?.value || 'PROJECT TITLE';
        const desc = editFieldDesc?.value || 'Your website description will appear here...';
        if (descCharCount && editFieldDesc) {
          descCharCount.textContent = `${editFieldDesc.value.length}/500`;
        }
        updateModalLivePreview(theme, name, desc);
      });

      editForm.querySelectorAll('input[name="theme"]').forEach((radio) => {
        radio.addEventListener('change', () => {
          const theme = (radio as HTMLInputElement).value || 'gift-box';
          const name = editFieldName?.value || 'PROJECT TITLE';
          const desc = editFieldDesc?.value || 'Your website description will appear here...';
          updateModalLivePreview(theme, name, desc);
        });
      });

      // Submit Customize Form to Neon PUT /api/submissions
      editForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const idInput = document.getElementById('edit-form-id') as HTMLInputElement | null;
        const subId = Number(idInput?.value);
        if (!subId) return;

        const selectedThemeInput = editForm.querySelector<HTMLInputElement>('input[name="theme"]:checked');
        const chosenDesignVal = selectedThemeInput?.value || 'gift-box';
        const designId = normalizeDesignId(chosenDesignVal);
        const description = editFieldDesc?.value.trim() || '';
        const thumbnail_url = editFieldThumb?.value.trim() || null;

        if (description.length < 10) {
          if (editFormStatus) {
            editFormStatus.style.display = 'block';
            editFormStatus.className = 'form-status-msg error';
            editFormStatus.textContent = 'Description must be at least 10 characters.';
          }
          return;
        }

        // Strictly allow only permitted fields:
        // Do NOT send URL or name or status!
        const payload: Record<string, any> = {
          id: subId,
          description,
          designId,
          thumbnail_url,
        };

        if (editSubmitBtn) (editSubmitBtn as HTMLButtonElement).disabled = true;
        if (editSubmitLabel) editSubmitLabel.textContent = 'Saving Changes...';
        if (editFormStatus) {
          editFormStatus.style.display = 'block';
          editFormStatus.className = 'form-status-msg';
          editFormStatus.textContent = 'Saving changes to Neon...';
        }

        try {
          const token = await getAuthToken();
          const headers: Record<string, string> = {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          };
          if (token) headers['Authorization'] = `Bearer ${token}`;

          const res = await fetch('/api/submissions', {
            method: 'PUT',
            headers,
            credentials: 'include',
            body: JSON.stringify(payload),
          });

          const data = await res.json().catch(() => null);
          if (!res.ok) {
            throw new Error(data?.error || `Failed to save changes (${res.status}: ${res.statusText || 'Server Error'}).`);
          }

          if (editFormStatus) {
            editFormStatus.className = 'form-status-msg success';
            editFormStatus.textContent = '✓ Changes saved successfully!';
          }

          // Broadcast to explore directory & discover randomizer for instant real-time sync
          try {
            localStorage.setItem('cfn_submission_updated', String(Date.now()));
          } catch {}

          // Realtime refresh
          await fetchSubmissions(false);

          setTimeout(() => {
            if (editModal) editModal.style.display = 'none';
          }, 600);
        } catch (err: any) {
          console.error('Save failed:', err);
          if (editFormStatus) {
            editFormStatus.className = 'form-status-msg error';
            editFormStatus.textContent = `Error: ${err.message || 'Could not save.'}`;
          }
        } finally {
          if (editSubmitBtn) (editSubmitBtn as HTMLButtonElement).disabled = false;
          if (editSubmitLabel) editSubmitLabel.textContent = 'Save Changes';
        }
      });
    }

    // Open Full Live Card Modal
    function openLiveCardModal(subId: string | null) {
      if (!subId || !liveCardModal || !fullLiveCardStage) return;
      const sub = cachedSubmissions.find((s) => String(s.id) === String(subId));
      if (!sub) return;

      const designKey = normalizeDesignId(sub.design_id || sub.preview_info?.design_id || sub.preview_info?.theme || 'gift-box');
      const info = themeDisplayMap[designKey] || themeDisplayMap['gift-box'];

      const artworkHtml = sub.thumbnail_url
        ? `<img src="${escapeHtml(sub.thumbnail_url)}" alt="${escapeHtml(sub.name)}" class="card-artwork-img" />`
        : `<div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 12px;">
             ${generateTemplateSvg(designKey, sub.name, sub.category)}
           </div>`;

      fullLiveCardStage.innerHTML = `
        <div class="live-theme-card theme-${escapeHtml(info.slug)}" style="width: 100%; max-width: 380px;">
          <div class="card-artwork-box" style="height: 140px;">
            ${artworkHtml}
          </div>
          <h3 class="card-inner-title" style="font-size: 1.8rem;">${escapeHtml(sub.name)}</h3>
          <p class="card-inner-desc" style="font-size: 0.95rem; -webkit-line-clamp: 4;">${escapeHtml(sub.description)}</p>

          <div class="card-inner-pills-row" style="margin-top: 20px; flex-wrap: wrap; gap: 8px;">
            <span class="pill-cat" style="font-size: 0.85rem; padding: 6px 16px;">${escapeHtml(sub.category || 'Creative')}</span>
            <span style="font-size: 0.82rem; padding: 5px 12px; background: #eff6ff; color: #1d4ed8; border: 1.5px solid #dbeafe; border-radius: 999px; font-weight: 700;">👁️ ${formatCount(sub.views_count || 0)} Views</span>
            <span style="font-size: 0.82rem; padding: 5px 12px; background: #fdf2f8; color: #db2777; border: 1.5px solid #fce7f3; border-radius: 999px; font-weight: 700;">❤️ ${formatCount(sub.likes_count || 0)} Loves</span>
            <a href="${escapeHtml(sub.url)}" target="_blank" rel="noopener noreferrer" class="pill-visit" style="text-decoration: none; font-size: 0.85rem; padding: 6px 16px;">Visit Website ↗</a>
          </div>
        </div>
      `;

      liveCardModal.style.display = 'flex';
    }

    // Open Rejection Reason Modal
    function openReasonModal(subId: string | null) {
      if (!subId || !reasonModal) return;
      const sub = cachedSubmissions.find((s) => String(s.id) === String(subId));
      if (!sub) return;

      if (reasonSiteTitle) reasonSiteTitle.textContent = sub.name || 'Website Submission';
      if (reasonContent) reasonContent.textContent = sub.rejection_reason || 'This website did not meet our community guidelines.';
      reasonModal.style.display = 'flex';
    }

    // Helper: Escape HTML
    function escapeHtml(str: string) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Helper: Format Date
    function formatDate(raw: string) {
      if (!raw) return 'Recently';
      try {
        const d = new Date(raw);
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      } catch {
        return 'Recently';
      }
    }

    // Helper: Format Title to Title Case
    function formatTitle(str: string): string {
      if (!str) return 'Untitled Project';
      if (str === str.toUpperCase() && str.length > 3) {
        return str
          .split(' ')
          .map((w) => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
          .join(' ');
      }
      return str;
    }

    // Update Auth subscription
    function updateAuthState() {
      const auth = $authStore.get();
      const user = $userStore.get();
      const isLoggedIn = Boolean(auth?.userId);

      if (isLoggedIn) {
        if (signedOutView) signedOutView.style.display = 'none';
        if (signedInView) signedInView.style.display = 'block';

        if (userNameEl && user) {
          const name = user.firstName || user.username || (user.primaryEmailAddress ? user.primaryEmailAddress.emailAddress.split('@')[0] : 'Explorer');
          userNameEl.textContent = name;
        }

        fetchSubmissions(true);

        // Realtime Polling: Check Neon every 10 seconds
        if (!pollIntervalTimer) {
          pollIntervalTimer = setInterval(() => {
            if (document.visibilityState === 'visible' && !isFetching) {
              fetchSubmissions(false);
            }
          }, 10000);
        }
      } else {
        if (signedOutView) signedOutView.style.display = 'block';
        if (signedInView) signedInView.style.display = 'none';
        if (pollIntervalTimer) {
          clearInterval(pollIntervalTimer);
          pollIntervalTimer = null;
        }
      }
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => fetchSubmissions(false));
    }

    if (retryBtn) {
      retryBtn.addEventListener('click', () => fetchSubmissions(true));
    }

    // Listen to Clerk Store
    $authStore.subscribe(updateAuthState);
    $userStore.subscribe(updateAuthState);
    updateAuthState();

    // Foreground Focus & Visibility Revalidation
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && $authStore.get()?.userId) {
        if (Date.now() - lastFetchTimestamp > 5000) {
          fetchSubmissions(false);
        }
      }
    });

    window.addEventListener('focus', () => {
      if ($authStore.get()?.userId) {
        if (Date.now() - lastFetchTimestamp > 5000) {
          fetchSubmissions(false);
        }
      }
    });
  }

  // Mount
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUserDashboard);
  } else {
    initUserDashboard();
  }
</script>
