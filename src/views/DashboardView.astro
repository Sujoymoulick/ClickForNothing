---
import SiteLayout from '../layouts/SiteLayout.astro';
import TopBar from '../components/TopBar.astro';
import { Show, SignInButton } from '@clerk/astro/components';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const locale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const home = getLocalizedPath('/', locale);
---

<SiteLayout title="Dashboard — ClickForNothing" description="Your submitted websites." canonicalPath="/dashboard/" noindex hideFooter>
  <TopBar />
  <main class="dash">
    <div class="box">
      <div class="head">
        <h1>Your submissions</h1>
        <a href={home} class="link">+ Submit</a>
      </div>

      <Show when="signed-out">
        <p class="muted">Sign in to see what you submitted.</p>
        <SignInButton mode="modal" class="btn">Sign in</SignInButton>
      </Show>

      <Show when="signed-in">
        <ul class="list" id="list" aria-live="polite"><li class="muted">Loading…</li></ul>
      </Show>
    </div>
  </main>
</SiteLayout>

<style>
  :global(html), :global(body) { height: 100%; overflow: hidden; }
  .dash {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 72px 16px 24px;
    background: #f7f6f3;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .box {
    width: 100%;
    max-width: 560px;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e6e5e0;
    border-radius: 14px;
    padding: 22px;
  }
  .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
  h1 { margin: 0; font-size: 18px; font-weight: 650; color: #111; }
  .link { font-size: 14px; color: #111; text-decoration: none; }
  .link:hover { text-decoration: underline; }
  .muted { color: #888; font-size: 13.5px; margin: 0 0 14px; }
  .box :global(.btn) {
    width: 100%; padding: 11px; border: 0; border-radius: 8px;
    background: #111; color: #fff; font: 600 14px/1 inherit; font-family: inherit; cursor: pointer;
  }
  .list { list-style: none; margin: 0; padding: 0; overflow-y: auto; }
  :global(.row) { padding: 14px 0; border-top: 1px solid #f0efe9; }
  :global(.row-top) { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  :global(.row-right) { display: flex; align-items: center; gap: 8px; flex: none; }
  :global(.row .desc) { margin: 8px 0 0; font-size: 13px; line-height: 1.5; color: #555; }
  :global(.row textarea) {
    width: 100%; margin-top: 8px; padding: 9px 11px; font: inherit; font-size: 13px;
    border: 1px solid #e2e1dc; border-radius: 8px; resize: vertical; color: #111;
  }
  :global(.row textarea:focus) { outline: none; border-color: #111; }
  :global(.actions) { display: flex; gap: 8px; margin-top: 10px; }
  :global(.actions button) {
    font: 500 12.5px/1 inherit; font-family: inherit; padding: 7px 12px; border-radius: 7px; cursor: pointer;
  }
  :global(.actions .ghost) { background: #fff; color: #111; border: 1px solid #e2e1dc; }
  :global(.actions .ghost:hover) { border-color: #111; }
  :global(.actions .danger) { color: #b42318; }
  :global(.actions .danger:hover) { border-color: #b42318; }
  :global(.actions .solid) { background: #111; color: #fff; border: 1px solid #111; }
  :global(.actions button:disabled) { opacity: 0.5; cursor: default; }
  :global(.row-msg) { margin: 6px 0 0; font-size: 12px; color: #888; }
  :global(.row-msg:empty) { display: none; }
  :global(.row:first-child) { border-top: 0; }
  :global(.row a) { color: #111; text-decoration: none; font-size: 14.5px; font-weight: 550; }
  :global(.row a:hover) { text-decoration: underline; }
  :global(.row small) { display: block; color: #999; font-size: 12px; margin-top: 3px; }
  :global(.tag) {
    flex: none; font-size: 11.5px; padding: 4px 9px; border-radius: 999px;
    background: #f1f0ec; color: #666; text-transform: capitalize;
  }
  :global(.tag.published) { background: #e8f5ec; color: #1a7f37; }
  :global(.tag.approved) { background: #eaf1fb; color: #1d4ed8; }
  :global(.tag.rejected) { background: #fdecea; color: #b42318; }
</style>

<script>
  type Sub = { id: number; name: string; url: string; description?: string; status: string; created_at?: string; rejection_reason?: string };

  const clerk = () => (window as any).Clerk;
  async function api(method: string, path: string, body?: unknown) {
    const token = await clerk()?.session?.getToken();
    const res = await fetch(path, {
      method,
      credentials: 'include',
      headers: {
        Accept: 'application/json',
        ...(body ? { 'Content-Type': 'application/json' } : {}),
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
      body: body ? JSON.stringify(body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Something went wrong.');
    return data;
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  }

  function row(s: Sub, list: HTMLElement) {
    const li = el('li', 'row');
    const top = el('div', 'row-top');
    const left = el('div');
    const a = el('a', '', s.name);
    a.href = s.url; a.target = '_blank'; a.rel = 'noopener noreferrer';
    const date = s.created_at ? new Date(s.created_at).toLocaleDateString() : '';
    left.append(a, el('small', '', [date, s.status === 'rejected' ? s.rejection_reason : ''].filter(Boolean).join(' · ')));
    const right = el('div', 'row-right');
    right.append(el('span', `tag ${s.status}`, s.status || 'pending'));
    top.append(left, right);

    const desc = el('p', 'desc', s.description || '');
    const msg = el('p', 'row-msg');
    li.append(top, desc);

    if (s.status === 'rejected') {
      li.append(el('p', 'row-msg', 'Rejected submissions are locked.'));
      return li;
    }

    const actions = el('div', 'actions');
    const editBtn = el('button', 'ghost', 'Edit');
    const delBtn = el('button', 'ghost danger', 'Delete');
    actions.append(editBtn, delBtn);
    li.append(actions, msg);

    if (s.status === 'approved') {
      const pubBtn = el('button', 'solid', 'Publish');
      pubBtn.type = 'button';
      actions.prepend(pubBtn);
      msg.textContent = 'Approved. Publish it whenever you are ready.';
      pubBtn.addEventListener('click', async () => {
        pubBtn.disabled = true; msg.textContent = 'Publishing…';
        try {
          await api('PUT', '/api/submissions', { id: s.id, publish: true });
          s.status = 'published';
          const tag = li.querySelector('.tag');
          if (tag) { tag.className = 'tag published'; tag.textContent = 'published'; }
          pubBtn.remove();
          msg.textContent = 'Published. It is live now.';
        } catch (e: any) {
          msg.textContent = e.message;
          pubBtn.disabled = false;
        }
      });
    }

    editBtn.type = delBtn.type = 'button';
    editBtn.addEventListener('click', () => {
      const ta = el('textarea');
      ta.rows = 3; ta.maxLength = 500; ta.value = s.description || '';
      const save = el('button', 'solid', 'Save');
      const cancel = el('button', 'ghost', 'Cancel');
      save.type = cancel.type = 'button';
      const editActions = el('div', 'actions');
      editActions.append(save, cancel);
      desc.replaceWith(ta);
      actions.replaceWith(editActions);
      ta.focus();
      const close = () => { ta.replaceWith(desc); editActions.replaceWith(actions); };
      cancel.addEventListener('click', () => { msg.textContent = ''; close(); });
      save.addEventListener('click', async () => {
        const v = ta.value.trim();
        if (v.length < 10) { msg.textContent = 'Description needs at least 10 characters.'; return; }
        save.disabled = true; msg.textContent = 'Saving…';
        try {
          const data = await api('PUT', '/api/submissions', { id: s.id, description: v });
          s.description = data.submission?.description ?? v;
          desc.textContent = s.description || '';
          msg.textContent = 'Saved.';
          close();
        } catch (e: any) {
          msg.textContent = e.message;
          save.disabled = false;
        }
      });
    });

    delBtn.addEventListener('click', async () => {
      if (!confirm(`Delete "${s.name}"? This cannot be undone.`)) return;
      delBtn.disabled = true; msg.textContent = 'Deleting…';
      try {
        await api('DELETE', `/api/submissions?id=${encodeURIComponent(s.id)}`);
        li.remove();
        if (!list.children.length) list.append(el('li', 'muted', 'Nothing yet. Go submit something useless.'));
      } catch (e: any) {
        msg.textContent = e.message;
        delBtn.disabled = false;
      }
    });
    return li;
  }

  let tries = 0;
  async function load() {
    const list = document.getElementById('list');
    if (!list || list.dataset.ready) return;
    if (!clerk()?.session) { if ((tries += 1) < 40) setTimeout(load, 250); return; }
    list.dataset.ready = '1';
    try {
      const subs: Sub[] = (await api('GET', '/api/submissions')).submissions || [];
      list.replaceChildren();
      if (!subs.length) { list.append(el('li', 'muted', 'Nothing yet. Go submit something useless.')); return; }
      for (const s of subs) list.append(row(s, list));
    } catch {
      list.replaceChildren(el('li', 'muted', 'Could not load. Refresh to try again.'));
    }
  }

  load();
  document.addEventListener('astro:page-load', load);
  new MutationObserver(load).observe(document.body, { childList: true, subtree: true });
</script>
