    function formatCount(num) {
      const n = Number(num) || 0;
      if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
      if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
      return String(n);
    }

    function createCardElement(site, index) {
      const card = document.createElement('article');
      const rawId = String(site.id || '');
      const numericId = rawId.replace(/^submission-/, '');
      const siteId = rawId.startsWith('submission-') ? rawId : `submission-${rawId}`;
      const catSlug = normalizeCat(site.category);
      const catObj = categoryData[catSlug] || { name: site.category || 'Useless Websites', icon: categoryData['all']?.icon || '' };
      const likesRaw = Number(site.likes_count) || 0;
      const likesFormatted = formatCount(likesRaw);
      const isLiked = likedSites.has(siteId);

      card.className = 'site-card is-hidden';
      card.setAttribute('data-site-id', siteId);
      card.setAttribute('data-numeric-id', numericId);
      card.setAttribute('data-name', site.name || '');
      card.setAttribute('data-category', catSlug);
      card.setAttribute('data-likes', String(likesRaw));
      card.setAttribute('data-index', String(index));

      let thumbMedia = '';
      if (site.thumbnail_url && /^https?:\/\//i.test(site.thumbnail_url)) {
        thumbMedia = `<img src="${escapeHtml(site.thumbnail_url)}" alt="${escapeHtml(site.name)}" class="card-thumb-img" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:10px;" />`;
      } else {
        thumbMedia = generateThumbSvg(site.name || '', catSlug, site.design_id || site.preview_info?.design_id || 'gift-box');
      }

      card.innerHTML = `
        <div class="card-thumb-wrapper">
          <a href="${escapeHtml(site.url)}" target="_blank" rel="noopener noreferrer" class="thumb-link" aria-label="View details for ${escapeHtml(site.name)}" tabindex="-1">
            <div class="thumb-media">${thumbMedia}</div>
          </a>
          <a href="${escapeHtml(site.url)}" target="_blank" rel="noopener noreferrer" class="card-ext-btn" title="Open ${escapeHtml(site.name)} directly ↗" aria-label="Open ${escapeHtml(site.name)} in a new tab">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>
        <div class="card-body">
          <h2 class="card-title">
            <a href="${escapeHtml(site.url)}" target="_blank" rel="noopener noreferrer" class="card-title-link">${escapeHtml(site.name)}</a>
          </h2>
          <p class="card-description">${escapeHtml(site.description || '')}</p>
          <div class="card-meta">
            <button type="button" class="card-cat-badge" data-category-trigger="${catSlug}" title="Filter by ${escapeHtml(catObj.name)}">
              <span class="cat-badge-icon">${catObj.icon}</span>
              <span>${escapeHtml(catObj.name)}</span>
            </button>
          </div>
          <div class="card-footer">
            <button type="button" class="card-like-btn ${isLiked ? 'is-liked' : ''}" data-like-target="${siteId}" data-numeric-id="${numericId}" aria-label="Like ${escapeHtml(site.name)}">
              <svg class="heart-icon" width="15" height="15" viewBox="0 0 24 24" fill="${isLiked ? '#f43f5e' : 'none'}" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
              <span class="like-number">${likesFormatted}</span>
            </button>
            <a href="${escapeHtml(site.url)}" target="_blank" rel="noopener noreferrer" class="card-arrow-btn" aria-label="Open ${escapeHtml(site.name)}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      `;

      // Propagate Astro scoped attribute to the dynamic card and all child elements
      const sampleCard = container.querySelector('.site-card');
      const sampleEl = sampleCard || container;
      const astroAttrs = Array.from(sampleEl.attributes).filter((a) =>
        a.name.startsWith('data-astro-cid-')
      );
      for (const attr of astroAttrs) {
        card.setAttribute(attr.name, attr.value);
        card.querySelectorAll('*').forEach((el) => el.setAttribute(attr.name, attr.value));
      }

      return card;
    }

    function updatePillCounts() {
      const allCount = cards.length;
      const allPill = document.querySelector('.filter-pill[data-category="all"] .pill-name');
      if (allPill) {
        allPill.textContent = allPill.textContent.replace(/\(\d+\)/, `(${allCount})`);
      }

      pills.forEach((pill) => {
        const cat = pill.getAttribute('data-category');
        if (cat && cat !== 'all') {
          const count = cards.filter((c) => c.getAttribute('data-category') === cat).length;
          let countSpan = pill.querySelector('.pill-count');
          if (count > 0) {
            if (!countSpan) {
              countSpan = document.createElement('span');
              countSpan.className = 'pill-count';
              pill.appendChild(countSpan);
            }
            countSpan.textContent = `(${count})`;
          } else if (countSpan) {
            countSpan.remove();
          }
        }
      });
    }

    async function fetchAndMergePublishedSites() {
      try {
        const res = await fetch('/api/published?_t=' + Date.now(), {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
          signal: AbortSignal.timeout(3500)
        });
        if (!res.ok) return;
        const data = await res.json();
        if (!Array.isArray(data?.sites) || data.sites.length === 0) return;

        const existingIds = new Set(cards.map((c) => c.getAttribute('data-site-id')));
        const existingNames = new Set(cards.map((c) => (c.getAttribute('data-name') || '').toLowerCase().trim()));

        let added = 0;
        let updated = false;

        data.sites.forEach((site, i) => {
          const siteId = String(site.id).startsWith('submission-') ? String(site.id) : `submission-${site.id}`;
          const siteName = (site.name || '').toLowerCase().trim();
          const targetDesign = site.design_id || site.preview_info?.design_id || 'gift-box';

          const existingCard = cards.find((c) => c.getAttribute('data-site-id') === siteId);
          if (existingCard) {
            // Live Update: Synchronize card template artwork & description in real time
            const thumbMediaEl = existingCard.querySelector('.thumb-media');
            if (thumbMediaEl && (!site.thumbnail_url || !/^https?:\/\//i.test(site.thumbnail_url))) {
              thumbMediaEl.innerHTML = generateThumbSvg(site.name || '', normalizeCat(site.category), targetDesign);
              updated = true;
            }
            const descEl = existingCard.querySelector('.card-description');
            if (descEl && site.description && descEl.textContent !== site.description) {
              descEl.textContent = site.description;
              updated = true;
            }
            // Live Update: Synchronize real likes count from Neon DB
            if (site.likes_count !== undefined && site.likes_count !== null) {
              const currentLikes = parseInt(existingCard.getAttribute('data-likes') || '0', 10);
              const dbLikes = Number(site.likes_count);
              if (currentLikes !== dbLikes) {
                existingCard.setAttribute('data-likes', String(dbLikes));
                const numEl = existingCard.querySelector('.like-number');
                if (numEl) numEl.textContent = formatCount(dbLikes);
                updated = true;
              }
            }
            return;
          }

          if (!existingIds.has(siteId) && !existingNames.has(siteName)) {
            const newIndex = -100 + i;
            const cardEl = createCardElement(site, newIndex);
            container.prepend(cardEl);
            cards.unshift(cardEl);
            existingIds.add(siteId);
            existingNames.add(siteName);
            added++;
          }
        });

        if (added > 0 || updated) {
          updatePillCounts();
          renderCards();
        }
      } catch (err) {
        console.error('Error fetching published websites:', err);
      }
    }

    // Listen for cross-tab or dashboard template updates
    window.addEventListener('storage', (e) => {
      if (e.key === 'cfn_submission_updated') {
        fetchAndMergePublishedSites();
      }
    });

    // Delegate click events on cards: likes, views, and categories
    container.addEventListener('click', async (e) => {
      // 1. Visit tracking (External direct button, thumbnail link, title link, arrow button)
      const visitLink = e.target.closest('.card-ext-btn, .thumb-link, .card-title-link, .card-arrow-btn');
      if (visitLink) {
        const card = visitLink.closest('.site-card');
        if (card) {
          const siteId = card.getAttribute('data-site-id') || '';
          const rawNumericId = card.getAttribute('data-numeric-id') || (siteId.startsWith('submission-') ? siteId.replace('submission-', '') : null);
          const numId = rawNumericId ? parseInt(rawNumericId, 10) : NaN;
          if (!isNaN(numId) && numId > 0) {
            try {
              fetch('/api/interactions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ submission_id: numId, type: 'view' }),
                keepalive: true
              }).then(() => {
                localStorage.setItem('cfn_submission_updated', String(Date.now()));
              }).catch(() => {});
            } catch (err) {}
          }
        }
      }

      // 2. Like button click
      const likeBtn = e.target.closest('.card-like-btn');
      if (likeBtn) {
        e.preventDefault();
        e.stopPropagation();
        const siteId = likeBtn.getAttribute('data-like-target');
        const numEl = likeBtn.querySelector('.like-number');
        const heartSvg = likeBtn.querySelector('.heart-icon');
        const card = likeBtn.closest('.site-card');

        if (!siteId || !card) return;

        let rawLikes = parseInt(card.getAttribute('data-likes') || '0', 10);
        const isLiked = likedSites.has(siteId);

        // Optimistic UI update
        if (isLiked) {
          likedSites.delete(siteId);
          likeBtn.classList.remove('is-liked');
          if (heartSvg) heartSvg.setAttribute('fill', 'none');
          rawLikes = Math.max(0, rawLikes - 1);
        } else {
          likedSites.add(siteId);
          likeBtn.classList.add('is-liked');
          if (heartSvg) heartSvg.setAttribute('fill', '#f43f5e');
          rawLikes += 1;
        }

        card.setAttribute('data-likes', String(rawLikes));
        if (numEl) {
          numEl.textContent = formatCount(rawLikes);
        }
        localStorage.setItem('cfn_liked_sites', JSON.stringify(Array.from(likedSites)));

        // If this is a database submission, persist atomically to Neon DB
        const rawNumericId = card.getAttribute('data-numeric-id') || likeBtn.getAttribute('data-numeric-id') || (siteId.startsWith('submission-') ? siteId.replace('submission-', '') : null);
        const numId = rawNumericId ? parseInt(rawNumericId, 10) : NaN;
        if (!isNaN(numId) && numId > 0) {
          try {
            const action = isLiked ? 'decrement' : 'increment';
            const res = await fetch('/api/interactions', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ submission_id: numId, type: 'like', action })
            });
            if (res.ok) {
              const data = await res.json();
              if (data && typeof data.likes_count === 'number') {
                card.setAttribute('data-likes', String(data.likes_count));
                if (numEl) numEl.textContent = formatCount(data.likes_count);
              }
            }
          } catch (err) {
            console.error('Failed to update likes in DB', err);
          }
          // Notify dashboard and other tabs that submission data has been updated in real-time
          localStorage.setItem('cfn_submission_updated', String(Date.now()));
        }
        return;
      }

      // 3. Delegate inline category badge clicks
      const catBadge = e.target.closest('[data-category-trigger]');
      if (catBadge) {
        e.preventDefault();
        e.stopPropagation();
        const catSlug = catBadge.getAttribute('data-category-trigger');
        if (catSlug) setCategory(catSlug);
      }
    });

    function getMatchingCards() {
      return cards.filter((card) => {
        if (currentCategory === 'all') return true;
        return card.getAttribute('data-category') === currentCategory;
      });
    }

    function sortMatchingCards(list) {
      if (currentSort === 'newest') {
        return list.sort((a, b) => {
          return parseInt(a.getAttribute('data-index') || '0', 10) - parseInt(b.getAttribute('data-index') || '0', 10);
        });
      } else if (currentSort === 'popular') {
        return list.sort((a, b) => {
          return parseInt(b.getAttribute('data-likes') || '0', 10) - parseInt(a.getAttribute('data-likes') || '0', 10);
        });
      } else if (currentSort === 'name') {
        return list.sort((a, b) => {
          const nameA = (a.getAttribute('data-name') || '').toLowerCase();
          const nameB = (b.getAttribute('data-name') || '').toLowerCase();
          return nameA.localeCompare(nameB);
        });
      }
      return list;
    }

    function renderCards() {
      const matching = getMatchingCards();
      const sorted = sortMatchingCards(matching);
      const totalMatching = sorted.length;

      // Reorder cards in DOM based on sort
      sorted.forEach((card) => {
        container.appendChild(card);
      });

      // Show/Hide based on visibility threshold
      let currentVisible = 0;
      cards.forEach((card) => {
        const isMatch = matching.includes(card);
        if (isMatch) {
          const matchIndex = sorted.indexOf(card);
          if (matchIndex < visibleCount) {
            card.classList.remove('is-hidden');
            currentVisible++;
          } else {
            card.classList.add('is-hidden');
          }
        } else {
          card.classList.add('is-hidden');
        }
      });

      // Update Toolbar Counts
      if (visibleCountEl) visibleCountEl.textContent = String(currentVisible);
      if (totalCountEl) totalCountEl.textContent = String(totalMatching);

      // Handle Empty State
      if (totalMatching === 0) {
        if (emptyState) emptyState.style.display = 'block';
        if (loadMoreBtn) loadMoreBtn.style.display = 'none';
        if (endNotice) endNotice.style.display = 'none';
      } else {
        if (emptyState) emptyState.style.display = 'none';

        // Handle Load More vs End of Web
        if (currentVisible >= totalMatching) {
          if (loadMoreBtn) loadMoreBtn.style.display = 'none';
          if (endNotice) endNotice.style.display = 'block';
        } else {
          if (loadMoreBtn) loadMoreBtn.style.display = 'inline-flex';
          if (endNotice) endNotice.style.display = 'none';
        }
      }
    }

    function setCategory(categorySlug) {
      currentCategory = categorySlug;
      visibleCount = BATCH_SIZE;

      pills.forEach((pill) => {
        const isSelected = pill.getAttribute('data-category') === categorySlug;
        pill.classList.toggle('is-active', isSelected);
        pill.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        if (isSelected) {
          pill.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });

      renderCards();
    }

    // Category Pill Click Listeners
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const slug = pill.getAttribute('data-category') || 'all';
        setCategory(slug);
      });
    });

    // Sort Dropdown Change Listener
    if (sortSelect) {
      sortSelect.addEventListener('change', (e) => {
        currentSort = e.target.value;
        renderCards();
      });
    }

    // Load More Button Listener
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        loadMoreBtn.classList.add('is-loading');
        setTimeout(() => {
          visibleCount += BATCH_SIZE;
          renderCards();
          loadMoreBtn.classList.remove('is-loading');
        }, 150);
      });
    }

    // Reset Filter Button Listener
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        setCategory('all');
      });
    }

    // View Toggle Listeners
    if (gridViewBtn && listViewBtn) {
      gridViewBtn.addEventListener('click', () => {
        container.classList.remove('is-list-mode');
        container.classList.add('is-grid-mode');
        gridViewBtn.classList.add('is-active');
        gridViewBtn.setAttribute('aria-pressed', 'true');
        listViewBtn.classList.remove('is-active');
        listViewBtn.setAttribute('aria-pressed', 'false');
      });

      listViewBtn.addEventListener('click', () => {
        container.classList.remove('is-grid-mode');
        container.classList.add('is-list-mode');
        listViewBtn.classList.add('is-active');
        listViewBtn.setAttribute('aria-pressed', 'true');
        gridViewBtn.classList.remove('is-active');
        gridViewBtn.setAttribute('aria-pressed', 'false');
      });
    }

    // Initial render
    renderCards();

    // Fetch dynamic published submissions from Neon DB in realtime
    fetchAndMergePublishedSites();
  })();
</script>

