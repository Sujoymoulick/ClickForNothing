---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { websites } from '../data/websites';
import { categories } from '../data/categories';
import { normalizeCategorySlug, getLikesForSite, categoryIcons, getSiteThumbnailSvg } from '../data/siteMeta';
import { useTranslations } from '../i18n';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);

const title = t('sites.seo_title');
const description = t('sites.seo_description');
const canonicalPath = "/sites/";

const siteOrigin = (Astro.site?.href || 'https://clickfornothing.com/').replace(/\/$/, '');
const currentPath = getLocalizedPath(canonicalPath, currentLocale);
const fullCanonicalUrl = `${siteOrigin}${currentPath}`;
const homeUrl = getLocalizedPath('/', currentLocale);
const discoverUrl = getLocalizedPath('/discover/', currentLocale);
const submitUrl = getLocalizedPath('/submit/', currentLocale);

// Prepare enriched website list with slug, normalized category, and likes
const enrichedWebsites = websites.map((site, index) => {
  const slug = (site as any).slug || site.id;
  const categorySlug = normalizeCategorySlug(site.category);
  const likes = getLikesForSite(site.id);
  const detailUrl = getLocalizedPath(`/sites/${slug}/`, currentLocale);
  const thumbnailSvg = getSiteThumbnailSvg(site.id, site.name, categorySlug);
  return {
    ...site,
    slug,
    categorySlug,
    likes,
    detailUrl,
    thumbnailSvg,
    index,
  };
});

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: `${siteOrigin}${homeUrl}` },
    { '@type': 'ListItem', position: 2, name: t('nav.sites'), item: fullCanonicalUrl },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t('sites.heading'),
  description,
  url: fullCanonicalUrl,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: enrichedWebsites.length,
    itemListElement: enrichedWebsites.map((site, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: site.name,
      url: `${siteOrigin}${site.detailUrl}`,
    })),
  },
};

const categoryDataMap = Object.fromEntries([
  ['all', { name: t('sites.all_pill', { count: enrichedWebsites.length }), icon: categoryIcons.all }],
  ...categories.map((c) => [
    c.slug,
    {
      name: t(`categories.${c.slug}`) || c.name,
      icon: categoryIcons[c.slug] || categoryIcons.all,
    },
  ]),
]);
---

<SiteLayout {title} {description} {canonicalPath}>
  <!-- Top Navigation Bar -->
  <SiteHeader activeNav="explore" />

  <div class="directory-page-bg">
    <main class="directory-container">
      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Breadcrumbs">
        <a href={homeUrl} class="breadcrumb-link">{t('nav.home')}</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current" aria-current="page">{t('sites.heading')}</span>
      </nav>

      <!-- Directory Hero Section -->
      <header class="directory-hero">
        <!-- Left Doodle Sticker -->
        <div class="hero-sticker hero-sticker-left" aria-hidden="true">
          <div class="doodle-card">
            <span class="doodle-text">Waste time,</span>
            <span class="doodle-text highlight">Discover ☺,</span>
            <span class="doodle-text">Be happy</span>
          </div>
          <svg class="doodle-arrow" width="48" height="52" viewBox="0 0 48 52" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 4 C 18 18, 38 24, 30 42" stroke="#f20caf" stroke-width="2.5" stroke-linecap="round" fill="none"/>
            <path d="M22 38 L 30 44 L 35 34" stroke="#f20caf" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </div>

        <!-- Center Hero Content -->
        <div class="directory-hero-center">
          <h1 class="directory-hero-title">
            <span class="directory-title-top">Directory of</span>
            <span class="directory-title-bottom">
              Useless Websites
              <svg class="brush-stroke" viewBox="0 0 260 16" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path d="M6 11 Q 130 3 254 11" stroke="#facc15" stroke-width="9" stroke-linecap="round"/>
              </svg>
            </span>
          </h1>
          <p class="directory-hero-lead">
            {t('sites.lead', { count: enrichedWebsites.length })}
          </p>
        </div>

        <!-- Right Retro CRT Monitor Sticker -->
        <div class="hero-sticker hero-sticker-right" aria-hidden="true">
          <span class="sparkle sparkle-pink">✦</span>
          <span class="sparkle sparkle-yellow">★</span>
          <div class="crt-monitor">
            <svg width="86" height="80" viewBox="0 0 90 85" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="5" y="5" width="80" height="60" rx="10" fill="#fdfbf7" stroke="#18181b" stroke-width="3"/>
              <rect x="13" y="12" width="64" height="46" rx="6" fill="#14532d" stroke="#18181b" stroke-width="2"/>
              <text x="45" y="38" font-family="monospace" font-size="16" font-weight="bold" fill="#4ade80" text-anchor="middle">^ _ ^</text>
              <rect x="18" y="52" width="24" height="2" fill="#18181b"/>
              <circle cx="68" cy="53" r="2.5" fill="#4ade80"/>
              <rect x="33" y="65" width="24" height="8" fill="#e2d9cf" stroke="#18181b" stroke-width="2"/>
              <rect x="22" y="73" width="46" height="6" rx="2" fill="#d6ccc2" stroke="#18181b" stroke-width="2"/>
            </svg>
          </div>
        </div>
      </header>

      <!-- Category Filter Pills Bar -->
      <nav class="category-filters-wrapper" aria-label={t('sites.filter_by_category')}>
        <div class="category-pills-bar" id="category-pills-bar" role="tablist">
          <button
            type="button"
            class="filter-pill is-active"
            data-category="all"
            role="tab"
            aria-selected="true"
          >
            <span class="pill-icon" set:html={categoryIcons.all} />
            <span class="pill-name">{t('sites.all_pill', { count: enrichedWebsites.length })}</span>
          </button>

          {categories.map((cat) => {
            const count = enrichedWebsites.filter((s) => s.categorySlug === cat.slug).length;
            const translatedName = t(`categories.${cat.slug}`) || cat.name;
            const iconSvg = categoryIcons[cat.slug] || categoryIcons.all;
            return (
              <button
                type="button"
                class="filter-pill"
                data-category={cat.slug}
                role="tab"
                aria-selected="false"
              >
                <span class="pill-icon" set:html={iconSvg} />
                <span class="pill-name">{translatedName}</span>
                {count > 0 && <span class="pill-count">({count})</span>}
              </button>
            );
          })}
        </div>
      </nav>

      <!-- Results Toolbar (Showing count, Sort, View Controls) -->
      <div class="results-toolbar">
        <div class="toolbar-left">
          <p class="results-count-text">
            Showing <strong id="visible-count">10</strong> of <strong id="total-count">{enrichedWebsites.length}</strong> websites
          </p>
        </div>
        <div class="toolbar-right">
          <!-- Sort Dropdown -->
          <div class="sort-control">
            <label for="sort-select" class="sort-label">Sort:</label>
            <div class="select-wrapper">
              <select id="sort-select" class="sort-select" aria-label="Sort websites">
                <option value="newest">{t('sites.sort_newest')}</option>
                <option value="popular">{t('sites.sort_popular')}</option>
                <option value="name">{t('sites.sort_name')}</option>
              </select>
              <svg class="select-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>

          <!-- View Toggle (Grid vs List) -->
          <div class="view-toggle" role="group" aria-label="Layout view mode">
            <button
              type="button"
              id="view-grid-btn"
              class="view-btn is-active"
              title={t('sites.view_grid')}
              aria-label={t('sites.view_grid')}
              aria-pressed="true"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                <rect x="3" y="14" width="7" height="7" rx="1.5"/>
                <rect x="14" y="14" width="7" height="7" rx="1.5"/>
              </svg>
            </button>
            <button
              type="button"
              id="view-list-btn"
              class="view-btn"
              title={t('sites.view_list')}
              aria-label={t('sites.view_list')}
              aria-pressed="false"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="8" y1="6" x2="21" y2="6"/>
                <line x1="8" y1="12" x2="21" y2="12"/>
                <line x1="8" y1="18" x2="21" y2="18"/>
                <line x1="3" y1="6" x2="3.01" y2="6"/>
                <line x1="3" y1="12" x2="3.01" y2="12"/>
                <line x1="3" y1="18" x2="3.01" y2="18"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Website Cards Container (5-Column Grid on Desktop) -->
      <section
        id="sites-container"
        class="sites-container is-grid-mode"
        aria-label="Directory of Useless Websites"
      >
        {enrichedWebsites.map((site, index) => {
          const isInitialVisible = index < 10;
          const translatedCategory = t(`categories.${site.categorySlug}`) || site.category;
          const catIconSvg = categoryIcons[site.categorySlug] || categoryIcons.all;

          return (
            <article
              class={`site-card ${isInitialVisible ? '' : 'is-hidden'}`}
              data-site-id={site.id}
              data-name={site.name}
              data-category={site.categorySlug}
              data-likes={site.likes.raw}
              data-index={index}
            >
              <!-- Card Thumbnail / Visual Area -->
              <div class="card-thumb-wrapper">
                <a
                  href={site.detailUrl}
                  class="thumb-link"
                  aria-label={`View details for ${site.name}`}
                  tabindex="-1"
                >
                  <div class="thumb-media" set:html={site.thumbnailSvg} />
                </a>

                <!-- External Direct Visit Button -->
                <a
                  href={site.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card-ext-btn"
                  title={`Open ${site.name} directly ↗`}
                  aria-label={`Open ${site.name} in a new tab`}
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"/>
                    <polyline points="7 7 17 7 17 17"/>
                  </svg>
                </a>
              </div>

              <!-- Card Content Area -->
              <div class="card-body">
                <h2 class="card-title">
                  <a href={site.detailUrl} class="card-title-link">{site.name}</a>
                </h2>
                <p class="card-description">{site.description}</p>

                <!-- Category Pill Badge -->
                <div class="card-meta">
                  <button
                    type="button"
                    class="card-cat-badge"
                    data-category-trigger={site.categorySlug}
                    title={`Filter by ${translatedCategory}`}
                  >
                    <span class="cat-badge-icon" set:html={catIconSvg} />
                    <span>{translatedCategory}</span>
                  </button>
                </div>

                <!-- Card Footer (Likes & Detail Arrow) -->
                <div class="card-footer">
                  <button
                    type="button"
                    class="card-like-btn"
                    data-like-target={site.id}
                    aria-label={`Like ${site.name}`}
                  >
                    <svg class="heart-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>
                    <span class="like-number">{site.likes.formatted}</span>
                  </button>

                  <a
                    href={site.detailUrl}
                    class="card-arrow-btn"
                    aria-label={`View details for ${site.name}`}
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"/>
                      <polyline points="12 5 19 12 12 19"/>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </section>

      <!-- Empty State (When no results match) -->
      <div id="empty-state" class="empty-state" style="display: none;">
        <div class="empty-emoji">🤷‍♂️</div>
        <h3 class="empty-title">{t('sites.empty_title')}</h3>
        <p class="empty-desc">{t('sites.empty_desc')}</p>
        <button type="button" id="reset-filter-btn" class="reset-filter-btn">
          {t('sites.reset_filters')}
        </button>
      </div>

      <!-- Pagination / Load More Section -->
      <div class="load-more-section">
        <button type="button" id="load-more-btn" class="load-more-btn">
          <svg class="load-more-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <polyline points="19 12 12 19 5 12"/>
          </svg>
          <span class="load-more-text">{t('sites.load_more', { count: 10 })}</span>
        </button>

        <div id="end-of-web" class="end-of-web-notice" style="display: none;">
          🎉 {t('sites.end_of_web')}
        </div>
      </div>

      <!-- Bottom Community Callout -->
      <section class="directory-bottom-cta">
        <div class="bottom-cta-inner">
          <h2 class="bottom-cta-heading">Finished browsing?</h2>
          <p class="bottom-cta-sub">Now go waste some time.</p>
          <div class="bottom-cta-actions">
            <a href={discoverUrl} class="bottom-btn bottom-btn-primary">
              Take Me Somewhere Random 🎲
            </a>
            <a href={submitUrl} class="bottom-btn bottom-btn-secondary">
              Submit a Useless Website ↗
            </a>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script is:inline id="directory-meta-data" type="application/json" set:html={JSON.stringify({ categoryData: categoryDataMap })} />
</SiteLayout>

<!-- Client Interactive Logic -->
<script is:inline>
  (function () {
    const BATCH_SIZE = 10;
    let currentCategory = 'all';
    let currentSort = 'newest';
    let visibleCount = BATCH_SIZE;

    const container = document.getElementById('sites-container');
    const pills = document.querySelectorAll('.filter-pill');
    const sortSelect = document.getElementById('sort-select');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const endNotice = document.getElementById('end-of-web');
    const emptyState = document.getElementById('empty-state');
    const resetBtn = document.getElementById('reset-filter-btn');
    const visibleCountEl = document.getElementById('visible-count');
    const totalCountEl = document.getElementById('total-count');
    const gridViewBtn = document.getElementById('view-grid-btn');
    const listViewBtn = document.getElementById('view-list-btn');

    if (!container) return;

    let cards = Array.from(container.querySelectorAll('.site-card'));
    const categoryData = JSON.parse(document.getElementById('directory-meta-data')?.textContent || '{}').categoryData || {};

    // Likes state persisted in localStorage
    const likedSites = new Set(JSON.parse(localStorage.getItem('cfn_liked_sites') || '[]'));

    // Initialize like button states
    cards.forEach((card) => {
      const siteId = card.getAttribute('data-site-id');
      const likeBtn = card.querySelector('.card-like-btn');
      if (siteId && likeBtn && likedSites.has(siteId)) {
        likeBtn.classList.add('is-liked');
        const heartSvg = likeBtn.querySelector('.heart-icon');
        if (heartSvg) heartSvg.setAttribute('fill', '#f43f5e');
      }
    });

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function normalizeCat(cat) {
      if (!cat) return 'useless-websites';
      const clean = String(cat).trim().toLowerCase();
      const valid = ['useless-websites', 'weird-websites', 'silly-animals', 'interactive', 'mini-games', 'creative', 'visual-oddities', 'music-sounds', 'internet-nostalgia', 'funny-websites', 'time-wasters', 'internet-experiments', 'food-for-thought'];
      if (valid.includes(clean)) return clean;
      const map = {
        'silly animals': 'silly-animals',
        'silly-animals': 'silly-animals',
        'animals': 'silly-animals',
        'internet nostalgia': 'internet-nostalgia',
        'internet-nostalgia': 'internet-nostalgia',
        'nostalgia': 'internet-nostalgia',
        'creative & art toys': 'creative',
        'creative-&-art-toys': 'creative',
        'creative': 'creative',
        'art': 'creative',
        'food for thought': 'food-for-thought',
        'food-for-thought': 'food-for-thought',
        'food': 'food-for-thought',
        'music & sound buttons': 'music-sounds',
        'music & sounds': 'music-sounds',
        'music-sounds': 'music-sounds',
        'music': 'music-sounds',
        'sounds': 'music-sounds',
        'visual oddities': 'visual-oddities',
        'visual-oddities': 'visual-oddities',
        'interactive web experiments': 'interactive',
        'interactive': 'interactive',
        'useless websites': 'useless-websites',
        'useless-websites': 'useless-websites',
        'useless': 'useless-websites',
        'ultimate time wasters': 'time-wasters',
        'time wasters': 'time-wasters',
        'time-wasters': 'time-wasters',
        'pointless mini games': 'mini-games',
        'mini games': 'mini-games',
        'mini-games': 'mini-games',
        'games': 'mini-games',
        'internet experiments': 'internet-experiments',
        'internet-experiments': 'internet-experiments',
        'experiments': 'internet-experiments',
        'meme': 'internet-nostalgia',
        'funny & humor websites': 'funny-websites',
        'funny': 'funny-websites',
        'funny-websites': 'funny-websites',
        'humor': 'funny-websites',
        'weird websites': 'weird-websites',
        'weird': 'weird-websites',
        'weird-websites': 'weird-websites',
      };
      return map[clean] || map[clean.replace(/\s+/g, '-')] || 'useless-websites';
    }

    function generateThumbSvg(name, catSlug, rawDesignId) {
      const aliasMap = {
        'gift-box': 'gift-box', 'cat-bounce': 'cat-bounce', 'long-doge': 'long-doge',
        'long-doge-challenge': 'long-doge', 'mondrian': 'mondrian', 'mondrian-and-me': 'mondrian',
        'versus': 'versus', 'potato-or-tomato': 'versus', 'heeeey': 'heeeey', 'heeeeeeeey': 'heeeey',
        'rgb': 'rgb', 'rrr-ggg-bbb': 'rgb', 'pointer': 'pointer', 'pointer-pointer': 'pointer',
        'windows-93': 'windows-93', 'falling-falling': 'falling-falling',
        'interactive': 'interactive', 'koalas-to-the-max': 'interactive',
        'silly-animal': 'silly-animal', 'silly-animals': 'silly-animal', 'eel-slap': 'silly-animal',
        'theme-01': 'mondrian', 'cream': 'mondrian',
        'theme-02': 'cat-bounce', 'pink': 'cat-bounce',
        'theme-03': 'interactive', 'cyan': 'interactive',
        'theme-04': 'gift-box', 'purple': 'gift-box',
        'theme-05': 'long-doge', 'amber': 'long-doge',
        'theme-06': 'windows-93', 'cyber': 'windows-93',
      };
      const cleanDesign = aliasMap[String(rawDesignId || '').toLowerCase().trim()] || 'gift-box';
      const cleanName = escapeHtml((name || 'WEBSITE').toUpperCase().slice(0, 20));

      switch (cleanDesign) {
        case 'gift-box':
          return `<svg viewBox="0 0 240 150" class="card-thumb-svg" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="gb-th-svg" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffe4f2"/>
                <stop offset="100%" stop-color="#fce7f3"/>
              </linearGradient>
            </defs>
            <rect width="240" height="150" fill="url(#gb-th-svg)"/>
            <text x="35" y="40" font-size="14" fill="#f43f5e" opacity="0.85">❤️</text>
            <text x="195" y="45" font-size="12" fill="#ec4899" opacity="0.85">💖</text>
            <text x="45" y="125" font-size="13" fill="#ec4899">✨</text>
            <text x="185" y="120" font-size="13" fill="#f43f5e">❤️</text>
            <g transform="translate(100, 32)">
              <rect x="0" y="20" width="40" height="34" rx="4" fill="#f43f5e" stroke="#18181b" stroke-width="2"/>
              <rect x="-4" y="14" width="48" height="9" rx="3" fill="#fb7185" stroke="#18181b" stroke-width="2"/>
              <rect x="16" y="14" width="8" height="40" fill="#fde047" stroke="#18181b" stroke-width="1.5"/>
              <line x1="0" y1="36" x2="40" y2="36" stroke="#fde047" stroke-width="5"/>
              <line x1="0" y1="36" x2="40" y2="36" stroke="#18181b" stroke-width="1.5" stroke-dasharray="2,2"/>
              <ellipse cx="14" cy="10" rx="7" ry="5" fill="#fde047" stroke="#18181b" stroke-width="2" transform="rotate(-25 14 10)"/>
              <ellipse cx="26" cy="10" rx="7" ry="5" fill="#fde047" stroke="#18181b" stroke-width="2" transform="rotate(25 26 10)"/>
              <circle cx="20" cy="12" r="3" fill="#ca8a04"/>
            </g>
            <text x="120" y="105" font-family="'Lilita One', Impact, system-ui, sans-serif" font-size="13" font-weight="900" fill="#9d174d" text-anchor="middle" letter-spacing="0.5">${cleanName}</text>
            <text x="120" y="122" font-family="system-ui, sans-serif" font-size="9" font-weight="700" fill="#be185d" text-anchor="middle" opacity="0.9">VIRTUAL GIFT EXPERIENCE</text>
          </svg>`;

        case 'cat-bounce':
          return `<svg viewBox="0 0 240 150" class="card-thumb-svg" xmlns="http://www.w3.org/2000/svg">
            <rect width="240" height="150" fill="#fce7f3"/>
            <path d="M30 110 Q 70 30 120 75 T 210 50" fill="none" stroke="#f472b6" stroke-width="2.5" stroke-dasharray="4,4"/>
            <g transform="translate(100, 38)">
              <polygon points="12,10 2,0 8,18" fill="#fda4af"/>
              <polygon points="28,10 38,0 32,18" fill="#fda4af"/>
