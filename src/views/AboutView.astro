---
import SiteLayout from '../layouts/SiteLayout.astro';
import { useTranslations } from '../i18n';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);

const title = t('about.title') || 'About ClickForNothing — Curating The Useless Web';
const description = t('about.description') || 'Learn how ClickForNothing curates the useless web. Discover our mission to preserve weird, pointless, and hilarious websites across the internet today.';
const canonicalPath = '/about/';

const homeUrl = getLocalizedPath('/', currentLocale);
const discoverUrl = getLocalizedPath('/discover/', currentLocale);
const sitesUrl = getLocalizedPath('/sites/', currentLocale);
const categoriesUrl = getLocalizedPath('/categories/', currentLocale);
const contactUrl = getLocalizedPath('/contact/', currentLocale);
---

<SiteLayout {title} {description} {canonicalPath}>
  <main class="about-stage">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-container">
        <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.95rem; font-weight: 700;">
          <a href={homeUrl} style="color: #7025ed; text-decoration: none;">{t('nav.home')}</a> <span style="color: #a1a1aa;">/</span> <span style="color: #17141a;" aria-current="page">{t('nav.about')}</span>
        </nav>
        <h1 id="about-title">{t('about.heading')}</h1>

        <div class="about-intro">
          <p class="intro-text">
            {t('about.intro')}
          </p>
        </div>
      </div>
    </section>

    <section class="about-content" aria-labelledby="what-is">
      <div class="about-container">

        <article class="about-section">
          <h2 id="what-is">{t('about.what_is_title')}</h2>
          <p>
            {t('about.what_is_p1')}
          </p>
          <p>
            {t('about.what_is_p2')}
          </p>
        </article>

        <article class="about-section">
          <h2>{t('about.why_exist_title')}</h2>
          <p>
            {t('about.why_exist_p1')}
          </p>
          <p>
            {t('about.why_exist_p2')}
          </p>
        </article>

        <article class="about-section">
          <h2>{t('about.how_works_title')}</h2>
          <p>
            {t('about.how_works_intro')}
          </p>
          <ol class="about-list">
            <li><strong>{t('about.step1')}</strong></li>
            <li><strong>{t('about.step2')}</strong></li>
            <li><strong>{t('about.step3')}</strong></li>
            <li><strong>{t('about.step4')}</strong></li>
            <li><strong>{t('about.step5')}</strong></li>
          </ol>
          <p>
            {t('about.verify_note')}
          </p>
        </article>

        <article class="about-section">
          <h2>{t('about.what_find_title')}</h2>
          <p>
            {t('about.what_find_intro')}
          </p>
          <ul class="about-list">
            <li>{t('about.item_funny')}</li>
            <li>{t('about.item_strange')}</li>
            <li>{t('about.item_interactive')}</li>
            <li>{t('about.item_pointless')}</li>
            <li>{t('about.item_surprising')}</li>
            <li>{t('about.item_visual')}</li>
            <li>{t('about.item_entertaining')}</li>
            <li>{t('about.item_unnecessary')}</li>
          </ul>
          <p>
            {t('about.what_find_footer')}
          </p>
        </article>

        <article class="about-section">
          <h2>{t('about.why_name_title')}</h2>
          <p>
            <strong>"{t('about.tagline')}"</strong>
          </p>
          <p>
            {t('about.why_name_p1')}
          </p>
          <p>
            {t('about.why_name_p2')}
          </p>
        </article>

        <article class="about-section">
          <h2>{t('about.curating_title')}</h2>
          <p>
            {t('about.curating_intro')}
          </p>
          <ul class="about-list">
            <li>{t('about.crit1')}</li>
            <li>{t('about.crit2')}</li>
            <li>{t('about.crit3')}</li>
            <li>{t('about.crit4')}</li>
          </ul>
          <p>
            {t('about.curating_footer')}
          </p>
        </article>

        <article class="about-section">
          <h2>{t('about.explore_title')}</h2>
          <p>
            {t('about.explore_intro')}
          </p>
          <ul class="about-list">
            <li><a href={discoverUrl}>{t('about.link_discover')}</a></li>
            <li><a href={sitesUrl}>{t('about.link_directory')}</a></li>
            <li><a href={categoriesUrl}>{t('about.link_categories')}</a></li>
          </ul>
        </article>

        <article class="about-section faq-section">
          <h2>{t('about.faq_title')}</h2>

          <div class="faq-item">
            <h3>{t('about.q1')}</h3>
            <p>{t('about.a1')}</p>
          </div>

          <div class="faq-item">
            <h3>{t('about.q2')}</h3>
            <p>{t('about.a2')}</p>
          </div>

          <div class="faq-item">
            <h3>{t('about.q3')}</h3>
            <p>{t('about.a3')}</p>
          </div>

          <div class="faq-item">
            <h3>{t('about.q4')}</h3>
            <p>{t('about.a4')}</p>
          </div>

          <div class="faq-item">
            <h3>{t('about.q5')}</h3>
            <p>{t('about.a5')}</p>
          </div>

          <div class="faq-item">
            <h3>{t('about.q6')}</h3>
            <p>{t('about.a6')}</p>
          </div>

          <div class="faq-item">
            <h3>{t('about.q7')}</h3>
            <p>{t('about.a7')}</p>
          </div>

          <div class="faq-item">
            <h3>{t('about.q8')}</h3>
            <p>{t('about.a8')}</p>
          </div>

          <div class="faq-item">
            <h3>{t('about.q9')}</h3>
            <p>{t('about.a9')}</p>
          </div>

          <div class="faq-item">
            <h3>{t('about.q10')}</h3>
            <p>{t('about.a10')}</p>
          </div>
        </article>

      </div>
    </section>
  </main>

      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Home',
        'item': 'https://clickfornothing.com/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'About',
        'item': 'https://clickfornothing.com/about/'
      }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://clickfornothing.com/#organization',
    'name': 'ClickForNothing',
    'url': 'https://clickfornothing.com/',
    'description': 'An entertainment website for discovering funny, weird, random, useless, pointless and unnecessary websites from around the internet.',
    'logo': 'https://clickfornothing.com/favicon.svg',
    'sameAs': [
      'https://clickfornothing.com/'
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://clickfornothing.com/#website',
    'url': 'https://clickfornothing.com/',
    'name': 'ClickForNothing',
    'description': 'Discover the weird, pointless and wonderfully useless websites on the internet.',
    'potentialAction': {
      '@type': 'SearchAction',
      'target': {
        '@type': 'EntryPoint',
        'urlTemplate': 'https://clickfornothing.com/discover/'
      }
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': 'https://clickfornothing.com/about/#webpage',
    'url': 'https://clickfornothing.com/about/',
    'name': 'About ClickForNothing',
    'description': 'Learn what ClickForNothing is, why it exists, and how it helps you discover funny, weird, random and completely unnecessary websites across the internet.',
    'isPartOf': {
      '@id': 'https://clickfornothing.com/#website'
    }
  })} />

  <style is:global>
    .about-stage {
      position: relative;
      padding: clamp(40px, 6vw, 80px) clamp(20px, 4vw, 40px);
      background: linear-gradient(135deg, #fef9e7 0%, #fff9df 50%, #fef5e7 100%);
      min-height: 100vh;
    }

    .about-hero {
      margin-bottom: clamp(50px, 8vw, 100px);
    }

    .about-hero h1 {
      font: 700 clamp(2.2rem, 6vw, 3.5rem) / 1.1 'Lilita One', system-ui, sans-serif;
      color: #17141a;
      margin-bottom: 1.5rem;
      letter-spacing: -0.02em;
      -webkit-text-stroke: 0.5px rgba(23, 20, 26, 0.3);
      paint-order: stroke fill;
    }

    .about-intro {
      max-width: 720px;
    }

    .intro-text {
      font: 500 1.1rem / 1.6 'Baloo 2', system-ui, sans-serif;
      color: #2d2a31;
      margin: 0;
    }

    .about-container {
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }

    .about-content {
      background: #fff;
      border-radius: 12px;
      padding: clamp(40px, 6vw, 60px);
      box-shadow: 0 4px 20px rgba(23, 20, 26, 0.06);
    }

    .about-section {
      margin-bottom: 3rem;
    }

    .about-section:last-child {
      margin-bottom: 0;
    }

    .about-section h2 {
      font: 700 clamp(1.5rem, 4vw, 1.8rem) / 1.2 'Lilita One', system-ui, sans-serif;
      color: #17141a;
      margin: 0 0 1rem 0;
      letter-spacing: -0.01em;
    }

    .about-section h3 {
      font: 600 1.1rem / 1.4 'Baloo 2', system-ui, sans-serif;
      color: #2d2a31;
      margin: 1.2rem 0 0.6rem 0;
    }

    .about-section p {
      font: 500 1rem / 1.7 'Baloo 2', system-ui, sans-serif;
      color: #3d3a41;
      margin: 0 0 1rem 0;
    }

    .about-section p:last-of-type {
      margin-bottom: 0;
    }

    .about-list {
      font: 500 1rem / 1.8 'Baloo 2', system-ui, sans-serif;
      color: #3d3a41;
      margin: 1rem 0 1rem 0;
      padding-left: 1.8rem;
    }

    .about-list li {
      margin-bottom: 0.8rem;
    }

    .about-list li:last-child {
      margin-bottom: 0;
    }

    .about-section a {
      color: #7025ed;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .about-section a:hover,
    .about-section a:focus-visible {
      color: #f20caf;
      outline: none;
    }

    .faq-section {
      margin-top: 3rem;
      padding-top: 3rem;
      border-top: 2px solid #f0ebf8;
    }

    .faq-item {
      margin-bottom: 2rem;
    }

    .faq-item:last-child {
      margin-bottom: 0;
    }

    .faq-item h3 {
      font: 700 1.05rem / 1.4 'Baloo 2', system-ui, sans-serif;
      color: #17141a;
      margin: 0 0 0.6rem 0;
    }

    .faq-item p {
      font: 500 0.95rem / 1.65 'Baloo 2', system-ui, sans-serif;
      color: #3d3a41;
      margin: 0;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .about-stage {
        padding: 30px clamp(16px, 3vw, 24px);
      }

      .about-hero h1 {
        font-size: 1.8rem;
      }

      .intro-text {
        font-size: 1rem;
      }

      .about-content {
        padding: clamp(24px, 5vw, 40px);
        border-radius: 8px;
      }

      .about-section {
        margin-bottom: 2.5rem;
      }

      .about-section h2 {
        font-size: 1.35rem;
        margin-bottom: 0.8rem;
      }

      .about-section h3 {
        font-size: 1rem;
      }

      .about-section p,
      .about-list {
        font-size: 0.95rem;
      }

      .faq-item {
        margin-bottom: 1.5rem;
      }

      .faq-section {
        margin-top: 2.5rem;
        padding-top: 2.5rem;
      }
    }

    @media (max-width: 480px) {
      .about-stage {
        padding: 24px 16px;
      }

      .about-hero {
        margin-bottom: 30px;
      }

      .about-hero h1 {
        font-size: 1.5rem;
      }

      .intro-text {
        font-size: 0.95rem;
        line-height: 1.5;
      }

      .about-content {
        padding: 20px 16px;
      }

      .about-section {
        margin-bottom: 1.8rem;
      }

      .about-section h2 {
        font-size: 1.2rem;
        margin-bottom: 0.7rem;
      }

      .about-section h3 {
        font-size: 0.95rem;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
      }

      .about-section p,
      .about-list,
      .about-list li,
      .faq-item p {
        font-size: 0.9rem;
        line-height: 1.55;
      }

      .about-list {
        margin-bottom: 1rem;
      }

      .faq-section {
        margin-top: 2rem;
        padding-top: 2rem;
      }

      .faq-item {
        margin-bottom: 1.2rem;
      }
    }
  </style>
</SiteLayout>
