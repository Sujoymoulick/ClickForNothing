---
import SiteLayout from '../layouts/SiteLayout.astro';
import { useTranslations } from '../i18n';
import { getLocaleFromUrl, getLocalizedPath } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);

const title = t('about.title') || 'About ClickForNothing — Curating The Useless Web';
const description = t('about.description') || 'Learn how ClickForNothing curates the useless web. Discover our mission to preserve weird, pointless, and hilarious websites across the internet today.';
const canonicalPath = '/about/';

const homeUrl = getLocalizedPath('/', currentLocale);
const discoverUrl = getLocalizedPath('/discover/', currentLocale);
const sitesUrl = getLocalizedPath('/sites/', currentLocale);
const categoriesUrl = getLocalizedPath('/categories/', currentLocale);
const contactUrl = getLocalizedPath('/contact/', currentLocale);
---

<SiteLayout {title} {description} {canonicalPath}>
  <main class="about-stage">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-container">
        <nav class="breadcrumbs" aria-label="Breadcrumbs" style="margin-bottom: 20px; font-size: 0.95rem; font-weight: 700;">
          <a href={homeUrl} style="color: #7025ed; text-decoration: none;">{t('nav.home')}</a> <span style="color: #a1a1aa;">/</span> <span style="color: #17141a;" aria-current="page">{t('nav.about')}</span>
        </nav>
        <h1 id="about-title">{t('about.heading') || 'About ClickForNothing'}</h1>

        <div class="about-intro">
          <p class="intro-text">
            ClickForNothing is an entertainment website that helps people discover funny, weird, random and completely unnecessary websites from around the internet. Its core experience is simple: click a button, get sent somewhere unexpected, and waste a little time on something you absolutely did not need.
          </p>
        </div>
      </div>
    </section>

    <section class="about-content" aria-labelledby="what-is">
      <div class="about-container">

        <article class="about-section">
          <h2 id="what-is">What Is ClickForNothing?</h2>
          <p>
            ClickForNothing is a curated discovery platform for useless websites—the wonderfully weird, pointless, and completely unnecessary corners of the internet that serve no practical purpose but somehow entertain, surprise, or confuse you in the best way possible.
          </p>
          <p>
            The website features a constantly updated collection of strange and funny websites that have been verified and categorized. Each website in our collection is a small adventure into the internet's most creative, absurd, and intentionally pointless projects.
          </p>
        </article>

        <article class="about-section">
          <h2>Why Does ClickForNothing Exist?</h2>
          <p>
            The internet is vast and filled with amazing creations that serve no practical purpose whatsoever. Most of these sites would never show up in traditional search results because they don't sell anything, they don't provide information, and they're designed purely for entertainment or artistic expression.
          </p>
          <p>
            ClickForNothing exists to celebrate these websites. We believe the best parts of the internet are the weird, pointless, and unnecessary ones. They represent creativity, humor, and the pure joy of making something just because you can. Our mission is to help you discover these hidden gems and spend some quality time regretting clicking that button—in the best way possible.
          </p>
        </article>

        <article class="about-section">
          <h2>How ClickForNothing Works</h2>
          <p>
            Using ClickForNothing is straightforward:
          </p>
          <ol class="about-list">
            <li><strong>Visit the discovery page</strong> at <a href={discoverUrl}>ClickForNothing/discover</a></li>
            <li><strong>See a website</strong> with its name, category, and brief description</li>
            <li><strong>Click "Visit Website"</strong> to open it in a new tab</li>
            <li><strong>Return and repeat</strong> to discover more useless websites</li>
            <li><strong>Use navigation buttons</strong> to go forward, backward, or surprise yourself with a random site</li>
          </ol>
          <p>
            Every website is verified to ensure it loads correctly and remains active. If a site breaks, we remove it and add new discoveries.
          </p>
        </article>

        <article class="about-section">
          <h2>What You'll Find Here</h2>
          <p>
            Our collection includes websites that are:
          </p>
          <ul class="about-list">
            <li><strong>Funny</strong> — comedy projects, pranks, and jokes</li>
            <li><strong>Strange</strong> — bizarre and surreal experiences</li>
            <li><strong>Interactive</strong> — games, experiments, and interactive art</li>
            <li><strong>Pointless</strong> — sites with no practical purpose</li>
            <li><strong>Surprising</strong> — unexpectedly creative or confusing</li>
            <li><strong>Visually unusual</strong> — interesting design and artistic expression</li>
            <li><strong>Entertaining</strong> — just plain fun to waste time on</li>
            <li><strong>Intentionally unnecessary</strong> — made just because the creator could</li>
          </ul>
          <p>
            These websites are organized by category to help you explore different types of useless internet experiences.
          </p>
        </article>

        <article class="about-section">
          <h2>Why We Call It ClickForNothing</h2>
          <p>
            Our tagline is simple: <strong>"Click Here To Regret It."</strong>
          </p>
          <p>
            This perfectly captures the spirit of what we do. You click knowing you don't need to visit these websites. There's no practical benefit. No information to gain. No productivity boost. Just pure, unnecessary entertainment. The "regret" is playful—you spent 5 minutes looking at something completely pointless, and somehow you don't regret it at all.
          </p>
          <p>
            ClickForNothing celebrates the joy of doing something completely unnecessary and loving it anyway.
          </p>
        </article>

        <article class="about-section">
          <h2>Our Approach to Curating the Useless Internet</h2>
          <p>
            We carefully select and verify each website in our collection. When we add a site, we ensure:
          </p>
          <ul class="about-list">
            <li>The website loads and works as intended</li>
            <li>It fits our definition of "useless" entertainment</li>
            <li>It's appropriate and safe to click on</li>
            <li>The content doesn't become broken or irrelevant over time</li>
          </ul>
          <p>
            Websites may be removed if they become unsafe, malicious, broken, or no longer serve our community's entertainment value. We regularly review our collection to keep the experience fresh and reliable.
          </p>
        </article>

        <article class="about-section">
          <h2>Explore ClickForNothing</h2>
          <p>
            Ready to discover something wonderfully useless?
          </p>
          <ul class="about-list">
            <li><a href={discoverUrl}>Start discovering random websites</a></li>
            <li><a href={sitesUrl}>Browse our full website directory</a></li>
            <li><a href={categoriesUrl}>Explore websites by category</a></li>
          </ul>
        </article>

        <article class="about-section faq-section">
          <h2>Frequently Asked Questions</h2>

          <div class="faq-item">
            <h3>What is ClickForNothing?</h3>
            <p>
              ClickForNothing is an entertainment website that helps you discover funny, weird, random and completely unnecessary websites from around the internet. Our mission is to celebrate the joy of clicking on something pointless and actually enjoying it.
            </p>
          </div>

          <div class="faq-item">
            <h3>What is the purpose of ClickForNothing?</h3>
            <p>
              ClickForNothing exists to help you discover the wonderfully weird and intentionally useless websites that the internet has to offer. We believe these sites represent the most creative and entertaining parts of the web—projects made purely for fun, art, or absurdity.
            </p>
          </div>

          <div class="faq-item">
            <h3>How does ClickForNothing choose websites?</h3>
            <p>
              We carefully curate our collection by selecting websites that fit our criteria: they must be entertaining, unusual, interactive, pointless, surprising, or just plain fun. Each site is verified to ensure it loads correctly and remains active.
            </p>
          </div>

          <div class="faq-item">
            <h3>Is ClickForNothing free?</h3>
            <p>
              Yes, ClickForNothing is completely free. There are no ads, paywalls, or hidden charges. We believe discovering useless websites should be accessible to everyone.
            </p>
          </div>

          <div class="faq-item">
            <h3>Do I need an account?</h3>
            <p>
              No, you don't need an account to use ClickForNothing. Just visit the discovery page and start exploring. No registration or login required.
            </p>
          </div>

          <div class="faq-item">
            <h3>What kind of websites can I discover?</h3>
            <p>
              You can discover funny websites, strange interactive experiments, artistic projects, pranks, games, pointless tools, surreal experiences, and all sorts of wonderfully unnecessary creations. Each site is categorized to help you explore different types of useless internet experiences.
            </p>
          </div>

          <div class="faq-item">
            <h3>How does the random website feature work?</h3>
            <p>
              Click the "Surprise Me" button on the discovery page to jump to a random website from our collection. Use "Next" to browse sequentially, "Previous" to go back, or "Surprise Me" to jump anywhere in the collection.
            </p>
          </div>

          <div class="faq-item">
            <h3>Can I submit a website?</h3>
            <p>
              We're always looking for new useless websites to feature. Please <a href={contactUrl}>contact us</a> with your suggestions. Tell us about the website, why you think it's worthy of ClickForNothing, and include a link.
            </p>
          </div>

          <div class="faq-item">
            <h3>What if a website doesn't load?</h3>
            <p>
              We regularly verify that all websites in our collection work correctly. If you encounter a broken link, it helps us improve the experience. Let us know by <a href={contactUrl}>contacting us</a> and we'll investigate or remove it from our collection.
            </p>
          </div>

          <div class="faq-item">
            <h3>Is ClickForNothing safe?</h3>
            <p>
              We verify each website to ensure it's safe to visit. However, because we link to external websites we don't control, we recommend using common sense when clicking. If you encounter anything inappropriate or unsafe, please <a href={contactUrl}>let us know</a>.
            </p>
          </div>
        </article>

      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Home',
        'item': 'https://clickfornothing.com/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'About',
        'item': 'https://clickfornothing.com/about/'
      }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://clickfornothing.com/#organization',
    'name': 'ClickForNothing',
    'url': 'https://clickfornothing.com/',
    'description': 'An entertainment website for discovering funny, weird, random, useless, pointless and unnecessary websites from around the internet.',
    'logo': 'https://clickfornothing.com/favicon.svg',
    'sameAs': [
      'https://clickfornothing.com/'
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://clickfornothing.com/#website',
    'url': 'https://clickfornothing.com/',
    'name': 'ClickForNothing',
    'description': 'Discover the weird, pointless and wonderfully useless websites on the internet.',
    'potentialAction': {
      '@type': 'SearchAction',
      'target': {
        '@type': 'EntryPoint',
        'urlTemplate': 'https://clickfornothing.com/discover/'
      }
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': 'https://clickfornothing.com/about/#webpage',
    'url': 'https://clickfornothing.com/about/',
    'name': 'About ClickForNothing',
    'description': 'Learn what ClickForNothing is, why it exists, and how it helps you discover funny, weird, random and completely unnecessary websites across the internet.',
    'isPartOf': {
      '@id': 'https://clickfornothing.com/#website'
    }
  })} />

  <style is:global>
    .about-stage {
      position: relative;
      padding: clamp(40px, 6vw, 80px) clamp(20px, 4vw, 40px);
      background: linear-gradient(135deg, #fef9e7 0%, #fff9df 50%, #fef5e7 100%);
      min-height: 100vh;
    }

    .about-hero {
      margin-bottom: clamp(50px, 8vw, 100px);
    }

    .about-hero h1 {
      font: 700 clamp(2.2rem, 6vw, 3.5rem) / 1.1 'Lilita One', system-ui, sans-serif;
      color: #17141a;
      margin-bottom: 1.5rem;
      letter-spacing: -0.02em;
      -webkit-text-stroke: 0.5px rgba(23, 20, 26, 0.3);
      paint-order: stroke fill;
    }

    .about-intro {
      max-width: 720px;
    }

    .intro-text {
      font: 500 1.1rem / 1.6 'Baloo 2', system-ui, sans-serif;
      color: #2d2a31;
      margin: 0;
    }

    .about-container {
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }

    .about-content {
      background: #fff;
      border-radius: 12px;
      padding: clamp(40px, 6vw, 60px);
      box-shadow: 0 4px 20px rgba(23, 20, 26, 0.06);
    }

    .about-section {
      margin-bottom: 3rem;
    }

    .about-section:last-child {
      margin-bottom: 0;
    }

    .about-section h2 {
      font: 700 clamp(1.5rem, 4vw, 1.8rem) / 1.2 'Lilita One', system-ui, sans-serif;
      color: #17141a;
      margin: 0 0 1rem 0;
      letter-spacing: -0.01em;
    }

    .about-section h3 {
      font: 600 1.1rem / 1.4 'Baloo 2', system-ui, sans-serif;
      color: #2d2a31;
      margin: 1.2rem 0 0.6rem 0;
    }

    .about-section p {
      font: 500 1rem / 1.7 'Baloo 2', system-ui, sans-serif;
      color: #3d3a41;
      margin: 0 0 1rem 0;
    }

    .about-section p:last-of-type {
      margin-bottom: 0;
    }

    .about-list {
      font: 500 1rem / 1.8 'Baloo 2', system-ui, sans-serif;
      color: #3d3a41;
      margin: 1rem 0 1rem 0;
      padding-left: 1.8rem;
    }

    .about-list li {
      margin-bottom: 0.8rem;
    }

    .about-list li:last-child {
      margin-bottom: 0;
    }

    .about-section a {
      color: #7025ed;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .about-section a:hover,
    .about-section a:focus-visible {
      color: #f20caf;
      outline: none;
    }

    .faq-section {
      margin-top: 3rem;
      padding-top: 3rem;
      border-top: 2px solid #f0ebf8;
    }

    .faq-item {
      margin-bottom: 2rem;
    }

    .faq-item:last-child {
      margin-bottom: 0;
    }

    .faq-item h3 {
      font: 700 1.05rem / 1.4 'Baloo 2', system-ui, sans-serif;
      color: #17141a;
      margin: 0 0 0.6rem 0;
    }

    .faq-item p {
      font: 500 0.95rem / 1.65 'Baloo 2', system-ui, sans-serif;
      color: #3d3a41;
      margin: 0;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .about-stage {
        padding: 30px clamp(16px, 3vw, 24px);
      }

      .about-hero h1 {
        font-size: 1.8rem;
      }

      .intro-text {
        font-size: 1rem;
      }

      .about-content {
        padding: clamp(24px, 5vw, 40px);
        border-radius: 8px;
      }

      .about-section {
        margin-bottom: 2.5rem;
      }

      .about-section h2 {
        font-size: 1.35rem;
        margin-bottom: 0.8rem;
      }

      .about-section h3 {
        font-size: 1rem;
      }

      .about-section p,
      .about-list {
        font-size: 0.95rem;
      }

      .faq-item {
        margin-bottom: 1.5rem;
      }

      .faq-section {
        margin-top: 2.5rem;
        padding-top: 2.5rem;
      }
    }

    @media (max-width: 480px) {
      .about-stage {
        padding: 24px 16px;
      }

      .about-hero {
        margin-bottom: 30px;
      }

      .about-hero h1 {
        font-size: 1.5rem;
      }

      .intro-text {
        font-size: 0.95rem;
        line-height: 1.5;
      }

      .about-content {
        padding: 20px 16px;
      }

      .about-section {
        margin-bottom: 1.8rem;
      }

      .about-section h2 {
        font-size: 1.2rem;
        margin-bottom: 0.7rem;
      }

      .about-section h3 {
        font-size: 0.95rem;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
      }

      .about-section p,
      .about-list,
      .about-list li,
      .faq-item p {
        font-size: 0.9rem;
        line-height: 1.55;
      }

      .about-list {
        margin-bottom: 1rem;
      }

      .faq-section {
        margin-top: 2rem;
        padding-top: 2rem;
      }

      .faq-item {
        margin-bottom: 1.2rem;
      }
    }
  </style>
</SiteLayout>
