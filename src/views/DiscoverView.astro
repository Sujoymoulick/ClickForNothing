---
import SiteLayout from '../layouts/SiteLayout.astro';
import MemeDecoLayer from '../components/MemeDecoLayer.astro';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import { websites } from '../data/websites.ts';
import { useTranslations } from '../i18n';
import { getLocalizedPath, getLocaleFromUrl } from '../i18n/routing';
import type { SupportedLocale } from '../i18n/config';

const currentLocale = (Astro.currentLocale as SupportedLocale) || getLocaleFromUrl(Astro.url);
const { t } = await useTranslations(currentLocale);

const title = t('discover.seo_title');
const description = t('discover.seo_description');
const destinations = websites.filter((site) => site.verified && /^https:\/\//i.test(site.url));
const first = destinations[0];
const canonicalPath = getLocalizedPath('/discover/', currentLocale);
---
<SiteLayout {title} {description} {canonicalPath} hideFooter={true}>
  <main class="discover-stage" data-discover-stage>
    <MemeDecoLayer />
    <section class="discover-content" aria-labelledby="discover-title">
      <header class="discover-header">
        <LocaleSwitcher variant="discover" />
        <p class="discover-kicker">{t('discover.kicker')}</p>
        <h1 id="discover-title" class="discover-title">
          <span class="typewriter-text" data-typewriter data-full-text={t('discover.title')}>{t('discover.title')}</span><span class="typewriter-cursor" aria-hidden="true">|</span>
        </h1>
        <p class="discover-intro">{t('discover.intro')}</p>
      </header>

      <div class="card-stage" data-card-stage data-of-label={t('discover.of')}>
        <article class="website-card card-current" data-card-current aria-live="polite" aria-atomic="true">
          {first ? (
            <div class="card-inner">
              <div class="card-topline">
                <span class="category-badge" data-category>{first.category}</span>
                <span class="site-position" data-position>1 {t('discover.of')} {destinations.length}</span>
              </div>
              <div class="card-main-body">
                <h2 data-name>{first.name}</h2>
                <p class="site-description" data-description>{first.description}</p>
              </div>
              <div class="card-action-block">
                <a class="visit-button" data-visit href={first.url} target="_blank" rel="noopener noreferrer">{t('discover.visit_btn')} <span aria-hidden="true">↗</span></a>
                <p class="visit-hint">{t('discover.visit_hint')}</p>
              </div>
            </div>
          ) : (
            <div class="empty-discover" data-empty>
              <span class="category-badge">{t('discover.empty_badge')}</span>
              <h2>{t('discover.empty_title')}</h2>
              <p class="site-description">{t('discover.empty_desc')}</p>
            </div>
          )}
        </article>

        <article class="website-card card-incoming" data-card-incoming aria-hidden="true" style="display: none;">
          <div class="card-inner">
            <div class="card-topline">
              <span class="category-badge" data-incoming-category></span>
              <span class="site-position" data-incoming-position></span>
            </div>
            <div class="card-main-body">
              <h2 data-incoming-name></h2>
              <p class="site-description" data-incoming-description></p>
            </div>
            <div class="card-action-block">
              <a class="visit-button" data-incoming-visit href="#" target="_blank" rel="noopener noreferrer" tabindex="-1">{t('discover.visit_btn')} <span aria-hidden="true">↗</span></a>
              <p class="visit-hint">{t('discover.visit_hint')}</p>
            </div>
          </div>
        </article>
      </div>

      <div class="discover-bottom-group">
        <div class="discover-controls" aria-label="Website discovery controls">
          <button class="nav-button previous-button" type="button" data-previous disabled>{t('discover.btn_previous')}</button>
          <button class="nav-button next-button" type="button" data-next>{t('discover.btn_next')}</button>
          <button class="nav-button surprise-button" type="button" data-surprise>{t('discover.btn_surprise')}</button>
        </div>

        <div class="share-buttons">
          <button class="share-button" data-platform="twitter" aria-label="Share on Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
          </button>
          <button class="share-button" data-platform="facebook" aria-label="Share on Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </button>
          <button class="share-button" data-platform="whatsapp" aria-label="Share on WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          </button>
          <button class="share-button" data-platform="copy" aria-label="Copy link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2 2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>

        <div class="scroll-hint" data-scroll-hint aria-hidden="true">
          <span class="hint-arrow">↑</span> {t('discover.scroll_hint')}
        </div>
      </div>
    </section>
  </main>

  <script>
    import { websites } from '../data/websites.ts';
    import { initMemeMovement } from '../scripts/memeMovement.ts';

    // Start autonomous floating meme animation loop
    initMemeMovement();

    const stateKey = 'clickfornothing:discovery:v2';
    const hintKey = 'clickfornothing:hint-seen';
    const ANIMATION_DURATION = 380;
    const EASING = 'cubic-bezier(0.22, 1, 0.36, 1)';

    const safeSites = websites.flatMap((site) => {
      if (!site.verified) return [];
      try {
        const url = new URL(site.url);
        if (url.protocol !== 'https:') return [];
        return [{ ...site, url: url.href }];
      } catch {
        return [];
      }
    });

    const slugify = (text: string) =>
      text
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)+/g, '');

    const byId = new Map(safeSites.map((site) => [site.id, site]));
    const bySlug = new Map(safeSites.map((site) => [slugify(site.name), site]));
    const positionById = new Map(safeSites.map((site, index) => [site.id, index + 1]));

    const cardStage = document.querySelector('[data-card-stage]') as HTMLElement | null;
    const ofLabel = cardStage?.dataset.ofLabel || 'of';

    const currentCard = document.querySelector('[data-card-current]') as HTMLElement | null;
    const incomingCard = document.querySelector('[data-card-incoming]') as HTMLElement | null;
    const previousButton = document.querySelector('[data-previous]') as HTMLButtonElement | null;
    const nextButton = document.querySelector('[data-next]') as HTMLButtonElement | null;
    const surpriseButton = document.querySelector('[data-surprise]') as HTMLButtonElement | null;
    const scrollHint = document.querySelector('[data-scroll-hint]') as HTMLElement | null;
    const emptyNode = document.querySelector('[data-empty]');

    let isAnimating = false;

    let navState: { history: string[]; index: number; cycle: string[]; cursor: number } = {
      history: [],
      index: -1,
      cycle: [],
      cursor: 0,
    };

    function initTypewriter() {
      const titleEl = document.querySelector('[data-typewriter]');
      const cursorEl = document.querySelector('.typewriter-cursor') as HTMLElement | null;
      if (!titleEl) return;

      const fullText = titleEl.getAttribute('data-full-text') || titleEl.textContent || "Choose Your Next Regret";
      const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (isReducedMotion) {
        titleEl.textContent = fullText;
        if (cursorEl) cursorEl.style.display = 'none';
        return;
      }

      titleEl.textContent = '';
      let index = 0;
      const speed = 45;

      function typeChar() {
        if (!titleEl) return;
        if (index < fullText.length) {
          titleEl.textContent += fullText.charAt(index);
          index++;
          setTimeout(typeChar, speed);
        } else {
          setTimeout(() => {
            if (cursorEl) cursorEl.style.display = 'none';
          }, 2000);
        }
      }

      typeChar();
    }

    function hideHint() {
      if (scrollHint && !scrollHint.classList.contains('hint-hidden')) {
        scrollHint.classList.add('hint-hidden');
        try {
          window.sessionStorage.setItem(hintKey, '1');
        } catch {
          /* Session storage unavailable */
        }
      }
    }

    try {
      if (window.sessionStorage.getItem(hintKey) === '1' && scrollHint) {
        scrollHint.classList.add('hint-hidden');
      }
    } catch {
      /* Ignore */
    }

    function shuffledIds(excludeId?: string) {
      const ids = safeSites.map((site) => site.id).filter((id) => id !== excludeId);
      for (let index = ids.length - 1; index > 0; index -= 1) {
        const other = Math.floor(Math.random() * (index + 1));
        [ids[index], ids[other]] = [ids[other], ids[index]];
      }
      if (excludeId && ids.length === safeSites.length - 1) ids.push(excludeId);
      return ids;
    }

    function resetCycle(excludeId?: string) {
      navState.cycle = shuffledIds(excludeId);
      navState.cursor = 0;
    }

    function startCycleAt(siteId: string) {
      navState.cycle = [siteId, ...shuffledIds(siteId)];
      navState.cursor = 1;
    }

    function saveState() {
      try {
        window.sessionStorage.setItem(stateKey, JSON.stringify(navState));
      } catch {
        /* Storage can be disabled */
      }
    }

    function getPositionText(siteId: string) {
      const cyclePosition = navState.cycle.indexOf(siteId);
      const pos = (cyclePosition >= 0 ? cyclePosition : (positionById.get(siteId) || 1) - 1) + 1;
      return `${pos} ${ofLabel} ${safeSites.length}`;
    }

    function populateCard(targetCard: HTMLElement | null, prefix: '' | 'incoming-', siteId: string) {
      const site = byId.get(siteId);
      if (!site || !targetCard) return;

      const nameNode = targetCard.querySelector(`[data-${prefix}name]`);
      const descriptionNode = targetCard.querySelector(`[data-${prefix}description]`);
      const categoryNode = targetCard.querySelector(`[data-${prefix}category]`);
      const positionNode = targetCard.querySelector(`[data-${prefix}position]`);
      const visitNode = targetCard.querySelector(`[data-${prefix}visit]`) as HTMLAnchorElement | null;

      if (nameNode) nameNode.textContent = site.name;
      if (descriptionNode) descriptionNode.textContent = site.description;
      if (categoryNode) categoryNode.textContent = site.category;
      if (positionNode) positionNode.textContent = getPositionText(site.id);
      if (visitNode) {
        visitNode.href = site.url;
        visitNode.hidden = false;
      }
    }

    function updateControlButtons() {
      emptyNode?.setAttribute('hidden', '');
      if (previousButton) previousButton.disabled = navState.index <= 0;
      if (nextButton) nextButton.disabled = safeSites.length < 2;
      if (surpriseButton) surpriseButton.disabled = safeSites.length < 2;
    }

    function renderDirect(siteId: string) {
      populateCard(currentCard, '', siteId);
      updateControlButtons();
    }

    function syncUrl(push = true) {
      const siteId = navState.history[navState.index];
      if (!siteId) return;
      const currentPath = window.location.pathname;
      const url = `${currentPath}?site=${encodeURIComponent(siteId)}`;
      const method = push ? 'pushState' : 'replaceState';
      window.history[method]({ siteId, index: navState.index }, '', url);
    }

    function animateReelTransition(targetSiteId: string, direction: 'next' | 'prev', onCommit: () => void) {
      hideHint();

      const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!currentCard || !incomingCard || isReducedMotion) {
        onCommit();
        renderDirect(targetSiteId);
        return;
      }

      isAnimating = true;

      populateCard(incomingCard, 'incoming-', targetSiteId);

      const enterY = direction === 'next' ? '108%' : '-108%';
      const exitY = direction === 'next' ? '-108%' : '108%';

      incomingCard.style.display = 'flex';
      incomingCard.style.transition = 'none';
      incomingCard.style.transform = `translate3d(0, ${enterY}, 0) scale(0.96)`;
      incomingCard.style.opacity = '0';

      currentCard.style.transition = 'none';
      currentCard.style.transform = 'translate3d(0, 0, 0) scale(1)';
      currentCard.style.opacity = '1';

      void incomingCard.offsetHeight;

      incomingCard.style.transition = `transform ${ANIMATION_DURATION}ms ${EASING}, opacity ${ANIMATION_DURATION}ms ease`;
      currentCard.style.transition = `transform ${ANIMATION_DURATION}ms ${EASING}, opacity ${ANIMATION_DURATION}ms ease`;

      incomingCard.style.transform = 'translate3d(0, 0, 0) scale(1)';
      incomingCard.style.opacity = '1';

      currentCard.style.transform = `translate3d(0, ${exitY}, 0) scale(0.96)`;
      currentCard.style.opacity = '0';

      let cleanedUp = false;
      const onAnimationComplete = () => {
        if (cleanedUp) return;
        cleanedUp = true;

        onCommit();
        renderDirect(targetSiteId);

        currentCard.style.transition = 'none';
        currentCard.style.transform = 'translate3d(0, 0, 0) scale(1)';
        currentCard.style.opacity = '1';

        incomingCard.style.display = 'none';
        incomingCard.style.transition = 'none';

        setTimeout(() => {
          isAnimating = false;
        }, 90);
      };

      setTimeout(onAnimationComplete, ANIMATION_DURATION + 20);
    }

    function consumeNext(randomize: boolean) {
      if (!navState.cycle.length || navState.cycle.length !== safeSites.length) resetCycle();
      if (navState.cursor >= navState.cycle.length) {
        const currentId = navState.history[navState.index];
        resetCycle(currentId);
      }
      if (randomize && navState.cursor < navState.cycle.length - 1) {
        const currentId = navState.history[navState.index];
        const currentIsReservedAtEnd = navState.cursor === 0 && navState.cycle[navState.cycle.length - 1] === currentId;
        const availableCount = navState.cycle.length - navState.cursor - (currentIsReservedAtEnd ? 1 : 0);
        const randomIndex = navState.cursor + Math.floor(Math.random() * availableCount);
        [navState.cycle[navState.cursor], navState.cycle[randomIndex]] = [navState.cycle[randomIndex], navState.cycle[navState.cursor]];
      }
      const site = byId.get(navState.cycle[navState.cursor]);
      navState.cursor += 1;
      return site;
    }

    function handleNext() {
      if (isAnimating || safeSites.length < 2) return;

      if (navState.index < navState.history.length - 1) {
        const nextIndex = navState.index + 1;
        const targetId = navState.history[nextIndex];
        animateReelTransition(targetId, 'next', () => {
          navState.index = nextIndex;
          saveState();
          syncUrl(true);
        });
        return;
      }

      const nextSite = consumeNext(false);
      if (!nextSite) return;

      animateReelTransition(nextSite.id, 'next', () => {
        navState.history = navState.history.slice(0, navState.index + 1);
        navState.history.push(nextSite.id);
        navState.index = navState.history.length - 1;
        saveState();
        syncUrl(true);
      });
    }

    function handlePrevious() {
      if (isAnimating || navState.index <= 0) return;

      const prevIndex = navState.index - 1;
      const targetId = navState.history[prevIndex];
      animateReelTransition(targetId, 'prev', () => {
        navState.index = prevIndex;
        saveState();
        syncUrl(true);
      });
    }

    function handleSurprise() {
      if (isAnimating || safeSites.length < 2) return;

      const randomSite = consumeNext(true);
      if (!randomSite) return;

      animateReelTransition(randomSite.id, 'next', () => {
        navState.history = navState.history.slice(0, navState.index + 1);
        navState.history.push(randomSite.id);
        navState.index = navState.history.length - 1;
        saveState();
        syncUrl(true);
      });
    }

    function initialize() {
      initTypewriter();

      if (!safeSites.length) {
        document.querySelectorAll('[data-previous], [data-next], [data-surprise]').forEach((button) => {
          (button as HTMLButtonElement).disabled = true;
        });
        const visitNode = document.querySelector('[data-visit]') as HTMLAnchorElement | null;
        if (visitNode) visitNode.hidden = true;
        return;
      }

      try {
        const saved = JSON.parse(window.sessionStorage.getItem(stateKey) || 'null');
        if (saved && Array.isArray(saved.history)) {
          navState.history = saved.history.filter((id) => byId.has(id));
          navState.index = Math.min(Math.max(Number(saved.index) || 0, 0), navState.history.length - 1);
          navState.cycle = Array.isArray(saved.cycle) ? saved.cycle.filter((id, index, ids) => byId.has(id) && ids.indexOf(id) === index) : [];
          navState.cursor = Math.min(Math.max(Number(saved.cursor) || 0, 0), navState.cycle.length);
        }
      } catch {
        /* Storage unavailable */
      }

      const urlParams = new URL(window.location.href).searchParams;
      const rawParam = urlParams.get('name') || urlParams.get('site') || urlParams.get('id');
      let requestedId: string | null = null;

      if (rawParam) {
        const cleanParam = rawParam.trim().toLowerCase();
        if (byId.has(cleanParam)) {
          requestedId = cleanParam;
        } else if (bySlug.has(cleanParam)) {
          requestedId = bySlug.get(cleanParam)!.id;
        } else {
          const matched = safeSites.find(
            (s) => s.id.toLowerCase() === cleanParam || slugify(s.name) === cleanParam || s.name.toLowerCase() === cleanParam
          );
          if (matched) requestedId = matched.id;
        }
      }

      if (requestedId && byId.has(requestedId)) {
        const existingIndex = navState.history.lastIndexOf(requestedId);
        if (existingIndex >= 0) {
          navState.index = existingIndex;
        } else {
          if (!navState.cycle.length || navState.cycle.length !== safeSites.length) startCycleAt(requestedId);
          else {
            const requestedCycleIndex = navState.cycle.indexOf(requestedId, navState.cursor);
            if (requestedCycleIndex >= 0) {
              [navState.cycle[navState.cursor], navState.cycle[requestedCycleIndex]] = [navState.cycle[requestedCycleIndex], navState.cycle[navState.cursor]];
              navState.cursor += 1;
            } else startCycleAt(requestedId);
          }
          navState.history.push(requestedId);
          navState.index = navState.history.length - 1;
        }
      } else if (!navState.history.length) {
        if (!navState.cycle.length || navState.cycle.length !== safeSites.length) resetCycle();
        const initial = byId.get(navState.cycle[navState.cursor]);
        navState.cursor += 1;
        navState.history = initial ? [initial.id] : [];
        navState.index = initial ? 0 : -1;
      }

      if (navState.index >= 0) {
        renderDirect(navState.history[navState.index]);
        saveState();
        if (!rawParam) syncUrl(false);
      }
    }

    if (previousButton && nextButton && surpriseButton) {
      initialize();

      previousButton.addEventListener('click', handlePrevious);
      nextButton.addEventListener('click', handleNext);
      surpriseButton.addEventListener('click', handleSurprise);

      let accumulatedDeltaY = 0;
      let wheelResetTimeout: number | null = null;
      const WHEEL_THRESHOLD = 40;

      window.addEventListener(
        'wheel',
        (event) => {
          if (isAnimating) return;

          accumulatedDeltaY += event.deltaY;

          if (wheelResetTimeout !== null) {
            clearTimeout(wheelResetTimeout);
          }
          wheelResetTimeout = window.setTimeout(() => {
            accumulatedDeltaY = 0;
          }, 140);

          if (Math.abs(accumulatedDeltaY) >= WHEEL_THRESHOLD) {
            const isDownward = accumulatedDeltaY > 0;
            accumulatedDeltaY = 0;

            if (isDownward) {
              handleNext();
            } else {
              handlePrevious();
            }
          }
        },
        { passive: true }
      );

      const SWIPE_THRESHOLD_PX = 35;
      let touchStartY = 0;
      let touchStartX = 0;
      let touchStartTime = 0;

      window.addEventListener(
        'touchstart',
        (event) => {
          if (event.touches.length === 1 && !isAnimating) {
            touchStartY = event.touches[0].clientY;
            touchStartX = event.touches[0].clientX;
            touchStartTime = Date.now();
          }
        },
        { passive: true }
      );

      window.addEventListener(
        'touchmove',
        (event) => {
          if (event.touches.length === 1 && !isAnimating) {
            const currentY = event.touches[0].clientY;
            const currentX = event.touches[0].clientX;
            const dy = currentY - touchStartY;
            const dx = currentX - touchStartX;
            if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 10) {
              if (event.cancelable) {
                event.preventDefault();
              }
            }
          }
        },
        { passive: false }
      );

      window.addEventListener(
        'touchend',
        (event) => {
          if (isAnimating || event.changedTouches.length === 0) return;

          const touchEndY = event.changedTouches[0].clientY;
          const touchEndX = event.changedTouches[0].clientX;
          const deltaY = touchEndY - touchStartY;
          const deltaX = touchEndX - touchStartX;
          const elapsed = Date.now() - touchStartTime;

          if (Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaY) > SWIPE_THRESHOLD_PX && elapsed < 800) {
            if (deltaY < 0) {
              handleNext();
            } else {
              handlePrevious();
            }
          }
        },
        { passive: true }
      );

      window.addEventListener('keydown', (event) => {
        const target = event.target as HTMLElement | null;
        if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) {
          return;
        }

        if (event.key === 'ArrowDown') {
          event.preventDefault();
          handleNext();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          handlePrevious();
        } else if (event.key === ' ' || event.code === 'Space') {
          if (target && (target.tagName === 'BUTTON' || target.tagName === 'A')) {
            return;
          }
          event.preventDefault();
          handleNext();
        }
      });

      window.addEventListener('popstate', (event) => {
        const urlParams = new URL(window.location.href).searchParams;
        const siteParam = event.state?.siteId || urlParams.get('name') || urlParams.get('site') || urlParams.get('id');
        if (!siteParam) return;
        const targetSite = byId.get(siteParam) || bySlug.get(slugify(siteParam));
        if (!targetSite) return;
        const siteId = targetSite.id;
        const stateIndex = Number(event.state?.index);
        const existingIndex = Number.isInteger(stateIndex) && navState.history[stateIndex] === siteId ? stateIndex : navState.history.lastIndexOf(siteId);
        
        const isBack = Number.isInteger(existingIndex) && existingIndex < navState.index;

        if (existingIndex >= 0) navState.index = existingIndex;
        else {
          navState.history.push(siteId);
          navState.index = navState.history.length - 1;
        }
        saveState();

        animateReelTransition(siteId, isBack ? 'prev' : 'next', () => {
          renderDirect(siteId);
        });
      });
    }
  </script>
</SiteLayout>
