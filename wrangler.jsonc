{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clickfornothing",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  }
}
